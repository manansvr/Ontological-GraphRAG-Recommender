<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.sunswift.com/ontology/sr8-thesis#"
     xml:base="http://www.sunswift.com/ontology/sr8-thesis"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.sunswift.com/ontology/sr8-thesis">
        <dcterms:title>SR8 Ontology-Driven Knowledge Graph Framework</dcterms:title>
        <dcterms:description>A Comprehensive Ontology For The Sunswift Racing SR8 Systems Engineering Project, Integrating Regulatory Compliance, Knowledge Extraction, &amp; AI-Assisted Reasoning</dcterms:description>
        <dcterms:creator>Manan Rathi</dcterms:creator>
        <dcterms:creator>Ilina Sharma</dcterms:creator>
        <dcterms:created>2026-02-26</dcterms:created>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>


    <!-- =============================================== -->
    <!-- ANNOTATION PROPERTIES (read by scripts/owl-to-csv.py) -->
    <!-- =============================================== -->

    <owl:AnnotationProperty rdf:about="#valueConstraint">
        <rdfs:label>value constraint</rdfs:label>
        <rdfs:comment>Allowed values of a data property, as range:min-max or values:a|b|c (Constraints column of node-properties.csv)</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#edgeProperty">
        <rdfs:label>edge property</rdfs:label>
        <rdfs:comment>A property stored on the relationship itself in Neo4j, as "name | datatype | description" (relationship-properties.csv); OWL data properties describe nodes, not edges</rdfs:comment>
    </owl:AnnotationProperty>


    <!-- =============================================== -->
    <!-- TOP-LEVEL CLASSES                               -->
    <!-- =============================================== -->

    <!-- Core Domain Classes -->
    <owl:Class rdf:about="#Organization">
        <rdfs:label>Organization</rdfs:label>
        <rdfs:comment>Entities Involved In The SR8 Project</rdfs:comment>
    </owl:Class>


    <!-- =============================================== -->
    <!-- ORGANIZATION HIERARCHY                          -->
    <!-- =============================================== -->

    <owl:Class rdf:about="#Department">
        <rdfs:subClassOf rdf:resource="#Organization"/>
        <rdfs:label>Department</rdfs:label>
        <rdfs:comment>Technical Or Operational Department Within Sunswift</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TechnicalDepartment">
        <rdfs:subClassOf rdf:resource="#Department"/>
        <rdfs:label>Technical Department</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#OperationalDepartment">
        <rdfs:subClassOf rdf:resource="#Department"/>
        <rdfs:label>Operational Department</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#ChassisAndBodywork">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>Chassis &amp; Bodywork</rdfs:label>
        <rdfs:comment>Chassis &amp; Bodywork Technical Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Interior">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>Interior</rdfs:label>
        <rdfs:comment>Interior Technical Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Powertrain">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>Powertrain</rdfs:label>
        <rdfs:comment>Powertrain Technical Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#VehicleDynamics">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>Vehicle Dynamics</rdfs:label>
        <rdfs:comment>Vehicle Dynamics Technical Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#EnergySystems">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>Energy Systems</rdfs:label>
        <rdfs:comment>Energy Systems Technical Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#EmbeddedSystems">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>Embedded Systems</rdfs:label>
        <rdfs:comment>Embedded Systems Technical Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TechnicalSupportSystems">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>Technical Support Systems</rdfs:label>
        <rdfs:comment>Technical Support Systems Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#IndustrialDesign">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>Industrial Design</rdfs:label>
        <rdfs:comment>Industrial Design Technical Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#WholeTeam">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>Whole Team</rdfs:label>
        <rdfs:comment>Whole Team Technical Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RemoteDriving">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>Remote Driving</rdfs:label>
        <rdfs:comment>Remote Driving Technical Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#General">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>General</rdfs:label>
        <rdfs:comment>General Technical Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AlternativeEnergies">
        <rdfs:subClassOf rdf:resource="#TechnicalDepartment"/>
        <rdfs:label>Alternative Energies</rdfs:label>
        <rdfs:comment>Alternative Energies Technical Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#IndustryPartner">
        <rdfs:subClassOf rdf:resource="#Organization"/>
        <rdfs:label>Industry Partner</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#AcademicPartner">
        <rdfs:subClassOf rdf:resource="#Organization"/>
        <rdfs:label>Academic Partner</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Members">
        <rdfs:subClassOf rdf:resource="#Department"/>
        <rdfs:label>Members</rdfs:label>
        <rdfs:comment>Team Members Or Project Assignees (100 Members)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ProjectLead">
        <rdfs:subClassOf rdf:resource="#Members"/>
        <rdfs:label>Project Lead</rdfs:label>
        <rdfs:comment>Lead Responsible For Project Delivery</rdfs:comment>
    </owl:Class>


    <!-- =============================================== -->
    <!-- ENGINEERING HIERARCHY (FLATTENED)               -->
    <!-- =============================================== -->

    <owl:Class rdf:about="#ProjectTrackingSystem">
        <rdfs:label>Project Tracking System</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#System">
        <rdfs:subClassOf rdf:resource="#ProjectTrackingSystem"/>
        <rdfs:label>System</rdfs:label>
        <rdfs:comment>System Grouping Within A Project Tracking System (Contains 2+ Subsystems)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Document">
        <rdfs:label>Document</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#RegulatoryDocument">
        <rdfs:subClassOf rdf:resource="#Document"/>
        <rdfs:label>Regulatory Document</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#AustralianDesignRule">
        <rdfs:subClassOf rdf:resource="#RegulatoryDocument"/>
        <rdfs:label>Australian Design Rule (ADR)</rdfs:label>
        <rdfs:comment>National Regulatory Framework For Vehicle Compliance</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#EngineeringBrief">
        <rdfs:subClassOf rdf:resource="#Document"/>
        <rdfs:label>Engineering Brief</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#TestingDocuments">
        <rdfs:subClassOf rdf:resource="#Document"/>
        <rdfs:label>Testing Documents</rdfs:label>
        <rdfs:comment>Testing Document Collection</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ConceptualDesign">
        <rdfs:subClassOf rdf:resource="#Document"/>
        <rdfs:label>Conceptual Design</rdfs:label>
        <rdfs:comment>Conceptual Design Stage Documentation</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#PreliminaryDesign">
        <rdfs:subClassOf rdf:resource="#Document"/>
        <rdfs:label>Preliminary Design</rdfs:label>
        <rdfs:comment>Preliminary Design Stage Documentation</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DetailedDesign">
        <rdfs:subClassOf rdf:resource="#Document"/>
        <rdfs:label>Detailed Design</rdfs:label>
        <rdfs:comment>Detailed Design Stage Documentation</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TechnicalSpecification">
        <rdfs:subClassOf rdf:resource="#TestingDocuments"/>
        <rdfs:label>Technical Specification</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#TestReport">
        <rdfs:subClassOf rdf:resource="#TestingDocuments"/>
        <rdfs:label>Test Report</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#DesignNote">
        <rdfs:subClassOf rdf:resource="#TestingDocuments"/>
        <rdfs:label>Design Note</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#SimulationOutput">
        <rdfs:subClassOf rdf:resource="#TestingDocuments"/>
        <rdfs:label>Simulation Output</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#EngineeringDrawing">
        <rdfs:subClassOf rdf:resource="#TestingDocuments"/>
        <rdfs:label>Engineering Drawing</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Requirement">
        <rdfs:label>Requirement</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#InternalRequirement">
        <rdfs:subClassOf rdf:resource="#Requirement"/>
        <rdfs:label>Internal Requirement</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#ExtractedRequirement">
        <rdfs:subClassOf rdf:resource="#Requirement"/>
        <rdfs:label>Extracted Requirement</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#InternalEssentialRequirement">
        <rdfs:subClassOf rdf:resource="#InternalRequirement"/>
        <rdfs:label>Internal Essential Requirement</rdfs:label>
        <rdfs:comment>Non-Negotiable Internal Requirement Imposing Strict Constraints</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#InternalRecommendedRequirement">
        <rdfs:subClassOf rdf:resource="#InternalRequirement"/>
        <rdfs:label>Internal Recommended Requirement</rdfs:label>
        <rdfs:comment>Contextual Internal Requirement With Interpretative Flexibility</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ExtractedEssentialRequirement">
        <rdfs:subClassOf rdf:resource="#ExtractedRequirement"/>
        <rdfs:label>Extracted Essential Requirement</rdfs:label>
        <rdfs:comment>Non-Negotiable External Requirement Imposing Strict Constraints</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ExtractedRecommendedRequirement">
        <rdfs:subClassOf rdf:resource="#ExtractedRequirement"/>
        <rdfs:label>Extracted Recommended Requirement</rdfs:label>
        <rdfs:comment>Contextual External Requirement With Interpretative Flexibility</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ValidationScenario">
        <rdfs:subClassOf rdf:resource="#Requirement"/>
        <rdfs:label>Validation Scenario</rdfs:label>
        <rdfs:comment>Operational Context Used To Validate Intended Use</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AcceptanceCriterion">
        <rdfs:subClassOf rdf:resource="#ValidationScenario"/>
        <rdfs:label>Acceptance Criterion</rdfs:label>
        <rdfs:comment>Measurable Criterion Defining Validation Success</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ValidationResult">
        <rdfs:subClassOf rdf:resource="#Requirement"/>
        <rdfs:label>Validation Result</rdfs:label>
        <rdfs:comment>Outcome Record For Validation Execution</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#PartsManagement">
        <rdfs:label>Parts Management</rdfs:label>
        <rdfs:comment>Parts Management Domain For Components And Assemblies</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Assembly">
        <rdfs:subClassOf rdf:resource="#PartsManagement"/>
        <rdfs:label>Assembly</rdfs:label>
        <rdfs:comment>A Higher-Level Build Unit Composed Of Multiple Components</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Component">
        <rdfs:subClassOf rdf:resource="#PartsManagement"/>
        <rdfs:label>Component</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Subsystem">
        <rdfs:subClassOf rdf:resource="#System"/>
        <rdfs:label>Subsystem</rdfs:label>
        <rdfs:comment>Functional Unit Within A System</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Project">
        <rdfs:label>Project</rdfs:label>
        <rdfs:comment>Engineering Project With ID, Name, And Description (189 Concurrent Projects)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#VerificationProcedure">
        <rdfs:subClassOf rdf:resource="#Requirement"/>
        <rdfs:label>Verification Procedure</rdfs:label>
        <rdfs:comment>Detailed Procedure For Verifying ADR Compliance</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#VerificationMethod">
        <rdfs:subClassOf rdf:resource="#VerificationProcedure"/>
        <rdfs:label>Verification Method</rdfs:label>
        <rdfs:comment>Method Used To Verify Compliance With Requirements</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Inspection">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>Inspection</rdfs:label>
        <rdfs:comment>Visual Or Manual Inspection Verification Method</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Demonstration">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>Demonstration</rdfs:label>
        <rdfs:comment>Demonstration-Based Verification Method</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Test">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>Test</rdfs:label>
        <rdfs:comment>Physical Or Functional Test Verification Method</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Analysis">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>Analysis</rdfs:label>
        <rdfs:comment>Analytical Verification Including Simulations &amp; Calculations</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ADRAnnex">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>ADR Annex</rdfs:label>
        <rdfs:comment>Verification Through ADR Annex Procedures</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ADRTestingProcedure">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>ADR Testing Procedure</rdfs:label>
        <rdfs:comment>Official ADR Testing Procedure Verification Method</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TestingEvidence">
        <rdfs:subClassOf rdf:resource="#Document"/>
        <rdfs:label>Testing Evidence</rdfs:label>
        <rdfs:comment>Evidence Supporting Verification Of Compliance, Formed When Multiple Components Work Together To Pass Testing Procedures</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#InspectionEvidence">
        <rdfs:subClassOf rdf:resource="#TestingEvidence"/>
        <rdfs:label>Inspection Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through Visual Or Manual Inspection</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DemonstrationEvidence">
        <rdfs:subClassOf rdf:resource="#TestingEvidence"/>
        <rdfs:label>Demonstration Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through Functional Demonstration</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TestEvidence">
        <rdfs:subClassOf rdf:resource="#TestingEvidence"/>
        <rdfs:label>Test Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through Physical Or Functional Testing</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AnalysisEvidence">
        <rdfs:subClassOf rdf:resource="#TestingEvidence"/>
        <rdfs:label>Analysis Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through Simulations &amp; Calculations (CFD, FEA, Etc.)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ADRAnnexEvidence">
        <rdfs:subClassOf rdf:resource="#TestingEvidence"/>
        <rdfs:label>ADR Annex Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through ADR Annex Procedures</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ADRTestingProcedureEvidence">
        <rdfs:subClassOf rdf:resource="#TestingEvidence"/>
        <rdfs:label>ADR Testing Procedure Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through Official ADR Testing Procedures</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Clause">
        <rdfs:subClassOf rdf:resource="#Requirement"/>
        <rdfs:label>Clause</rdfs:label>
        <rdfs:comment>Specific Clause Within An ADR (Each Clause Is A New Node Connected To 1 ADR)</rdfs:comment>
    </owl:Class>



    <!-- Classes written by the extractors and sr8-mcp (FMEA, review feedback, change impact) -->
    <owl:Class rdf:about="#FailureMode">
        <rdfs:label>failure mode</rdfs:label>
        <rdfs:comment>Way In Which A Component Can Fail (FMEA)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Cause">
        <rdfs:label>cause</rdfs:label>
        <rdfs:comment>Root Cause Of A Failure Mode (FMEA)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Effect">
        <rdfs:label>effect</rdfs:label>
        <rdfs:comment>Consequence Of A Failure Mode (FMEA)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ControlAction">
        <rdfs:label>control action</rdfs:label>
        <rdfs:comment>Mitigation Or Control Action For A Failure Mode (FMEA)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#FeedbackEvent">
        <rdfs:label>feedback event</rdfs:label>
        <rdfs:comment>A Reviewer's Decision On An Inferred Project Link, With The Reward Given To The RL Agent</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ChangeImpactReport">
        <rdfs:subClassOf rdf:resource="#Document"/>
        <rdfs:label>change impact report</rdfs:label>
        <rdfs:comment>Report Of The Requirements And Projects Affected By A Proposed Change</rdfs:comment>
    </owl:Class>

    <!-- =============================================== -->
    <!-- OBJECT PROPERTIES (RELATIONSHIPS)               -->
    <!-- =============================================== -->

    <!-- Organizational Relationships -->
    <owl:ObjectProperty rdf:about="#hasDepartment">
        <rdfs:domain rdf:resource="#Organization"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has department</rdfs:label>
        <rdfs:comment>Has Department</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasPrimaryDepartment">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has primary department</rdfs:label>
        <rdfs:comment>Links A Project To Its Primary Responsible Department</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSecondaryDepartment">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has secondary department</rdfs:label>
        <rdfs:comment>Links A Project To Its Secondary Supporting Department</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasAssignee">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Members"/>
        <rdfs:label>has assignee</rdfs:label>
        <rdfs:comment>Links A Project To A Members Node (Project Assignee)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#collaboratesWith">
        <rdfs:domain rdf:resource="#Organization"/>
        <rdfs:range rdf:resource="#Organization"/>
        <rdfs:label>collaborates with</rdfs:label>
        <rdfs:comment>Collaborates With</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#assignedToSystem">
        <rdfs:domain rdf:resource="#TechnicalDepartment"/>
        <rdfs:range rdf:resource="#System"/>
        <rdfs:label>assigned to system</rdfs:label>
        <rdfs:comment>Technical Department Assigned To System</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#assignedToSubsystem">
        <rdfs:domain rdf:resource="#TechnicalDepartment"/>
        <rdfs:range rdf:resource="#Subsystem"/>
        <rdfs:label>assigned to subsystem</rdfs:label>
        <rdfs:comment>Technical Department Assigned To Subsystem</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#departmentAssignedToProject">
        <rdfs:domain rdf:resource="#TechnicalDepartment"/>
        <rdfs:range rdf:resource="#Project"/>
        <rdfs:label>department assigned to project</rdfs:label>
        <rdfs:comment>Technical Department Assigned To Project</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Engineering Relationships -->
    <owl:ObjectProperty rdf:about="#hasRequirement">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>has requirement</rdfs:label>
        <rdfs:comment>Has Requirement</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#subsystemHasRequirement">
        <rdfs:domain rdf:resource="#Subsystem"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>subsystem has requirement</rdfs:label>
        <rdfs:comment>Subsystem Has Requirement</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#systemHasRequirement">
        <rdfs:domain rdf:resource="#System"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>system has requirement</rdfs:label>
        <rdfs:comment>System Has Requirement</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#projectHasRequirement">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>project has requirement</rdfs:label>
        <rdfs:comment>Project Has Requirement</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#validatesUseCase">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="#ValidationScenario"/>
        <rdfs:label>validates use case</rdfs:label>
        <rdfs:comment>Entity Validates Intended Use Case Through Scenario</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasAcceptanceCriterion">
        <rdfs:domain rdf:resource="#ValidationScenario"/>
        <rdfs:range rdf:resource="#AcceptanceCriterion"/>
        <rdfs:label>has acceptance criterion</rdfs:label>
        <rdfs:comment>Validation Scenario Has Acceptance Criterion</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#validatedBy">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="#ValidationResult"/>
        <rdfs:label>validated by</rdfs:label>
        <rdfs:comment>Entity Is Validated By Validation Result</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#validatesRequirement">
        <rdfs:domain rdf:resource="#ValidationResult"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>validates requirement</rdfs:label>
        <rdfs:comment>Validation Result Validates Requirement</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasComponent">
        <rdfs:domain rdf:resource="#Subsystem"/>
        <rdfs:range rdf:resource="#Component"/>
        <rdfs:label>has component</rdfs:label>
        <rdfs:comment>Has Component</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#componentInSubsystem">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#Subsystem"/>
        <rdfs:label>component in subsystem</rdfs:label>
        <rdfs:comment>Component Goes Into Subsystem</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#componentInSystem">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#System"/>
        <rdfs:label>component in system</rdfs:label>
        <rdfs:comment>Component Goes Into System</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#componentInProject">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#Project"/>
        <rdfs:label>component in project</rdfs:label>
        <rdfs:comment>Component Goes Into Project</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#assembledFrom">
        <rdfs:domain rdf:resource="#Assembly"/>
        <rdfs:range rdf:resource="#Component"/>
        <rdfs:label>assembled from</rdfs:label>
        <rdfs:comment>Assembly Is Composed Of Multiple Components</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSubsystem">
        <rdfs:domain rdf:resource="#System"/>
        <rdfs:range rdf:resource="#Subsystem"/>
        <rdfs:label>has subsystem</rdfs:label>
        <rdfs:comment>Has Subsystem</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#interface">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#System"/>
                    <rdf:Description rdf:about="#Subsystem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#System"/>
                    <rdf:Description rdf:about="#Subsystem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>interface</rdfs:label>
        <rdfs:comment>Connection Relationship Between 2+ Systems And/Or 2+ Subsystems</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#dependsOn">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>depends on</rdfs:label>
        <rdfs:comment>Depends On</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#impactsOn">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>impacts on</rdfs:label>
        <rdfs:comment>Impacts On</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#appliesTo">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>applies to</rdfs:label>
        <rdfs:comment>Applies To</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#derivedFrom">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="#AustralianDesignRule"/>
        <rdfs:label>derived from</rdfs:label>
        <rdfs:comment>Derived From</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#documentedIn">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="#Document"/>
        <rdfs:label>documented in</rdfs:label>
        <rdfs:comment>Documented In</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Compliance and Risk -->
    <owl:ObjectProperty rdf:about="#compliesWith">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="#AustralianDesignRule"/>
        <rdfs:label>complies with</rdfs:label>
        <rdfs:comment>Complies With</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasRisk">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>has risk</rdfs:label>
        <rdfs:comment>Has Risk</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#propagatesRiskTo">
        <rdfs:domain rdf:resource="#Subsystem"/>
        <rdfs:range rdf:resource="#Subsystem"/>
        <rdfs:label>propagates risk to</rdfs:label>
        <rdfs:comment>Propagates Risk To</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ADR Verification Relationships -->
    <owl:ObjectProperty rdf:about="#assignedToProject">
        <rdfs:domain rdf:resource="#ExtractedEssentialRequirement"/>
        <rdfs:range rdf:resource="#Project"/>
        <rdfs:label>assigned to project</rdfs:label>
        <rdfs:comment>Links An Extracted Essential Requirement To The Responsible Project</rdfs:comment>
        <edgeProperty>source | string | extracted (extract-ADR.py), inferred (promote_inferred_link) or inferred-modified (modify_inferred_link)</edgeProperty>
        <edgeProperty>promotedAt | datetime | When a reviewer promoted the suggestion</edgeProperty>
        <edgeProperty>promotedBy | string | Reviewer who promoted it (human-review on links made by the old code)</edgeProperty>
        <edgeProperty>promotedFromConfidence | float | Confidence of the suggestion when it was promoted</edgeProperty>
        <edgeProperty>inferenceReasoning | string | Reasoning copied from the suggestion</edgeProperty>
        <edgeProperty>inferredBy | string | Who wrote the suggestion, copied from it</edgeProperty>
        <edgeProperty>inferredAt | datetime | When the suggestion was written, copied from it</edgeProperty>
        <edgeProperty>inferenceState | string | Problem B state of the suggestion, copied from it</edgeProperty>
        <edgeProperty>modifiedFromProject | string | Project the suggestion proposed, when the reviewer assigned a different one</edgeProperty>
        <edgeProperty>modificationReason | string | Reviewer's reason for assigning a different project</edgeProperty>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasVerificationProcedure">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#VerificationProcedure"/>
        <rdfs:label>has verification procedure</rdfs:label>
        <rdfs:comment>Links An ADR To Its Verification Procedure</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasVerificationMethod">
        <rdfs:domain rdf:resource="#VerificationProcedure"/>
        <rdfs:range rdf:resource="#VerificationMethod"/>
        <rdfs:label>has verification method</rdfs:label>
        <rdfs:comment>Specifies The Method Used In A Verification Procedure</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#supportedByEvidence">
        <rdfs:domain rdf:resource="#VerificationProcedure"/>
        <rdfs:range rdf:resource="#TestingEvidence"/>
        <rdfs:label>supported by evidence</rdfs:label>
        <rdfs:comment>Links Verification Procedure To Supporting Evidence</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#verifiedBy">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#TestingEvidence"/>
        <rdfs:label>verified by</rdfs:label>
        <rdfs:comment>Direct Link From ADR To Verification Evidence</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#assignedToDepartment">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>assigned to department</rdfs:label>
        <rdfs:comment>Links An ADR To The Relevant Department</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasRelevantProject">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#Project"/>
        <rdfs:label>has relevant project</rdfs:label>
        <rdfs:comment>Links An ADR To Relevant Projects</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasRelevantDepartment">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has relevant department</rdfs:label>
        <rdfs:comment>Links An ADR To Relevant Departments</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasClause">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#Clause"/>
        <rdfs:label>has clause</rdfs:label>
        <rdfs:comment>Links An ADR To Its Specific Clause References (Each Clause Is A New Node Connected To 1 ADR)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasExternalEssentialRequirement">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#ExtractedEssentialRequirement"/>
        <rdfs:label>has external essential requirement</rdfs:label>
        <rdfs:comment>ADR Has External Essential Requirement</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasExternalRecommendedRequirement">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#ExtractedRecommendedRequirement"/>
        <rdfs:label>has external recommended requirement</rdfs:label>
        <rdfs:comment>ADR Has External Recommended Requirement</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Component Management Relationships -->
    <owl:ObjectProperty rdf:about="#usedInProject">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#Project"/>
        <rdfs:label>used in project</rdfs:label>
        <rdfs:comment>Links A Component To The Project(s) It Belongs To</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#usedInADR">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#AustralianDesignRule"/>
        <rdfs:label>used in ADR</rdfs:label>
        <rdfs:comment>Links A Component To ADRs It Helps Verify</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#generatesEvidence">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#TestingEvidence"/>
        <rdfs:label>generates evidence</rdfs:label>
        <rdfs:comment>Links A Component To The Evidence It Generates For ADR Verification</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#suppliedBy">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#IndustryPartner"/>
        <rdfs:label>supplied by</rdfs:label>
        <rdfs:comment>Links A Component To Its Supplier Or Partner</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#partOfBOM">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#Component"/>
        <rdfs:label>part of BOM</rdfs:label>
        <rdfs:comment>Bill Of Materials Hierarchy - Component Is Part Of Another Component Assembly</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#belongsToDepartment">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>belongs to department</rdfs:label>
        <rdfs:comment>Links A Component To Its Responsible Department</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSection">
        <rdfs:domain rdf:resource="#Department"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has section</rdfs:label>
        <rdfs:comment>Organizational Hierarchy - Department Has Sections</rdfs:comment>
    </owl:ObjectProperty>



    <!-- Relationships written by the extractors and sr8-mcp -->
    <owl:ObjectProperty rdf:about="#hasFailureMode">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#FailureMode"/>
        <rdfs:label>has failure mode</rdfs:label>
        <rdfs:comment>Has Failure Mode (FMEA)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#causedBy">
        <rdfs:domain rdf:resource="#FailureMode"/>
        <rdfs:range rdf:resource="#Cause"/>
        <rdfs:label>caused by</rdfs:label>
        <rdfs:comment>Caused By (FMEA)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#causes">
        <rdfs:domain rdf:resource="#FailureMode"/>
        <rdfs:range rdf:resource="#Effect"/>
        <rdfs:label>causes</rdfs:label>
        <rdfs:comment>Causes (FMEA)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#mitigatedBy">
        <rdfs:domain rdf:resource="#FailureMode"/>
        <rdfs:range rdf:resource="#ControlAction"/>
        <rdfs:label>mitigated by</rdfs:label>
        <rdfs:comment>Mitigated By (FMEA)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#satisfiesRequirement">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>satisfies requirement</rdfs:label>
        <rdfs:comment>Satisfies Requirement (FMEA Mapping)</rdfs:comment>
        <edgeProperty>sourceFile | string | FMEA workbook file the link came from</edgeProperty>
        <edgeProperty>sourceSheet | string | Workbook sheet (Requirement Mapping)</edgeProperty>
        <edgeProperty>sourceRow | integer | Workbook row of the link (header is row 1)</edgeProperty>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#suggestedProject">
        <rdfs:domain rdf:resource="#ExtractedEssentialRequirement"/>
        <rdfs:range rdf:resource="#Project"/>
        <rdfs:label>suggested project</rdfs:label>
        <rdfs:comment>Requirement Suggested For Project By Inference (Pending Human Review)</rdfs:comment>
        <edgeProperty>confidence | float | Confidence after the RL adjustment</edgeProperty>
        <edgeProperty>baseConfidence | float | Confidence given by the caller, before the RL adjustment</edgeProperty>
        <edgeProperty>reasoning | string | Why the link was suggested</edgeProperty>
        <edgeProperty>inferredBy | string | Who wrote the suggestion (Ollama-MCP)</edgeProperty>
        <edgeProperty>inferredAt | datetime | When the suggestion was written</edgeProperty>
        <edgeProperty>inferenceState | string | Problem B state when written: inference_&lt;strong|weak&gt;_&lt;yes|no&gt;_&lt;high|mid|low&gt;</edgeProperty>
        <edgeProperty>rlAction | string | Action the RL agent chose: increase_confidence, keep_confidence or decrease_confidence</edgeProperty>
        <edgeProperty>schemaValidated | boolean | True when the write passed the schema-layer check</edgeProperty>
        <edgeProperty>schemaCheckedAt | datetime | When the schema-layer check ran</edgeProperty>
        <edgeProperty>previousConfidence | float | Confidence before the last revision of a pending suggestion</edgeProperty>
        <edgeProperty>previousReasoning | string | Reasoning before the last revision of a pending suggestion</edgeProperty>
        <edgeProperty>revisionCount | integer | Number of revisions of a pending suggestion</edgeProperty>
        <edgeProperty>resubmissionOf | datetime | inferredAt of the reviewed suggestion this one resubmits</edgeProperty>
        <edgeProperty>status | string | Review outcome: promoted, modified or rejected; absent while pending</edgeProperty>
        <edgeProperty>reviewedBy | string | Reviewer who decided</edgeProperty>
        <edgeProperty>reviewedAt | datetime | When the reviewer decided</edgeProperty>
        <edgeProperty>rejectionReason | string | Reviewer's reason for rejecting</edgeProperty>
        <edgeProperty>modifiedTo | string | Project the reviewer assigned instead (status modified)</edgeProperty>
        <edgeProperty>modificationReason | string | Reviewer's reason for assigning a different project</edgeProperty>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#belongsToAssembly">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Assembly"/>
        <rdfs:label>belongs to assembly</rdfs:label>
        <rdfs:comment>Project Belongs To Assembly (Group Of Projects)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#recordedFor">
        <rdfs:domain rdf:resource="#FeedbackEvent"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#ExtractedEssentialRequirement"/>
                    <rdf:Description rdf:about="#Project"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>recorded for</rdfs:label>
        <rdfs:comment>Feedback Event Recorded For The Requirement And Project Of The Reviewed Link</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#affectsRequirement">
        <rdfs:domain rdf:resource="#ChangeImpactReport"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>affects requirement</rdfs:label>
        <rdfs:comment>Change Impact Report Affects Requirement</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#affectsProject">
        <rdfs:domain rdf:resource="#ChangeImpactReport"/>
        <rdfs:range rdf:resource="#Project"/>
        <rdfs:label>affects project</rdfs:label>
        <rdfs:comment>Change Impact Report Affects Project</rdfs:comment>
    </owl:ObjectProperty>

    <!-- =============================================== -->
    <!-- DATA PROPERTIES (ATTRIBUTES)                    -->
    <!-- =============================================== -->

    <owl:DatatypeProperty rdf:about="#hasID">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has ID</rdfs:label>
        <rdfs:comment>Unique Identifier For A Node</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has name</rdfs:label>
        <rdfs:comment>Display Name For A Node</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasDescription">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has description</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasConfidenceScore">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>has confidence score</rdfs:label>
        <rdfs:comment>Has Confidence Score</rdfs:comment>
        <valueConstraint>range:0.0-1.0</valueConstraint>
    </owl:DatatypeProperty>


    <owl:DatatypeProperty rdf:about="#hasProvenance">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has provenance</rdfs:label>
        <rdfs:comment>Source Provenance Of Extracted Data</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#isEssential">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is essential</rdfs:label>
        <rdfs:comment>Is Essential</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasRiskLevel">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has risk level</rdfs:label>
        <rdfs:comment>Has Risk Level</rdfs:comment>
        <valueConstraint>values:Low|Medium|High|Critical</valueConstraint>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasTimestamp">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label>has timestamp</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#numberOfMembers">
        <rdfs:domain rdf:resource="#Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>number of members</rdfs:label>
        <rdfs:comment>Number Of Members</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#numberOfDepartments">
        <rdfs:domain rdf:resource="#Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>number of departments</rdfs:label>
        <rdfs:comment>Number Of Departments</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#numberOfProjects">
        <rdfs:domain rdf:resource="#Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>number of projects</rdfs:label>
        <rdfs:comment>Number Of Projects</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#numberOfComponents">
        <rdfs:domain rdf:resource="#ProjectTrackingSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>number of components</rdfs:label>
        <rdfs:comment>Number Of Components</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#numberOfRequirements">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>number of requirements</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#isRoadLegal">
        <rdfs:domain rdf:resource="#ProjectTrackingSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is road legal</rdfs:label>
        <rdfs:comment>Is Road Legal</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#isConditional">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is conditional</rdfs:label>
        <rdfs:comment>Is Conditional</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasExemption">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has exemption</rdfs:label>
        <rdfs:comment>Has Exemption</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#requirementName">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>requirement name</rdfs:label>
        <rdfs:comment>Name Or Title Of The Requirement</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#requirementText">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>requirement text</rdfs:label>
        <rdfs:comment>Full Text Of The Requirement</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#projectID">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Project"/>
                    <rdf:Description rdf:about="#FeedbackEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>project ID</rdfs:label>
        <rdfs:comment>Unique Identifier For The Project</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#projectName">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>project name</rdfs:label>
        <rdfs:comment>Name Of The Project</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#projectDescription">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>project description</rdfs:label>
        <rdfs:comment>Description Of The Project</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#requirementDescription">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>requirement description</rdfs:label>
        <rdfs:comment>Detailed Description Of The Requirement</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#testingProcedurePerRequirement">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>testing procedure per requirement</rdfs:label>
        <rdfs:comment>Specific Testing Procedure For This Requirement</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#isVerified">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is verified</rdfs:label>
        <rdfs:comment>Indicates Whether The ADR Has Been Verified</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#usesAlternativeTesting">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>uses alternative testing</rdfs:label>
        <rdfs:comment>Indicates If Alternative Means Of Testing Is Used Compared To Standard ADR Procedures</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#verificationMethodDescription">
        <rdfs:domain rdf:resource="#VerificationProcedure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>verification method description</rdfs:label>
        <rdfs:comment>Detailed Description Of The Verification Method &amp; Procedure</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#rightProjectAssigned">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>right project assigned</rdfs:label>
        <rdfs:comment>Indicates If The Correct Project Has Been Assigned To This ADR</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#alternativeProjectSuggestion">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>alternative project suggestion</rdfs:label>
        <rdfs:comment>Suggested Alternative Project If The Current Assignment Is Incorrect</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Component Management Properties -->
    <owl:DatatypeProperty rdf:about="#partNumber">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>part number</rdfs:label>
        <rdfs:comment>Unique Part Number Identifier</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#partDescription">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>part description</rdfs:label>
        <rdfs:comment>Description Of The Component/Part</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#bomLevel">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>BOM level</rdfs:label>
        <rdfs:comment>Bill Of Materials Hierarchy Level</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#approvalStatus">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>approval status</rdfs:label>
        <rdfs:comment>Component Approval Status</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#componentStatus">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>component status</rdfs:label>
        <rdfs:comment>Current Status Of The Component</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#onCarSoftwareOffCar">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>on-car software off-car</rdfs:label>
        <rdfs:comment>Classification As On-Car Software Or Off-Car Component</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#quantityPer">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>quantity per</rdfs:label>
        <rdfs:comment>Quantity Required Per Assembly</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#relatedADRs">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>related ADRs</rdfs:label>
        <rdfs:comment>List Of ADRs That This Component Relates To</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#engineeringDrawingRequired">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>engineering drawing required</rdfs:label>
        <rdfs:comment>Indicates If Engineering Drawing Is Required For This Component</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#estimatedWeight">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>estimated weight</rdfs:label>
        <rdfs:comment>Estimated Weight In Kilograms</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#actualWeight">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>actual weight</rdfs:label>
        <rdfs:comment>Actual Measured Weight In Kilograms</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#procurementStatus">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>procurement status</rdfs:label>
        <rdfs:comment>Status Of Component Procurement</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#supplier">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>supplier</rdfs:label>
        <rdfs:comment>Supplier Or Partner Name</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#assemblyEstimatedCost">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>assembly estimated cost</rdfs:label>
        <rdfs:comment>Estimated Assembly Cost</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#assemblyActualCost">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>assembly actual cost</rdfs:label>
        <rdfs:comment>Actual Assembly Cost</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#orderStatus">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>order status</rdfs:label>
        <rdfs:comment>Current Order Status Of The Component</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#stockQuantity">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>stock quantity</rdfs:label>
        <rdfs:comment>Quantity In Stock</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#stockLocation">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>stock location</rdfs:label>
        <rdfs:comment>Physical Location Of Stock</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#componentProjectName">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>project name</rdfs:label>
        <rdfs:comment>Name Of The Project Using This Component</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#clause">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>clause</rdfs:label>
        <rdfs:comment>ADR Clause Reference For This Component</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#sectionName">
        <rdfs:domain rdf:resource="#Department"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>section name</rdfs:label>
        <rdfs:comment>Name Of The Section Within A Department</rdfs:comment>
    </owl:DatatypeProperty>


    <!-- =============================================== -->
    <!-- INDIVIDUALS (INSTANCES)                         -->
    <!-- =============================================== -->


    <!-- Node properties written by the extractors and sr8-mcp -->
    <owl:DatatypeProperty rdf:about="#applicabilityNote">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Requirement"/>
                    <rdf:Description rdf:about="#Clause"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>applicability note</rdfs:label>
        <rdfs:comment>Applicability Context Note (e.g. Not Applicable Reason)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#clauseText">
        <rdfs:domain rdf:resource="#Clause"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>clause text</rdfs:label>
        <rdfs:comment>Full Text Of The ADR Clause</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#isApplicable">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Requirement"/>
                    <rdf:Description rdf:about="#Clause"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is applicable</rdfs:label>
        <rdfs:comment>Applicability Flag For Requirement/Clause</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#clauseNumber">
        <rdfs:domain rdf:resource="#ExtractedEssentialRequirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>clause number</rdfs:label>
        <rdfs:comment>ADR Clause Number Of The Row The Requirement Was Extracted From</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#applicabilityBasis">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Requirement"/>
                    <rdf:Description rdf:about="#Clause"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>applicability basis</rdfs:label>
        <rdfs:comment>What Decided isApplicable: column, name_keyword or default</rdfs:comment>
        <valueConstraint>values:column|name_keyword|default</valueConstraint>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#needsReview">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Requirement"/>
                    <rdf:Description rdf:about="#Clause"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>needs review</rdfs:label>
        <rdfs:comment>True When The Applicability Column Is Unrecognised Or Contradicts The Name Keywords</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#requirementID">
        <rdfs:domain rdf:resource="#FeedbackEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>requirement ID</rdfs:label>
        <rdfs:comment>hasID Of The Requirement Of The Reviewed Link</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#action">
        <rdfs:domain rdf:resource="#FeedbackEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>action</rdfs:label>
        <rdfs:comment>Reviewer Decision</rdfs:comment>
        <valueConstraint>values:confirmed|rejected|modified|ignored</valueConstraint>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#reward">
        <rdfs:domain rdf:resource="#FeedbackEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>reward</rdfs:label>
        <rdfs:comment>Reward Applied To The RL Agent (-2.0 When An Overconfident Suggestion Is Rejected)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#inferenceState">
        <rdfs:domain rdf:resource="#FeedbackEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>inference state</rdfs:label>
        <rdfs:comment>Problem B State Of The Reviewed Suggestion</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#overconfidencePenaltyApplied">
        <rdfs:domain rdf:resource="#FeedbackEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>overconfidence penalty applied</rdfs:label>
        <rdfs:comment>True When The -2.0 Overconfidence Penalty Replaced The Reward</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#rlAction">
        <rdfs:domain rdf:resource="#FeedbackEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>RL action</rdfs:label>
        <rdfs:comment>Action The RL Agent Chose For The Reviewed Suggestion (The Action Credited)</rdfs:comment>
        <valueConstraint>values:increase_confidence|keep_confidence|decrease_confidence</valueConstraint>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#reviewer">
        <rdfs:domain rdf:resource="#FeedbackEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>reviewer</rdfs:label>
        <rdfs:comment>Person Who Made The Review Decision</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#changeDescription">
        <rdfs:domain rdf:resource="#ChangeImpactReport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>change description</rdfs:label>
        <rdfs:comment>Description Of The Proposed Change</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#riskSummary">
        <rdfs:domain rdf:resource="#ChangeImpactReport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>risk summary</rdfs:label>
        <rdfs:comment>Summary Of The Risk Of The Change</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#createdAt">
        <rdfs:domain rdf:resource="#ChangeImpactReport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label>created at</rdfs:label>
        <rdfs:comment>When The Report Was Created</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#affectedRequirementCount">
        <rdfs:domain rdf:resource="#ChangeImpactReport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>affected requirement count</rdfs:label>
        <rdfs:comment>Number Of Requirement IDs Given As Affected</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#affectedProjectCount">
        <rdfs:domain rdf:resource="#ChangeImpactReport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>affected project count</rdfs:label>
        <rdfs:comment>Number Of Project IDs Given As Affected</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#sourceFile">
        <rdfs:domain rdf:resource="#FailureMode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>source file</rdfs:label>
        <rdfs:comment>FMEA Workbook File The Failure Mode Came From</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#sourceSheet">
        <rdfs:domain rdf:resource="#FailureMode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>source sheet</rdfs:label>
        <rdfs:comment>Workbook Sheet The Failure Mode Came From (Failure Mode Data)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#sourceRows">
        <rdfs:domain rdf:resource="#FailureMode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>source rows</rdfs:label>
        <rdfs:comment>Workbook Row Numbers Of The Failure Mode (Header Is Row 1; Several Values)</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- =============================================== -->
    <!-- AXIOMS AND CONSTRAINTS                          -->
    <!-- =============================================== -->

    <!-- Disjoint Classes -->
    <rdf:Description rdf:about="#InternalEssentialRequirement">
        <owl:disjointWith rdf:resource="#InternalRecommendedRequirement"/>
    </rdf:Description>

    <rdf:Description rdf:about="#ExtractedEssentialRequirement">
        <owl:disjointWith rdf:resource="#ExtractedRecommendedRequirement"/>
    </rdf:Description>

    <rdf:Description rdf:about="#InternalRequirement">
        <owl:disjointWith rdf:resource="#ExtractedRequirement"/>
    </rdf:Description>

    <!-- Transitive Properties -->
    <rdf:Description rdf:about="#dependsOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </rdf:Description>

    <rdf:Description rdf:about="#hasComponent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </rdf:Description>

    <rdf:Description rdf:about="#partOfBOM">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </rdf:Description>

    <!-- Symmetric Properties -->
    <rdf:Description rdf:about="#collaboratesWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    </rdf:Description>


</rdf:RDF>