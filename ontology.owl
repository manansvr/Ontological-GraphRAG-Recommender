<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.sunswift.com/ontology/sr8-thesis#"
     xml:base="http://www.sunswift.com/ontology/sr8-thesis"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.sunswift.com/ontology/sr8-thesis">
        <dcterms:title>SR8 Ontology-Driven Knowledge Graph Framework</dcterms:title>
        <dcterms:description>A Comprehensive Ontology For The Sunswift Racing SR8 Systems Engineering Project, Integrating Regulatory Compliance, Knowledge Extraction, &amp; AI-Assisted Reasoning</dcterms:description>
        <dcterms:creator>Manan Rathi</dcterms:creator>
        <dcterms:creator>Ilina Sharma</dcterms:creator>
        <dcterms:created>2026-02-26</dcterms:created>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>


    <!-- =============================================== -->
    <!-- TOP-LEVEL CLASSES                               -->
    <!-- =============================================== -->

    <!-- Core Domain Classes -->
    <owl:Class rdf:about="#Organization">
        <rdfs:label>Organization</rdfs:label>
        <rdfs:comment>Entities Involved In The SR8 Project</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Artifact">
        <rdfs:label>Artifact</rdfs:label>
        <rdfs:comment>Engineering Artifacts, Documents, &amp; Knowledge Items</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Process">
        <rdfs:label>Process</rdfs:label>
        <rdfs:comment>Methodological Processes &amp; Workflows</rdfs:comment>
    </owl:Class>


    <!-- =============================================== -->
    <!-- ORGANIZATION HIERARCHY                          -->
    <!-- =============================================== -->

    <owl:Class rdf:about="#SunswiftRacing">
        <rdfs:subClassOf rdf:resource="#Organization"/>
        <rdfs:label>Sunswift Racing</rdfs:label>
        <rdfs:comment>Student Engineering Organization Focused On Solar-Electric Vehicles</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Department">
        <rdfs:subClassOf rdf:resource="#Organization"/>
        <rdfs:label>Department</rdfs:label>
        <rdfs:comment>Technical Or Operational Department Within Sunswift</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TechnicalDepartment">
        <rdfs:subClassOf rdf:resource="#Department"/>
        <rdfs:label>Technical Department</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#OperationalDepartment">
        <rdfs:subClassOf rdf:resource="#Department"/>
        <rdfs:label>Operational Department</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#IndustryPartner">
        <rdfs:subClassOf rdf:resource="#Organization"/>
        <rdfs:label>Industry Partner</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#AcademicPartner">
        <rdfs:subClassOf rdf:resource="#Organization"/>
        <rdfs:label>Academic Partner</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Member">
        <rdfs:subClassOf rdf:resource="#Organization"/>
        <rdfs:label>Member</rdfs:label>
        <rdfs:comment>Team Member Or Project Assignee (100 Members)</rdfs:comment>
    </owl:Class>


    <!-- =============================================== -->
    <!-- ARTIFACT HIERARCHY                              -->
    <!-- =============================================== -->

    <owl:Class rdf:about="#Vehicle">
        <rdfs:subClassOf rdf:resource="#Artifact"/>
        <rdfs:label>Vehicle</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#SR8">
        <rdfs:subClassOf rdf:resource="#Vehicle"/>
        <rdfs:label>Sunswift 8 (SR8)</rdfs:label>
        <rdfs:comment>World's First Road-Legal, Student-Built, Tri-Brid Electric Vehicle</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Document">
        <rdfs:subClassOf rdf:resource="#Artifact"/>
        <rdfs:label>Document</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#RegulatoryDocument">
        <rdfs:subClassOf rdf:resource="#Document"/>
        <rdfs:label>Regulatory Document</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#AustralianDesignRule">
        <rdfs:subClassOf rdf:resource="#RegulatoryDocument"/>
        <rdfs:label>Australian Design Rule (ADR)</rdfs:label>
        <rdfs:comment>National Regulatory Framework For Vehicle Compliance</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#EngineeringBrief">
        <rdfs:subClassOf rdf:resource="#Document"/>
        <rdfs:label>Engineering Brief</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#TechnicalSpecification">
        <rdfs:subClassOf rdf:resource="#EngineeringBrief"/>
        <rdfs:label>Technical Specification</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#TestReport">
        <rdfs:subClassOf rdf:resource="#EngineeringBrief"/>
        <rdfs:label>Test Report</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#DesignNote">
        <rdfs:subClassOf rdf:resource="#EngineeringBrief"/>
        <rdfs:label>Design Note</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#SimulationOutput">
        <rdfs:subClassOf rdf:resource="#EngineeringBrief"/>
        <rdfs:label>Simulation Output</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#EngineeringDrawing">
        <rdfs:subClassOf rdf:resource="#EngineeringBrief"/>
        <rdfs:label>Engineering Drawing</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Requirement">
        <rdfs:subClassOf rdf:resource="#Artifact"/>
        <rdfs:label>Requirement</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#InternalRequirement">
        <rdfs:subClassOf rdf:resource="#Requirement"/>
        <rdfs:label>Internal Requirement</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#ExternalRequirement">
        <rdfs:subClassOf rdf:resource="#Requirement"/>
        <rdfs:label>External Requirement</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#InternalEssentialRequirement">
        <rdfs:subClassOf rdf:resource="#InternalRequirement"/>
        <rdfs:label>Internal Essential Requirement</rdfs:label>
        <rdfs:comment>Non-Negotiable Internal Requirement Imposing Strict Constraints</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#InternalRecommendedRequirement">
        <rdfs:subClassOf rdf:resource="#InternalRequirement"/>
        <rdfs:label>Internal Recommended Requirement</rdfs:label>
        <rdfs:comment>Contextual Internal Requirement With Interpretative Flexibility</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ExternalEssentialRequirement">
        <rdfs:subClassOf rdf:resource="#ExternalRequirement"/>
        <rdfs:label>External Essential Requirement</rdfs:label>
        <rdfs:comment>Non-Negotiable External Requirement Imposing Strict Constraints</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ExternalRecommendedRequirement">
        <rdfs:subClassOf rdf:resource="#ExternalRequirement"/>
        <rdfs:label>External Recommended Requirement</rdfs:label>
        <rdfs:comment>Contextual External Requirement With Interpretative Flexibility</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Component">
        <rdfs:subClassOf rdf:resource="#Artifact"/>
        <rdfs:label>Component</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Subsystem">
        <rdfs:subClassOf rdf:resource="#Vehicle"/>
        <rdfs:label>Subsystem</rdfs:label>
        <rdfs:comment>Functional Unit Within A System (2+ Subsystems Make A System)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Interface">
        <rdfs:subClassOf rdf:resource="#Vehicle"/>
        <rdfs:label>Interface</rdfs:label>
        <rdfs:comment>Connection Point Enabling 2+ Projects To Work Together</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Project">
        <rdfs:subClassOf rdf:resource="#Vehicle"/>
        <rdfs:label>Project</rdfs:label>
        <rdfs:comment>Engineering Project With ID, Name, And Description (189 Concurrent Projects)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#VerificationProcedure">
        <rdfs:subClassOf rdf:resource="#Requirement"/>
        <rdfs:label>Verification Procedure</rdfs:label>
        <rdfs:comment>Detailed Procedure For Verifying ADR Compliance</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#VerificationMethod">
        <rdfs:subClassOf rdf:resource="#VerificationProcedure"/>
        <rdfs:label>Verification Method</rdfs:label>
        <rdfs:comment>Method Used To Verify Compliance With Requirements</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Inspection">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>Inspection</rdfs:label>
        <rdfs:comment>Visual Or Manual Inspection Verification Method</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Demonstration">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>Demonstration</rdfs:label>
        <rdfs:comment>Demonstration-Based Verification Method</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Test">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>Test</rdfs:label>
        <rdfs:comment>Physical Or Functional Test Verification Method</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Analysis">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>Analysis</rdfs:label>
        <rdfs:comment>Analytical Verification Including Simulations &amp; Calculations</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ADRAnnex">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>ADR Annex</rdfs:label>
        <rdfs:comment>Verification Through ADR Annex Procedures</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ADRTestingProcedure">
        <rdfs:subClassOf rdf:resource="#VerificationMethod"/>
        <rdfs:label>ADR Testing Procedure</rdfs:label>
        <rdfs:comment>Official ADR Testing Procedure Verification Method</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Evidence">
        <rdfs:subClassOf rdf:resource="#Component"/>
        <rdfs:label>Evidence</rdfs:label>
        <rdfs:comment>Evidence Supporting Verification Of Compliance, Formed When Multiple Components Work Together To Pass Testing Procedures</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#InspectionEvidence">
        <rdfs:subClassOf rdf:resource="#Evidence"/>
        <rdfs:label>Inspection Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through Visual Or Manual Inspection</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DemonstrationEvidence">
        <rdfs:subClassOf rdf:resource="#Evidence"/>
        <rdfs:label>Demonstration Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through Functional Demonstration</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TestEvidence">
        <rdfs:subClassOf rdf:resource="#Evidence"/>
        <rdfs:label>Test Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through Physical Or Functional Testing</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AnalysisEvidence">
        <rdfs:subClassOf rdf:resource="#Evidence"/>
        <rdfs:label>Analysis Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through Simulations &amp; Calculations (CFD, FEA, Etc.)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ADRAnnexEvidence">
        <rdfs:subClassOf rdf:resource="#Evidence"/>
        <rdfs:label>ADR Annex Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through ADR Annex Procedures</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ADRTestingProcedureEvidence">
        <rdfs:subClassOf rdf:resource="#Evidence"/>
        <rdfs:label>ADR Testing Procedure Evidence</rdfs:label>
        <rdfs:comment>Evidence Obtained Through Official ADR Testing Procedures</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Clause">
        <rdfs:subClassOf rdf:resource="#InternalEssentialRequirement"/>
        <rdfs:subClassOf rdf:resource="#InternalRecommendedRequirement"/>
        <rdfs:subClassOf rdf:resource="#ExternalEssentialRequirement"/>
        <rdfs:subClassOf rdf:resource="#ExternalRecommendedRequirement"/>
        <rdfs:label>Clause</rdfs:label>
        <rdfs:comment>Specific Clause Within An ADR (Each Clause Is A New Node Connected To 1 ADR)</rdfs:comment>
    </owl:Class>


    <!-- =============================================== -->
    <!-- OBJECT PROPERTIES (RELATIONSHIPS)               -->
    <!-- =============================================== -->

    <!-- Organizational Relationships -->
    <owl:ObjectProperty rdf:about="#hasDepartment">
        <rdfs:domain rdf:resource="#SunswiftRacing"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has department</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasPrimaryDepartment">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has primary department</rdfs:label>
        <rdfs:comment>Links A Project To Its Primary Responsible Department</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSecondaryDepartment">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has secondary department</rdfs:label>
        <rdfs:comment>Links A Project To Its Secondary Supporting Department</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasAssignee">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Member"/>
        <rdfs:label>has assignee</rdfs:label>
        <rdfs:comment>Links A Project To A Member (Project Assignee)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#collaboratesWith">
        <rdfs:domain rdf:resource="#Organization"/>
        <rdfs:range rdf:resource="#Organization"/>
        <rdfs:label>collaborates with</rdfs:label>
    </owl:ObjectProperty>

    <!-- Artifact Relationships -->
    <owl:ObjectProperty rdf:about="#hasRequirement">
        <rdfs:domain rdf:resource="#Artifact"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>has requirement</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasComponent">
        <rdfs:domain rdf:resource="#Subsystem"/>
        <rdfs:range rdf:resource="#Component"/>
        <rdfs:label>has component</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSubsystem">
        <rdfs:domain rdf:resource="#Vehicle"/>
        <rdfs:range rdf:resource="#Subsystem"/>
        <rdfs:label>has subsystem</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#interfacesWith">
        <rdfs:domain rdf:resource="#Subsystem"/>
        <rdfs:range rdf:resource="#Subsystem"/>
        <rdfs:label>interfaces with</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#dependsOn">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>depends on</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#appliesTo">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="#Artifact"/>
        <rdfs:label>applies to</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#derivedFrom">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="#AustralianDesignRule"/>
        <rdfs:label>derived from</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#documentedIn">
        <rdfs:domain rdf:resource="#Artifact"/>
        <rdfs:range rdf:resource="#Document"/>
        <rdfs:label>documented in</rdfs:label>
    </owl:ObjectProperty>

    <!-- Process Relationships -->
    <owl:ObjectProperty rdf:about="#hasInput">
        <rdfs:domain rdf:resource="#Process"/>
        <rdfs:range rdf:resource="#Artifact"/>
        <rdfs:label>has input</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasOutput">
        <rdfs:domain rdf:resource="#Process"/>
        <rdfs:range rdf:resource="#Artifact"/>
        <rdfs:label>has output</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#precedesProcess">
        <rdfs:domain rdf:resource="#Process"/>
        <rdfs:range rdf:resource="#Process"/>
        <rdfs:label>precedes process</rdfs:label>
    </owl:ObjectProperty>

    <!-- Compliance and Risk -->
    <owl:ObjectProperty rdf:about="#compliesWith">
        <rdfs:domain rdf:resource="#Artifact"/>
        <rdfs:range rdf:resource="#AustralianDesignRule"/>
        <rdfs:label>complies with</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasRisk">
        <rdfs:domain rdf:resource="#Artifact"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>has risk</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#propagatesRiskTo">
        <rdfs:domain rdf:resource="#Subsystem"/>
        <rdfs:range rdf:resource="#Subsystem"/>
        <rdfs:label>propagates risk to</rdfs:label>
    </owl:ObjectProperty>

    <!-- ADR Verification Relationships -->
    <owl:ObjectProperty rdf:about="#assignedToProject">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#Project"/>
        <rdfs:label>assigned to project</rdfs:label>
        <rdfs:comment>Links An ADR To One Or More Projects Responsible For Compliance</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasVerificationProcedure">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#VerificationProcedure"/>
        <rdfs:label>has verification procedure</rdfs:label>
        <rdfs:comment>Links An ADR To Its Verification Procedure</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasVerificationMethod">
        <rdfs:domain rdf:resource="#VerificationProcedure"/>
        <rdfs:range rdf:resource="#VerificationMethod"/>
        <rdfs:label>has verification method</rdfs:label>
        <rdfs:comment>Specifies The Method Used In A Verification Procedure</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#supportedByEvidence">
        <rdfs:domain rdf:resource="#VerificationProcedure"/>
        <rdfs:range rdf:resource="#Evidence"/>
        <rdfs:label>supported by evidence</rdfs:label>
        <rdfs:comment>Links Verification Procedure To Supporting Evidence</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#verifiedBy">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#Evidence"/>
        <rdfs:label>verified by</rdfs:label>
        <rdfs:comment>Direct Link From ADR To Verification Evidence</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#assignedToDepartment">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>assigned to department</rdfs:label>
        <rdfs:comment>Links An ADR To The Relevant Department</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasRelevantProject">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#Project"/>
        <rdfs:label>has relevant project</rdfs:label>
        <rdfs:comment>Links An ADR To Relevant Projects</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasRelevantDepartment">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has relevant department</rdfs:label>
        <rdfs:comment>Links An ADR To Relevant Departments</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasClause">
        <rdfs:domain rdf:resource="#AustralianDesignRule"/>
        <rdfs:range rdf:resource="#Clause"/>
        <rdfs:label>has clause</rdfs:label>
        <rdfs:comment>Links An ADR To Its Specific Clause References (Each Clause Is A New Node Connected To 1 ADR)</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Component Management Relationships -->
    <owl:ObjectProperty rdf:about="#usedInProject">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#Project"/>
        <rdfs:label>used in project</rdfs:label>
        <rdfs:comment>Links A Component To The Project(s) It Belongs To</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#usedInADR">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#AustralianDesignRule"/>
        <rdfs:label>used in ADR</rdfs:label>
        <rdfs:comment>Links A Component To ADRs It Helps Verify</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#generatesEvidence">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#Evidence"/>
        <rdfs:label>generates evidence</rdfs:label>
        <rdfs:comment>Links A Component To The Evidence It Generates For ADR Verification</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#suppliedBy">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#IndustryPartner"/>
        <rdfs:label>supplied by</rdfs:label>
        <rdfs:comment>Links A Component To Its Supplier Or Partner</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#partOfBOM">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#Component"/>
        <rdfs:label>part of BOM</rdfs:label>
        <rdfs:comment>Bill Of Materials Hierarchy - Component Is Part Of Another Component Assembly</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#belongsToDepartment">
        <rdfs:domain rdf:resource="#Component"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>belongs to department</rdfs:label>
        <rdfs:comment>Links A Component To Its Responsible Department</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSection">
        <rdfs:domain rdf:resource="#Department"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has section</rdfs:label>
        <rdfs:comment>Organizational Hierarchy - Department Has Sections</rdfs:comment>
    </owl:ObjectProperty>


    <!-- =============================================== -->
    <!-- DATA PROPERTIES (ATTRIBUTES)                    -->
    <!-- =============================================== -->

    <owl:DatatypeProperty rdf:about="#hasID">
        <rdfs:domain rdf:resource="#Artifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has ID</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasDescription">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has description</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasConfidenceScore">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>has confidence score</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasSource">
        <rdfs:domain rdf:resource="#Artifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has source</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasProvenance">
        <rdfs:domain rdf:resource="#Artifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has provenance</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#isEssential">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is essential</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasRiskLevel">
        <rdfs:domain rdf:resource="#Requirement"/>
