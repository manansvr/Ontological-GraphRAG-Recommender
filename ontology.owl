    <!-- =============================================== -->
    <!-- INDIVIDUALS (INSTANCES)                         -->
    <!-- =============================================== -->

    <!-- Organization Instances -->
    <owl:NamedIndividual rdf:about="#SunswiftRacingOrg">
        <rdf:type rdf:resource="#SunswiftRacing"/>
        <hasName>Sunswift Racing</hasName>
        <numberOfMembers rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80</numberOfMembers>
        <numberOfDepartments rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</numberOfDepartments>
        <numberOfProjects rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">189</numberOfProjects>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Neo4jPartner">
        <rdf:type rdf:resource="#IndustryPartner"/>
        <hasName>Neo4j</hasName>
        <hasDescription>Leading Native Graph Database Management System</hasDescription>
    </owl:NamedIndividual>

    <!-- Vehicle Instance -->
    <owl:NamedIndividual rdf:about="#SR8Vehicle">
        <rdf:type rdf:resource="#SR8"/>
        <hasName>Sunswift 8</hasName>
        <hasDescription>World's First Road-Legal, Student-Built, Tri-Brid Electric Vehicle</hasDescription>
        <isRoadLegal rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isRoadLegal>
        <numberOfComponents rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100000</numberOfComponents>
    </owl:NamedIndividual>

    <!-- Process Instances -->
    <owl:NamedIndividual rdf:about="#ExtractionProcess">
        <rdf:type rdf:resource="#KnowledgeExtraction"/>
        <hasName>Knowledge Extraction Pipeline</hasName>
        <hasDescription>Transforms Fragmented Regulatory &amp; Engineering Artifacts Into Structured Knowledge Graph</hasDescription>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#ExtensionProcess">
        <rdf:type rdf:resource="#KnowledgeExtension"/>
        <hasName>Knowledge Extension Pipeline</hasName>
        <hasDescription>Enriches Extracted Knowledge Through Automated Inference &amp; Reasoning</hasDescription>
    </owl:NamedIndividual>


    <!-- =============================================== -->
    <!-- AXIOMS AND CONSTRAINTS                          -->
    <!-- =============================================== -->

    <!-- Disjoint Classes -->
    <rdf:Description rdf:about="#InternalEssentialRequirement">
        <owl:disjointWith rdf:resource="#InternalRecommendedRequirement"/>
    </rdf:Description>

    <rdf:Description rdf:about="#ExternalEssentialRequirement">
        <owl:disjointWith rdf:resource="#ExternalRecommendedRequirement"/>
    </rdf:Description>

    <rdf:Description rdf:about="#InternalRequirement">
        <owl:disjointWith rdf:resource="#ExternalRequirement"/>
    </rdf:Description>

    <rdf:Description rdf:about="#KnowledgeExtraction">
        <owl:disjointWith rdf:resource="#KnowledgeExtension"/>
    </rdf:Description>

    <!-- Inverse Properties -->
    <owl:ObjectProperty rdf:about="#hasInput">
        <owl:inverseOf rdf:resource="#isInputTo"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#isInputTo">
        <rdfs:domain rdf:resource="#Artifact"/>
        <rdfs:range rdf:resource="#Process"/>
        <rdfs:label>is input to</rdfs:label>
    </owl:ObjectProperty>

    <!-- Transitive Properties -->
    <rdf:Description rdf:about="#dependsOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </rdf:Description>

    <rdf:Description rdf:about="#hasComponent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </rdf:Description>


</rdf:RDF>