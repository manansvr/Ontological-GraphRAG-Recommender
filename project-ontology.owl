    </owl:Class>
    
    <owl:Class rdf:about="#SpaCy">
        <rdfs:subClassOf rdf:resource="#NLPTool"/>
        <rdfs:label>SpaCy</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#NLTK">
        <rdfs:subClassOf rdf:resource="#NLPTool"/>
        <rdfs:label>NLTK</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#LanguageModel">
        <rdfs:subClassOf rdf:resource="#Technology"/>
        <rdfs:label>Language Model</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#LargeLanguageModel">
        <rdfs:subClassOf rdf:resource="#LanguageModel"/>
        <rdfs:label>Large Language Model (LLM)</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#TransformerModel">
        <rdfs:subClassOf rdf:resource="#LanguageModel"/>
        <rdfs:label>Transformer Model</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#BERT">
        <rdfs:subClassOf rdf:resource="#TransformerModel"/>
        <rdfs:label>BERT</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#RoBERTa">
        <rdfs:subClassOf rdf:resource="#TransformerModel"/>
        <rdfs:label>RoBERTa</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#QueryLanguage">
        <rdfs:subClassOf rdf:resource="#Technology"/>
        <rdfs:label>Query Language</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#Cypher">
        <rdfs:subClassOf rdf:resource="#QueryLanguage"/>
        <rdfs:label>Cypher</rdfs:label>
        <rdfs:comment>Neo4j's declarative graph query language</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#SemanticWeb">
        <rdfs:subClassOf rdf:resource="#Technology"/>
        <rdfs:label>Semantic Web Technology</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#OWL">
        <rdfs:subClassOf rdf:resource="#SemanticWeb"/>
        <rdfs:label>OWL (Web Ontology Language)</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#RDF">
        <rdfs:subClassOf rdf:resource="#SemanticWeb"/>
        <rdfs:label>RDF (Resource Description Framework)</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#DocumentParser">
        <rdfs:subClassOf rdf:resource="#Technology"/>
        <rdfs:label>Document Parser</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#PDFMiner">
        <rdfs:subClassOf rdf:resource="#DocumentParser"/>
        <rdfs:label>PDFMiner</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#Tesseract">
        <rdfs:subClassOf rdf:resource="#Technology"/>
        <rdfs:label>Tesseract OCR</rdfs:label>
    </owl:Class>
    
    
    <!-- =============================================== -->
    <!-- CONCEPT HIERARCHY                               -->
    <!-- =============================================== -->
    
    <owl:Class rdf:about="#Ontology">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Ontology</rdfs:label>
        <rdfs:comment>Formal representation of knowledge with concepts and relationships</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#SemanticModel">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Semantic Model</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#SystemsEngineering">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Systems Engineering</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#ModelBasedEngineering">
        <rdfs:subClassOf rdf:resource="#SystemsEngineering"/>
        <rdfs:label>Model-Based Engineering</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#SystemsOfSystems">
        <rdfs:subClassOf rdf:resource="#SystemsEngineering"/>
        <rdfs:label>Systems of Systems</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#RegulatoryCompliance">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Regulatory Compliance</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#Traceability">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Traceability</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#Explainability">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Explainability</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#Provenance">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Provenance</rdfs:label>
        <rdfs:comment>Origin and history of knowledge artifacts</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#NeuroSymbolicAI">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Neuro-Symbolic AI</rdfs:label>
        <rdfs:comment>Integration of neural and symbolic reasoning</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#RetrievalAugmentedGeneration">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Retrieval-Augmented Generation (RAG)</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#GraphEmbedding">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Graph Embedding</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#MultiAgentSystem">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Multi-Agent System</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="#ModelContextProtocol">
        <rdfs:subClassOf rdf:resource="#Concept"/>
        <rdfs:label>Model Context Protocol (MCP)</rdfs:label>
        <rdfs:comment>Orchestration layer for coordinating multi-agent workflows</rdfs:comment>
    </owl:Class>
    
    
    <!-- =============================================== -->
    <!-- AGENT HIERARCHY                                 -->
    <!-- =============================================== -->
    
    <owl:Class rdf:about="#LLMAgent">
        <rdfs:subClassOf rdf:resource="#Agent"/>
        <rdfs:label>LLM Inference Agent</rdfs:label>
        <rdfs:comment>Agent for linguistic nuance and contextual reasoning</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#LinkPredictionAgent">
        <rdfs:subClassOf rdf:resource="#Agent"/>
        <rdfs:label>Link Prediction Agent</rdfs:label>
        <rdfs:comment>Agent for detecting latent relational patterns</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#RLAgent">
        <rdfs:subClassOf rdf:resource="#Agent"/>
        <rdfs:label>Reinforcement Learning Agent</rdfs:label>
        <rdfs:comment>Agent for requirement prioritization and classification</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#ValidationAgent">
        <rdfs:subClassOf rdf:resource="#Agent"/>
        <rdfs:label>Validation Agent</rdfs:label>
        <rdfs:comment>Agent for consistency checking and ontology alignment</rdfs:comment>
    </owl:Class>
    
    
    <!-- =============================================== -->
    <!-- OBJECT PROPERTIES (RELATIONSHIPS)               -->
    <!-- =============================================== -->
    
    <!-- Organizational Relationships -->
    <owl:ObjectProperty rdf:about="#hasDepartment">
        <rdfs:domain rdf:resource="#SunswiftRacing"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has department</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#hasPrimaryDepartment">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has primary department</rdfs:label>
        <rdfs:comment>Links a project to its primary responsible department</rdfs:comment>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#hasSecondaryDepartment">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label>has secondary department</rdfs:label>
        <rdfs:comment>Links a project to its secondary supporting department</rdfs:comment>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#hasAssignee">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Member"/>
        <rdfs:label>has assignee</rdfs:label>
        <rdfs:comment>Links a project to a member (project assignee)</rdfs:comment>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#collaboratesWith">
        <rdfs:domain rdf:resource="#Organization"/>
        <rdfs:range rdf:resource="#Organization"/>
        <rdfs:label>collaborates with</rdfs:label>
    </owl:ObjectProperty>
    
    <!-- Artifact Relationships -->
    <owl:ObjectProperty rdf:about="#hasRequirement">
        <rdfs:domain rdf:resource="#Artifact"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>has requirement</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#hasComponent">
        <rdfs:domain rdf:resource="#Subsystem"/>
        <rdfs:range rdf:resource="#Component"/>
        <rdfs:label>has component</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#hasSubsystem">
        <rdfs:domain rdf:resource="#Vehicle"/>
        <rdfs:range rdf:resource="#Subsystem"/>
        <rdfs:label>has subsystem</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#interfacesWith">
        <rdfs:domain rdf:resource="#Subsystem"/>
        <rdfs:range rdf:resource="#Subsystem"/>
        <rdfs:label>interfaces with</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#dependsOn">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="#Requirement"/>
        <rdfs:label>depends on</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#appliesTo">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="#Artifact"/>
        <rdfs:label>applies to</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#derivedFrom">
        <rdfs:domain rdf:resource="#Requirement"/>
        <rdfs:range rdf:resource="#AustralianDesignRule"/>
        <rdfs:label>derived from</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#documentedIn">
        <rdfs:domain rdf:resource="#Artifact"/>
        <rdfs:range rdf:resource="#Document"/>
        <rdfs:label>documented in</rdfs:label>
    </owl:ObjectProperty>
    
    <!-- Process Relationships -->
    <owl:ObjectProperty rdf:about="#hasInput">
        <rdfs:domain rdf:resource="#Process"/>
        <rdfs:range rdf:resource="#Artifact"/>
        <rdfs:label>has input</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#hasOutput">
        <rdfs:domain rdf:resource="#Process"/>
        <rdfs:range rdf:resource="#Artifact"/>
        <rdfs:label>has output</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#uses">
        <rdfs:domain rdf:resource="#Process"/>
        <rdfs:range rdf:resource="#Technology"/>
        <rdfs:label>uses</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#employs">
        <rdfs:domain rdf:resource="#Process"/>
        <rdfs:range rdf:resource="#Agent"/>
        <rdfs:label>employs</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#precedesProcess">
        <rdfs:domain rdf:resource="#Process"/>
        <rdfs:range rdf:resource="#Process"/>
        <rdfs:label>precedes process</rdfs:label>
