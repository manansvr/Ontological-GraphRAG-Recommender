# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
STRICT_CONTEXT_ONLY=true
REQUIRE_EXPLICIT_CITATIONS=true

# Neo4j settings (same DB used by your extraction scripts)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Workspace roots to index for local document search (comma-separated absolute paths)
DOC_ROOTS=/Users/manan/Desktop/Honours/thesis-extraction/CSV,/Users/manan/Desktop/Honours/thesis-extraction/Design-Documentation,/Users/manan/Desktop/Honours/thesis-extraction/PDF,/Users/manan/Desktop/Honours/thesis-extraction/Documentation,/Users/manan/Desktop/Honours/thesis-ontology/Documentation

# Extraction pipeline location
EXTRACTION_ROOT=/Users/manan/Desktop/Honours/thesis-extraction

# OCR fallback for scanned PDFs (requires system tools: tesseract + poppler)
OCR_ENABLED=true
OCR_DPI=200
