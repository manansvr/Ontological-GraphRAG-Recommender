# Copy this file to .env and fill in your values.
# This system uses Ollama exclusively for LLM inference — no cloud API keys required.

# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Ollama local LLM server
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Local document roots (comma-separated absolute paths).
# Leave empty to use the default relative paths derived from the repository layout.
DOC_ROOTS=

# Path to the thesis-extraction directory.
# Leave empty to use the default relative path (../../thesis-extraction from this file).
EXTRACTION_ROOT=

# OCR fallback for scanned PDFs (requires tesseract + poppler installed on the system).
OCR_ENABLED=true
OCR_DPI=200
