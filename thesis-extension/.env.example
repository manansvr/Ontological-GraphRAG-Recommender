# Copy this file to .env (git-ignored) and fill in your values. Never commit .env.
# This system uses Ollama for LLM inference; no cloud API keys are required.
# Values shown are the code defaults unless marked otherwise.

# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password      # placeholder; set your own

# Ollama
OLLAMA_BASE_URL=http://localhost:11434               # used by ollama-mcp (and test_recommender.py)
OLLAMA_MODEL=qwen2.5:14b-instruct                    # model the chat client and experiments use

# Answer policy (ollama-mcp)
STRICT_CONTEXT_ONLY=true                             # no tool output this turn -> "not enough context" fallback
REQUIRE_EXPLICIT_CITATIONS=false                     # true: uncited answers get evidence appended or the fallback (also hits graph-only answers)

# Reinforcement learning
RL_ENABLED=true                                      # false: ollama-mcp chooses no retrieval strategy and learns nothing
RL_LEARNING=true                                     # false: use the learned policies greedily; never update or save the model
RETRIEVAL_STRATEGY=rl                                # rl | graph_first | documents_first | hybrid (fixes the adr_lookup strategy for experiments)
RL_MODEL_PATH=.rl-model.json                         # relative paths resolve against thesis-extension/ (shared by sr8-mcp and ollama-mcp)

# Local document roots (comma-separated absolute paths). Empty: thesis-extraction/{csv,
# Design-Documentation,PDF,Documentation} and thesis-ontology/Documentation in this repository.
DOC_ROOTS=

# Path to the thesis-extraction directory. Empty: ../thesis-extraction next to thesis-extension/.
EXTRACTION_ROOT=

# OCR fallback for scanned PDFs (requires tesseract + poppler installed on the system).
OCR_ENABLED=true
OCR_DPI=200
