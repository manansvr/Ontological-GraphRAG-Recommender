# Tools that produce their own document-based citations (or aren't graph
# queries at all). Anything outside this set that returns real data from
# Neo4j is treated as a valid, honestly-labelled evidence source below.
_DOCUMENT_TOOLS = {
    "search_local_documents",
    "suggest_requirement_sources",
    "read_document",
    "summarize_document",
    "list_documents",
    "run_extraction_for_requirements",
    "extraction_report",
}


def _extract_evidence_refs(tool_text: str, max_refs: int = 3, tool_name: str = "") -> list[str]:
    refs: list[str] = []
    try:
        obj = json.loads(tool_text)
    except Exception:
        return refs

    matches = obj.get("matches", []) if isinstance(obj, dict) else []
    for m in matches:
        path = m.get("path", "")
        pointer_type = m.get("pointer_type", "")
        hits = m.get("hits", [])
        if not path or not hits:
            continue
        hit0 = hits[0] if isinstance(hits[0], dict) else {}
        if pointer_type == "row" and "row" in hit0:
            refs.append(f"{path} | row {hit0['row']}")
        elif pointer_type == "line" and "line" in hit0:
            refs.append(f"{path} | line {hit0['line']}")
        if len(refs) >= max_refs:
            break

    if refs:
        return refs

    # get_adr_requirements can provide explicit evidence references.
    if isinstance(obj, dict) and isinstance(obj.get("evidence_refs"), list):
        for ref in obj.get("evidence_refs", []):
            if isinstance(ref, str) and ref.strip():
                refs.append(ref.strip())
            if len(refs) >= max_refs:
                break

    if refs:
        return refs

    # Fallback for read_document output
    if isinstance(obj, dict) and "path" in obj and ("start_line" in obj or "line" in obj):
        path = obj.get("path", "")
        line = obj.get("start_line", obj.get("line", ""))
        if path and line:
            refs.append(f"{path} | line {line}")

    if refs:
        return refs

    # Graph tools (list_all_projects, get_project, get_compliance_gaps, ...)
    # return live Neo4j data with no file to cite. That's still grounded,
    # real evidence — just not a document — so label it honestly rather
    # than blocking the answer for lack of a page/line reference.
    if (
        tool_name
        and tool_name not in _DOCUMENT_TOOLS
        and isinstance(obj, dict)
        and "error" not in obj
        and any(v not in (None, "", [], {}) for v in obj.values())
    ):
        refs.append(f"Neo4j knowledge graph | {tool_name}()")

    return refs[:max_refs]


def _extract_rule_id_from_question(text: str) -> str | None:
    m = re.search(r"\b(?:ADR|SRP)[\s_-]?0*\d{1,3}\b", text, flags=re.IGNORECASE)
    if not m:
        return None
    return m.group(0).replace(" ", "")


def _is_count_requirements_question(text: str) -> bool:
    t = text.lower()
    if "requir" not in t:
        return False
    # "how many requirements..." always qualifies; any other requirements
    # question that names a rule ID ("what does ADR-43 require?", "list the
    # requirements for ADR-43") also gets routed to the deterministic
    # get_adr_requirements formatter below, rather than asking the model to
    # read a ~30KB raw JSON dump and answer from it directly.
    return "how many" in t or _extract_rule_id_from_question(text) is not None


def _is_reference_question(text: str) -> bool:
    t = text.lower()
    return "reference" in t and _extract_rule_id_from_question(text) is not None


def _is_design_guidance_question(text: str) -> bool:
    t = text.lower()
    return any(
        keyword in t
        for keyword in [
            "design",
            "manufactur",
            "fabricat",
            "assembly",
            "build",
            "prototype",
            "conceptual",
            "preliminary",
            "detailed",
            "procure",
            "quality control",
        ]
    )


def _looks_like_compliance_or_graph_question(text: str) -> bool:
    # "assembly" is ambiguous in this domain: it names a manufacturing process
    # AND a graph entity type (e.g. ASM-FRONT-AXLE). If the question is
    # clearly asking about graph/compliance data, don't let a bare "assembly"
    # keyword misroute it to the manufacturing-document redirect below.
    if re.search(r"\bASM[-_]?[\w-]+\b", text, flags=re.IGNORECASE):
        return True
    t = text.lower()
    return any(
        kw in t
        for kw in [
            "compliance",
            "gap",
            "requirement",
            "risk",
            "verif",
            "interface",
            "unassigned",
            "unverified",
        ]
    )


def _design_guidance_redirect(text: str) -> dict[str, str] | None:
    if _looks_like_compliance_or_graph_question(text):
        return None
    t = text.lower()
    if any(keyword in t for keyword in ["manufactur", "fabricat", "assembly", "procure", "quality control", "build"]):
        return {
            "query": "Manufacturing Section",
            "redirect": "For the detailed manufacturing checklist, see [Manufacturing Section.pdf](/Users/manan/Desktop/Honours/thesis-extraction/Design-Documentation/Manufacturing%20Section.pdf#L1) (Manufacturing).",
        }

    if _is_design_guidance_question(text):
        return {
            "query": "The Design Process",
            "redirect": "For the broader design workflow, see [Design Manual.pdf](/Users/manan/Desktop/Honours/thesis-extraction/Design-Documentation/Design%20Manual.pdf#L111) (The Design Process).",
        }

    return None


