def _format_compliance_gaps(payload: dict[str, Any]) -> str:
    total = payload.get("total_gaps", 0)
    filt = payload.get("filter", {})
    scope_bits = [f"{k}={v}" for k, v in filt.items() if v]
    scope = f" ({', '.join(scope_bits)})" if scope_bits else ""
    lines = [f"{total} compliance gap(s) found{scope}."]

    by_project = payload.get("by_project", {})
    for pid, info in by_project.items():
        lines.append(f"\n{pid} — {info.get('project_name', '')}:")
        for gap in info.get("gaps", []):
            lines.append(
                f"- {gap.get('adr_id')} / {gap.get('req_id')}: {gap.get('req_name')} ({gap.get('risk_level')} risk)"
            )

    unassigned = payload.get("unassigned_gaps", [])
    if unassigned:
        lines.append("\nUnassigned:")
        for gap in unassigned:
            lines.append(
                f"- {gap.get('adr_id')} / {gap.get('req_id')}: {gap.get('req_name')} ({gap.get('risk_level')} risk)"
            )

    lines.append("")
    lines.append("Evidence: Neo4j knowledge graph | get_compliance_gaps()")
    return "\n".join(lines)


