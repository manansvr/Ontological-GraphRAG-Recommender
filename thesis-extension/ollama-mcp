        f"Feedback recorded: {payload.get('action')} for {payload.get('requirement_id')} -> "
        f"{payload.get('project_id')}.",
        f"Reward applied: {payload.get('reward_applied')}",
    ]
    if payload.get("overconfidence_penalty_applied"):
        lines.append(
            "Overconfidence penalty applied automatically (stored confidence was > 0.8 and the "
            "suggestion was rejected)."
        )
    lines.append(f"Inference state: {payload.get('inference_state')}")
    lines.append("")
    lines.append("Evidence: Neo4j knowledge graph | record_feedback()")
    return "\n".join(lines)


