def _format_project_suggestion(
    req_id: str,
    project_id: str,
    base_confidence: float,
    reasoning: str,
    write_payload: dict[str, Any],
    vote_counts: dict[str, int],
    total_n: int,
) -> str:
    lines = [f"Suggested project for {req_id}: {project_id}"]
    lines.append(f"Reasoning: {reasoning}")
    vote_str = ", ".join(f"{pid} ({n}/{total_n})" for pid, n in sorted(vote_counts.items(), key=lambda x: -x[1]))
    lines.append(f"Vote breakdown across similar requirements: {vote_str}")
    lines.append("")

    if "error" in write_payload:
        lines.append(f"Could not write the inferred link: {write_payload['error']}")
    else:
        original = write_payload.get("original_confidence", base_confidence)
        adjusted = write_payload.get("adjusted_confidence")
        state = write_payload.get("inference_state", "")
        lines.append(f"Base confidence (from similarity vote): {original}")
        if adjusted is not None:
            lines.append(f"RL-adjusted confidence: {adjusted} (inference state: {state})")
        lines.append(f"Written to the graph as a suggestedProject relationship ({req_id} -> {project_id}).")

    lines.append("")
    lines.append("Evidence: Neo4j knowledge graph | get_similar_assigned_requirements() + write_inferred_project_link()")
    return "\n".join(lines)


