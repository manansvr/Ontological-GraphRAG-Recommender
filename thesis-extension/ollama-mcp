def _is_design_guidance_question(text: str) -> bool:
    t = text.lower()
    return any(keyword in t for keyword in _DESIGN_KEYWORDS + _MANUFACTURING_KEYWORDS)


REPO_ROOT = EXTENSION_DIR.parent
GUIDANCE_DOCS_DIR = REPO_ROOT / "thesis-extraction" / "Design-Documentation"


def _guidance_doc_path(filename: str) -> Path:
    """Where a design-guidance PDF lives: the first DOC_ROOTS entry (comma-separated) that
    holds the file directly or in a Design-Documentation subfolder, otherwise
    thesis-extraction/Design-Documentation/ in this repository."""
    for chunk in os.getenv("DOC_ROOTS", "").split(","):
        if not chunk.strip():
            continue
        root = Path(chunk.strip()).expanduser()
        for candidate in (root / filename, root / "Design-Documentation" / filename):
            if candidate.is_file():
                return candidate.resolve()
    return GUIDANCE_DOCS_DIR / filename


def _guidance_link(filename: str, line: int) -> str:
    """Markdown link target for a guidance PDF: URL-quoted absolute path plus #L<line>."""
    return f"{quote(_guidance_doc_path(filename).as_posix())}#L{line}"


def _design_guidance_redirect(text: str) -> dict[str, str] | None:
    t = text.lower()
    if any(keyword in t for keyword in _MANUFACTURING_KEYWORDS):
        return {
            "query": "Manufacturing Section",
            "redirect": "For the detailed manufacturing checklist, see "
                        f"[Manufacturing Section.pdf]({_guidance_link('Manufacturing Section.pdf', 1)}) (Manufacturing).",
        }

    if _is_design_guidance_question(text):
        return {
            "query": "The Design Process",
            "redirect": "For the broader design workflow, see "
                        f"[Design Manual.pdf]({_guidance_link('Design Manual.pdf', 111)}) (The Design Process).",
        }

    return None


