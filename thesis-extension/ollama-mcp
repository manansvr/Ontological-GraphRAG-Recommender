def _extract_feedback_action(text: str) -> str | None:
    t = text.lower()
    if "reject" in t:
        return "rejected"
    if "confirm" in t or "accept" in t:
        return "confirmed"
    if "modify" in t or "modified" in t:
        return "modified"
    if "ignore" in t:
        return "ignored"
    return None


