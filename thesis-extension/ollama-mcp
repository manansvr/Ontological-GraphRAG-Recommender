def _format_inferred_links(payload: dict[str, Any]) -> str:
    count = payload.get("inferred_link_count", 0)
    links = payload.get("inferred_links", [])
    lines = [f"{count} inferred link(s) found."]
    for link in links:
        rec = "recommended" if link.get("recommended") else "not recommended"
        warn = f" — {link.get('warning')}" if link.get("warning") else ""
        lines.append(
            f"- {link.get('req_id')} -> {link.get('project_id')} ({link.get('project_name')}): "
            f"confidence {link.get('confidence')}, {rec}{warn}"
        )
        if link.get("reasoning"):
            lines.append(f"    reasoning: {link.get('reasoning')}")
    lines.append("")
    lines.append("Evidence: Neo4j knowledge graph | get_inferred_links()")
    return "\n".join(lines)


