def _require_explicit_citations() -> bool:
    """REQUIRE_EXPLICIT_CITATIONS (default false). When true, an answer without a file citation
    gets the tools' evidence appended, or the fallback if there is none, which also replaces
    answers from graph-only tools such as list_all_projects or get_rl_policy (no file to cite).
    The Problem A reward measures the model's own citations either way."""
    return os.getenv("REQUIRE_EXPLICIT_CITATIONS", "false").lower() == "true"


def _has_explicit_citation(text: str) -> bool:
    return bool(re.search(r"(/[^\s]+\.(csv|md|txt|pdf|docx))(?:\s*\|\s*(row|line)\s*\d+)", text, flags=re.IGNORECASE))


def _extract_evidence_refs(tool_text: str, max_refs: int = 3) -> list[str]:
    refs: list[str] = []
    try:
        obj = json.loads(tool_text)
    except Exception:
        return refs

    matches = obj.get("matches", []) if isinstance(obj, dict) else []
    for m in matches:
        path = m.get("path", "")
        pointer_type = m.get("pointer_type", "")
        hits = m.get("hits", [])
        if not path or not hits:
            continue
        hit0 = hits[0] if isinstance(hits[0], dict) else {}
        if pointer_type == "row" and "row" in hit0:
            refs.append(f"{path} | row {hit0['row']}")
        elif pointer_type == "line" and "line" in hit0:
            refs.append(f"{path} | line {hit0['line']}")
        if len(refs) >= max_refs:
            break

    if refs:
        return refs

    # get_adr_requirements can provide explicit evidence references.
    if isinstance(obj, dict) and isinstance(obj.get("evidence_refs"), list):
        for ref in obj.get("evidence_refs", []):
            if isinstance(ref, str) and ref.strip():
                refs.append(ref.strip())
            if len(refs) >= max_refs:
                break

    if refs:
        return refs

    # Fallback for read_document output
    if isinstance(obj, dict) and "path" in obj and ("start_line" in obj or "line" in obj):
        path = obj.get("path", "")
        line = obj.get("start_line", obj.get("line", ""))
        if path and line:
            refs.append(f"{path} | line {line}")

    return refs[:max_refs]


def _extract_rule_id_from_question(text: str) -> str | None:
    m = re.search(r"\b(?:ADR|SRP)[\s_-]?0*\d{1,3}\b", text, flags=re.IGNORECASE)
    if not m:
        return None
    return m.group(0).replace(" ", "")


# Typed review commands. These are parsed only from what the user types at the
# "You:" prompt and call sr8-mcp's review functions in-process. The functions are not
# MCP tools, so a model tool call can never reach them.
_CONFIRM_LINK_RE = re.compile(r"^\s*confirm\s+link\s+(\S+)\s*->\s*(\S+)\s*$", re.IGNORECASE)
_REJECT_LINK_RE = re.compile(r"^\s*reject\s+link\s+(\S+)\s*->\s*(\S+)\s+because\s+(.*\S)\s*$", re.IGNORECASE)
_REVIEW_PREFIX_RE = re.compile(r"^\s*(confirm|reject)\s+link\b", re.IGNORECASE)
REVIEW_USAGE = (
    "Review commands:\n"
    "  confirm link <REQ> -> <PROJECT>\n"
    "  reject link <REQ> -> <PROJECT> because <reason>"
)

_review_module: Any = None


def _parse_review_command(text: str) -> dict[str, str] | None:
    """Return the parsed review command, {'kind': 'usage'} for a malformed one, or None."""
    m = _CONFIRM_LINK_RE.match(text)
    if m:
        return {"kind": "confirm", "requirement_id": m.group(1), "project_id": m.group(2)}
    m = _REJECT_LINK_RE.match(text)
    if m:
        return {"kind": "reject", "requirement_id": m.group(1), "project_id": m.group(2), "reason": m.group(3)}
    if _REVIEW_PREFIX_RE.match(text):
        return {"kind": "usage"}
    return None


def _load_review_module() -> Any:
    """Import sr8-mcp in-process (without starting its server) to reach the review functions."""
    global _review_module
    if _review_module is None:
        module_path = Path(__file__).resolve().with_name("sr8-mcp")
        loader = importlib.machinery.SourceFileLoader("sr8_mcp_review", str(module_path))
        spec = importlib.util.spec_from_loader("sr8_mcp_review", loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        _review_module = module
    return _review_module


def _run_review_command(command: dict[str, str], reviewer: str) -> str:
    """Call the sr8-mcp review function for a parsed command and return a printable summary."""
    module = _load_review_module()
    if command["kind"] == "confirm":
        raw = module.promote_inferred_link(command["requirement_id"], command["project_id"], reviewer)
    else:
        raw = module.reject_inferred_link(
            command["requirement_id"], command["project_id"], reviewer, command["reason"],
        )
    out = json.loads(raw)
    if "error" in out:
        lines = [f"Not recorded: {out['error']}"]
        if out.get("previous_decision"):
            lines.append(f"Earlier decision: {json.dumps(out['previous_decision'])}")
        return "\n".join(lines)
    feedback = out.get("feedback", {})
    note = " (link already existed; left unchanged)" if out.get("already_assigned") else ""
    return (
        f"{out['status'].capitalize()} {out['req_id']} -> {out['project_id']} as {reviewer}{note}; "
        f"reward {feedback.get('reward_applied')}"
        f"{' (overconfidence penalty)' if feedback.get('overconfidence_penalty_applied') else ''}."
    )


