    lines.append(f"- Must re-verify (already verified, needs re-check): {payload.get('must_reverify_count', 0)}")
    lines.append(f"- Must verify (not yet verified): {payload.get('must_verify_count', 0)}")
    lines.append(f"- Not affected: {payload.get('not_affected_count', 0)}")

    scope = payload.get("scope", {})
    for cat_key, label in [("must_reverify", "Must re-verify"), ("must_verify", "Must verify")]:
        items = scope.get(cat_key, [])
        if items:
            lines.append(f"\n{label}:")
            for item in items[:15]:
                lines.append(f"- {item.get('req_id')}: {item.get('req_name')} (ADR {item.get('adr_id')})")
            if len(items) > 15:
                lines.append(f"...and {len(items) - 15} more.")

    lines.append("")
    lines.append("Evidence: Neo4j knowledge graph | get_reverification_scope()")
    return "\n".join(lines)


