def _format_cross_assembly_and_interface_risk(cross_payload: dict[str, Any], risk_payload: dict[str, Any]) -> str:
    # get_cross_assembly_requirements() and get_interface_risk_report() both
    # return moderately large nested JSON. Asking the model to read and
    # summarise both at once (especially deep into a multi-turn conversation
    # with several earlier large tool results still in context) is exactly
    # the kind of synthesis task an 8B local model gets wrong -- it tends to
    # reuse or garble numbers from a previous turn instead. Format directly
    # from the real payload instead so every number here is exact.
    cross = cross_payload.get("cross_assembly_adrs", [])
    lines = [f"{len(cross)} ADR(s) have requirements spanning more than one assembly:"]
    for item in cross:
        assemblies = ", ".join(item.get("affected_assemblies", []))
        lines.append(
            f"- {item.get('adr_id')}: {item.get('total_requirements')} requirements across "
            f"{item.get('assembly_count')} assemblies ({assemblies})"
        )

    interfaces = risk_payload.get("interfaces", [])
    total_shared = sum(x.get("total_shared", 0) for x in interfaces)
    total_unverified = sum(x.get("unverified_count", 0) for x in interfaces)

    lines.append("")
    lines.append(
        f"Interface risk: {risk_payload.get('total_interface_pairs', len(interfaces))} assembly-pair "
        f"interface(s), {risk_payload.get('risk_count', 0)} flagged at risk. "
        f"{total_shared} shared requirements total, {total_unverified} unverified."
    )
    for x in interfaces:
        lines.append(
            f"- {x.get('assembly_a')} <-> {x.get('assembly_b')} ({x.get('adr_id')}): "
            f"{x.get('total_shared')} shared, {x.get('unverified_count')} unverified — {x.get('risk_flag')}"
        )

    lines.append("")
    lines.append("Evidence: Neo4j knowledge graph | get_cross_assembly_requirements() + get_interface_risk_report()")
    return "\n".join(lines)


def _tool_to_ollama_schema(tool: Any) -> dict[str, Any]:
    schema = tool.inputSchema if hasattr(tool, "inputSchema") else {}
    return {
        "type": "function",
        "function": {
            "name": tool.name,
            "description": tool.description or "MCP tool",
            "parameters": schema if schema else {"type": "object", "properties": {}},
        },
    }


OLLAMA_NUM_CTX = int(os.getenv("OLLAMA_NUM_CTX", "8192"))


def _post_chat(model: str, messages: list[dict[str, Any]], tools: list[dict[str, Any]]) -> dict[str, Any]:
    response = requests.post(
        f"{_ollama_base_url().rstrip('/')}/api/chat",
        json={
            "model": model,
            "messages": messages,
            "tools": tools,
            "stream": False,
            "options": {"temperature": 0.2, "num_ctx": OLLAMA_NUM_CTX},
        },
        timeout=180,
    )
    response.raise_for_status()
    return response.json()


async def run_chat(model: str, server_command: str, server_args: list[str]) -> None:
    server_params = StdioServerParameters(command=server_command, args=server_args)

    async with stdio_client(server_params) as (reader, writer):
        async with ClientSession(reader, writer) as session:
            await session.initialize()
            tool_list = await session.list_tools()
            tools = [_tool_to_ollama_schema(t) for t in tool_list.tools]

            system_prompt = (
                "You are connected to MCP tools for local SR8 documents and a Neo4j knowledge graph. "
                "You must answer only from MCP tool context returned in this chat session. "
                "If the context is missing, insufficient, or ambiguous, do not guess. "
                "Instead say: 'I do not have enough context in the indexed sources to answer that.' "
                "For factual questions, call tools first. "
                "If a document search does not directly answer the question, do not give up — call the "
                "relevant knowledge-graph tool instead (e.g. list_all_projects, list_all_adrs, get_project, "
                "get_adr, get_assembly, get_compliance_gaps, get_unassigned_requirements, "
                "get_interface_risk_report, get_inferred_links, promote_inferred_link, record_feedback, "
                "get_feedback_stats, get_rl_policy). Pick the tool that actually matches the question rather "
                "than defaulting to whichever example is most familiar. Live Neo4j graph data is valid "
                "evidence, not just document text. "
                "If the user asks about design or manufacturing, answer from the indexed documents and then append the relevant redirect to the Design Manual or Manufacturing Section."
            )

            messages: list[dict[str, Any]] = [{"role": "system", "content": system_prompt}]
            rl_bridge = _RLBridge()
            # Tracks the most recent (requirement_id, project_id) written by the
            # suggest-project path, so "reject/confirm that suggestion" can resolve
            # the pronoun deterministically instead of asking the model to recall
            # it from conversation history.
            last_suggested_link: tuple[str, str] | None = None

            print("Connected. Type your prompt, or /exit to quit.")
            print(f"Model: {model}")
            print("Tools:")
            for t in tool_list.tools:
                print(f"  - {t.name}")

            while True:
                user_input = input("\nYou: ").strip()
                if not user_input:
                    continue
                if user_input.lower() in {"/exit", "exit", "quit"}:
                    break

                # Deterministic path for re-verification-scope (change impact) questions.
                # Must run before the count-requirements check below: "SRP8-045" (a
                # project ID) is spuriously matched by _extract_rule_id_from_question's
                # SRP-prefix pattern as if it were a rule ID, which would otherwise
                # steal any question containing both "requir..." and an SRP8-x project ID.
                if _is_reverification_question(user_input):
                    reverif_project_ids = _extract_project_ids_from_question(user_input)
                    if reverif_project_ids:
                        print(f"\n[tool] get_reverification_scope({{'project_ids': {reverif_project_ids}}})")
                        reverif_result = await session.call_tool(
                            "get_reverification_scope", {"project_ids": reverif_project_ids}
                        )
                        reverif_text = "\n".join(
                            getattr(p, "text", "") for p in reverif_result.content if getattr(p, "text", None)
                        ) or "{}"
                        try:
                            reverif_payload = json.loads(reverif_text)
                        except Exception:
                            reverif_payload = {
                                "project_ids_in_scope": reverif_project_ids,
                                "must_reverify_count": 0,
                                "must_verify_count": 0,
                                "not_affected_count": 0,
                                "scope": {},
                            }

                        content = _format_reverification_scope(reverif_payload)
                        print(f"\nAssistant: {content}")
                        messages.append({"role": "user", "content": user_input})
                        messages.append({"role": "assistant", "content": content})
                        continue

                # Deterministic path for count+list requirement questions by ADR/SRP ID.
                if _is_count_requirements_question(user_input):
                    rule_id = _extract_rule_id_from_question(user_input)
                    if rule_id:
                        print(f"\n[tool] get_adr_requirements({{'adr_id': '{rule_id}', 'limit': {GRAPH_LIMIT}}})")
                        tool_result = await session.call_tool("get_adr_requirements", {"adr_id": rule_id, "limit": GRAPH_LIMIT})

                        tool_text_parts: list[str] = []
                        for part in tool_result.content:
                            text = getattr(part, "text", None)
                            if text:
                                tool_text_parts.append(text)
                        tool_text = "\n".join(tool_text_parts) if tool_text_parts else "{}"

                        try:
                            payload = json.loads(tool_text)
                        except Exception:
                            payload = {"adr_id": rule_id, "count": 0, "requirements": [], "evidence_refs": []}

                        content = _format_requirements_listing(payload)
                        print(f"\nAssistant: {content}")
                        messages.append({"role": "user", "content": user_input})
                        messages.append({"role": "assistant", "content": content})
                        continue

                # Deterministic path for compliance-gap questions that name an
                # assembly or ADR explicitly. Left to the model, this parameter
                # gets contaminated by whatever ADR/assembly was discussed in a
                # recent prior turn (observed: reused "ADR-43" from the previous
                # question instead of the "ASM-FRONT-AXLE" named in this one).
                if _is_compliance_gap_question(user_input):
                    assembly_id = _extract_assembly_id_from_question(user_input)
                    gap_rule_id = _extract_rule_id_from_question(user_input)
                    if assembly_id or gap_rule_id:
                        gap_kwargs: dict[str, Any] = {}
                        if assembly_id:
                            gap_kwargs["assembly_id"] = assembly_id
                        elif gap_rule_id:
                            gap_kwargs["adr_id"] = gap_rule_id
                        print(f"\n[tool] get_compliance_gaps({gap_kwargs})")
                        gap_result = await session.call_tool("get_compliance_gaps", gap_kwargs)
                        gap_text = "\n".join(
                            getattr(p, "text", "") for p in gap_result.content if getattr(p, "text", None)
                        ) or "{}"
                        try:
                            gap_payload = json.loads(gap_text)
                        except Exception:
                            gap_payload = {"total_gaps": 0, "by_project": {}, "unassigned_gaps": [], "filter": gap_kwargs}

                        content = _format_compliance_gaps(gap_payload)
                        print(f"\nAssistant: {content}")
                        messages.append({"role": "user", "content": user_input})
                        messages.append({"role": "assistant", "content": content})
                        continue

                # Deterministic path for "suggest a project for REQ-x-y" questions.
                # Left to the model, this skipped write_inferred_project_link entirely
                # (the tool that actually runs the RL agent and writes the graph
                # relationship) and improvised a plausible-looking confidence score
                # and vote count instead of reading the real similarity data. Chain
                # both real tool calls deterministically: majority-vote the target
                # project from get_similar_assigned_requirements, use the vote
                # proportion as the base confidence, then let write_inferred_project_link
                # apply the actual RL adjustment.
                if _is_suggest_project_question(user_input):
                    suggest_req_id = _extract_requirement_id_from_question(user_input)
                    if suggest_req_id:
                        print(f"\n[tool] get_similar_assigned_requirements({{'requirement_id': '{suggest_req_id}'}})")
                        sim_result = await session.call_tool(
                            "get_similar_assigned_requirements", {"requirement_id": suggest_req_id}
                        )
                        sim_text = "\n".join(
                            getattr(p, "text", "") for p in sim_result.content if getattr(p, "text", None)
                        ) or "{}"
                        try:
                            sim_payload = json.loads(sim_text)
                        except Exception:
                            sim_payload = {"similar_requirements": []}

                        similar_reqs = sim_payload.get("similar_requirements", [])
                        vote_counts: dict[str, int] = {}
                        for r in similar_reqs:
                            for pid in r.get("assigned_projects", []) or []:
                                vote_counts[pid] = vote_counts.get(pid, 0) + 1

                        if not vote_counts:
                            content = (
                                f"No similar assigned requirements were found for {suggest_req_id}, "
                                "so I can't suggest a project with any grounded confidence.\n\n"
                                "Evidence: Neo4j knowledge graph | get_similar_assigned_requirements()"
                            )
                        else:
                            target_project = max(vote_counts, key=vote_counts.get)
                            total_n = len(similar_reqs)
                            base_confidence = round(vote_counts[target_project] / total_n, 2) if total_n else 0.5
                            reasoning = (
                                f"{vote_counts[target_project]} of {total_n} similar requirements from the same "
                                f"ADR source are already assigned to {target_project}."
                            )

                            print(
                                f"\n[tool] write_inferred_project_link({{'requirement_id': '{suggest_req_id}', "
                                f"'project_id': '{target_project}', 'confidence': {base_confidence}, ...}})"
                            )
                            write_result = await session.call_tool(
                                "write_inferred_project_link",
                                {
                                    "requirement_id": suggest_req_id,
                                    "project_id": target_project,
                                    "confidence": base_confidence,
                                    "reasoning": reasoning,
                                },
                            )
                            write_text = "\n".join(
                                getattr(p, "text", "") for p in write_result.content if getattr(p, "text", None)
                            ) or "{}"
                            try:
                                write_payload = json.loads(write_text)
                            except Exception:
                                write_payload = {}

                            if "error" not in write_payload:
                                last_suggested_link = (suggest_req_id, target_project)

                            content = _format_project_suggestion(
                                suggest_req_id, target_project, base_confidence, reasoning,
                                write_payload, vote_counts, total_n,
                            )

                        print(f"\nAssistant: {content}")
                        messages.append({"role": "user", "content": user_input})
                        messages.append({"role": "assistant", "content": content})
                        continue

                # Deterministic path for "reject/confirm/modify/ignore that suggestion"
                # feedback questions. Resolves the requirement/project either from
                # explicit IDs in the question, or from the last suggestion this
                # session made via the suggest-project path above -- rather than
                # asking the model to recall a vague "that suggestion" reference
                # and invent requirement_id/project_id/reward parameters itself.
                if _is_feedback_action_question(user_input):
                    fb_action = _extract_feedback_action(user_input)
                    fb_req_id = _extract_requirement_id_from_question(user_input)
                    fb_project_id = _extract_project_id_from_question(user_input)
                    if fb_req_id and not fb_project_id and last_suggested_link and last_suggested_link[0] == fb_req_id:
                        fb_project_id = last_suggested_link[1]
                    if not fb_req_id and not fb_project_id and last_suggested_link:
                        fb_req_id, fb_project_id = last_suggested_link

                    if fb_action and fb_req_id and fb_project_id:
                        fb_reward = _FEEDBACK_ACTION_REWARDS[fb_action]
                        print(
                            f"\n[tool] record_feedback({{'requirement_id': '{fb_req_id}', "
                            f"'project_id': '{fb_project_id}', 'action': '{fb_action}', 'reward': {fb_reward}}})"
                        )
                        fb_result = await session.call_tool(
                            "record_feedback",
                            {
                                "requirement_id": fb_req_id,
                                "project_id": fb_project_id,
                                "action": fb_action,
                                "reward": fb_reward,
                            },
                        )
                        fb_text = "\n".join(
                            getattr(p, "text", "") for p in fb_result.content if getattr(p, "text", None)
                        ) or "{}"
                        try:
                            fb_payload = json.loads(fb_text)
                        except Exception:
                            fb_payload = {"error": "could not parse tool response"}

                        content = _format_feedback_result(fb_payload)
                        print(f"\nAssistant: {content}")
                        messages.append({"role": "user", "content": user_input})
                        messages.append({"role": "assistant", "content": content})
                        continue

                # Deterministic path for RL policy questions. get_rl_policy() already
                # returns a pre-formatted human-readable report, so just relay it.
                if _is_rl_policy_question(user_input):
                    print("\n[tool] get_rl_policy({})")
                    policy_result = await session.call_tool("get_rl_policy", {})
                    policy_text = "\n".join(
                        getattr(p, "text", "") for p in policy_result.content if getattr(p, "text", None)
                    ) or "(no policy data)"
                    content = f"{policy_text}\n\nEvidence: Neo4j knowledge graph | get_rl_policy()"
                    print(f"\nAssistant: {content}")
                    messages.append({"role": "user", "content": user_input})
                    messages.append({"role": "assistant", "content": content})
                    continue

                # Deterministic path for feedback-stats questions.
                if _is_feedback_stats_question(user_input):
                    print("\n[tool] get_feedback_stats({})")
                    stats_result = await session.call_tool("get_feedback_stats", {})
                    stats_text = "\n".join(
                        getattr(p, "text", "") for p in stats_result.content if getattr(p, "text", None)
                    ) or "{}"
                    try:
                        stats_payload = json.loads(stats_text)
                    except Exception:
                        stats_payload = {"total_events": 0, "average_reward": 0.0}
                    content = _format_feedback_stats(stats_payload)
                    print(f"\nAssistant: {content}")
                    messages.append({"role": "user", "content": user_input})
                    messages.append({"role": "assistant", "content": content})
                    continue

                # Deterministic path for "inferred links" questions.
                if _is_inferred_links_question(user_input):
                    print("\n[tool] get_inferred_links({})")
                    links_result = await session.call_tool("get_inferred_links", {})
                    links_text = "\n".join(
                        getattr(p, "text", "") for p in links_result.content if getattr(p, "text", None)
                    ) or "{}"
                    try:
                        links_payload = json.loads(links_text)
                    except Exception:
                        links_payload = {"inferred_link_count": 0, "inferred_links": []}

                    content = _format_inferred_links(links_payload)
                    print(f"\nAssistant: {content}")
                    messages.append({"role": "user", "content": user_input})
                    messages.append({"role": "assistant", "content": content})
                    continue

                # Deterministic path for "unassigned requirements" questions.
                if _is_unassigned_requirements_question(user_input):
                    print("\n[tool] get_unassigned_requirements({})")
                    unassigned_result = await session.call_tool("get_unassigned_requirements", {})
                    unassigned_text = "\n".join(
                        getattr(p, "text", "") for p in unassigned_result.content if getattr(p, "text", None)
                    ) or "{}"
                    try:
                        unassigned_payload = json.loads(unassigned_text)
                    except Exception:
                        unassigned_payload = {"unassigned_count": 0, "unassigned_requirements": []}

                    content = _format_unassigned_requirements(unassigned_payload)
                    print(f"\nAssistant: {content}")
                    messages.append({"role": "user", "content": user_input})
                    messages.append({"role": "assistant", "content": content})
                    continue

                # Deterministic path for cross-assembly / interface-risk questions.
                # Both underlying tools take no arguments -- calling them directly
                # avoids the model inventing parameters (e.g. a fabricated
                # "assemblies" kwarg naming an assembly ID that doesn't exist).
                if _is_interface_risk_question(user_input):
                    print("\n[tool] get_cross_assembly_requirements({})")
                    cross_result = await session.call_tool("get_cross_assembly_requirements", {})
                    cross_text = "\n".join(
                        getattr(p, "text", "") for p in cross_result.content if getattr(p, "text", None)
                    ) or "{}"

                    print("\n[tool] get_interface_risk_report({})")
                    risk_result = await session.call_tool("get_interface_risk_report", {})
                    risk_text = "\n".join(
                        getattr(p, "text", "") for p in risk_result.content if getattr(p, "text", None)
                    ) or "{}"

                    try:
                        cross_payload = json.loads(cross_text)
                    except Exception:
                        cross_payload = {"cross_assembly_adrs": []}
                    try:
                        risk_payload = json.loads(risk_text)
                    except Exception:
                        risk_payload = {"interfaces": [], "total_interface_pairs": 0, "risk_count": 0}

                    content = _format_cross_assembly_and_interface_risk(cross_payload, risk_payload)
                    print(f"\nAssistant: {content}")
                    messages.append({"role": "user", "content": user_input})
                    messages.append({"role": "assistant", "content": content})
                    continue

                # Deterministic path for reference queries by ADR/SRP ID.
                if _is_reference_question(user_input):
                    rule_id = _extract_rule_id_from_question(user_input)
                    if rule_id:
                        print(f"\n[tool] get_adr_requirements({{'adr_id': '{rule_id}', 'limit': {GRAPH_LIMIT}}})")
                        req_result = await session.call_tool("get_adr_requirements", {"adr_id": rule_id, "limit": GRAPH_LIMIT})

                        req_text_parts: list[str] = []
                        for part in req_result.content:
                            text = getattr(part, "text", None)
                            if text:
                                req_text_parts.append(text)
                        req_text = "\n".join(req_text_parts) if req_text_parts else "{}"

                        try:
                            req_payload = json.loads(req_text)
                        except Exception:
                            req_payload = {"adr_id": rule_id, "count": 0, "evidence_refs": []}

                        normalized_rule = req_payload.get("adr_id", rule_id)
                        print(f"\n[tool] search_local_documents({{'query': '{normalized_rule}', 'max_files': {DOC_MAX_FILES}, 'max_hits_per_file': {DOC_MAX_HITS}}})")
                        doc_result = await session.call_tool(
                            "search_local_documents",
                            {"query": normalized_rule, "max_files": DOC_MAX_FILES, "max_hits_per_file": DOC_MAX_HITS},
                        )

                        doc_text_parts: list[str] = []
                        for part in doc_result.content:
                            text = getattr(part, "text", None)
                            if text:
                                doc_text_parts.append(text)
                        doc_text = "\n".join(doc_text_parts) if doc_text_parts else "{}"

                        try:
                            doc_payload = json.loads(doc_text)
                        except Exception:
                            doc_payload = {"matches": []}

                        content = _format_reference_listing(rule_id, req_payload, doc_payload)
                        print(f"\nAssistant: {content}")
                        messages.append({"role": "user", "content": user_input})
                        messages.append({"role": "assistant", "content": content})
                        continue

                design_guidance = _design_guidance_redirect(user_input)
                if design_guidance:
                    print(
                        f"\n[tool] search_local_documents({{'query': '{design_guidance['query']}', 'max_files': 5, 'max_hits_per_file': 3}})"
                    )
                    design_result = await session.call_tool(
                        "search_local_documents",
                        {"query": design_guidance["query"], "max_files": 5, "max_hits_per_file": 3},
                    )

                    design_text_parts: list[str] = []
                    for part in design_result.content:
                        text = getattr(part, "text", None)
                        if text:
                            design_text_parts.append(text)
                    design_text = "\n".join(design_text_parts) if design_text_parts else "{}"

                    messages.append({"role": "user", "content": user_input})
                    messages.append(
                        {
                            "role": "assistant",
                            "content": "",
                            "tool_calls": [
                                {
                                    "function": {
                                        "name": "search_local_documents",
                                        "arguments": {
                                            "query": design_guidance["query"],
                                            "max_files": 5,
                                            "max_hits_per_file": 3,
                                        },
                                    }
                                }
                            ],
                        }
                    )
                    messages.append({"role": "tool", "name": "search_local_documents", "content": design_text})
                    tool_used_this_turn = True
                    evidence_refs_this_turn = _extract_evidence_refs(design_text)

                    for _ in range(6):
                        result = _post_chat(model=model, messages=messages, tools=tools)
                        assistant_message = result.get("message", {})
                        tool_calls = assistant_message.get("tool_calls", [])

                        if not tool_calls:
                            content = assistant_message.get("content", "")
                            if _strict_context_only() and not tool_used_this_turn:
                                content = "I do not have enough context in the indexed sources to answer that."
                            elif _strict_context_only() and _require_explicit_citations():
                                if not _has_explicit_citation(content):
                                    if evidence_refs_this_turn:
                                        refs_text = "; ".join(evidence_refs_this_turn[:3])
                                        content = f"{content.strip()}\n\nEvidence: {refs_text}"
                                    else:
                                        content = "I do not have enough context in the indexed sources to answer that."

                            if design_guidance["redirect"] not in content:
                                content = f"{content.strip()}\n\n{design_guidance['redirect']}"

                            print(f"\nAssistant: {content}")
                            messages.append({"role": "assistant", "content": content})
                            break

                        messages.append(
                            {
                                "role": "assistant",
                                "content": assistant_message.get("content", ""),
                                "tool_calls": tool_calls,
                            }
                        )

                        for call in tool_calls:
                            fn = call.get("function", {})
                            tool_name = fn.get("name")
                            args = fn.get("arguments", {})

                            if isinstance(args, str):
                                try:
                                    args = json.loads(args)
                                except Exception:
                                    args = {}

                            print(f"\n[tool] {tool_name}({args})")
                            tool_result = await session.call_tool(tool_name, args)
                            tool_used_this_turn = True

                            tool_text_parts: list[str] = []
                            for part in tool_result.content:
                                text = getattr(part, "text", None)
                                if text:
                                    tool_text_parts.append(text)
                            tool_text = "\n".join(tool_text_parts) if tool_text_parts else str(tool_result)
                            refs = _extract_evidence_refs(tool_text)
                            if refs:
                                evidence_refs_this_turn.extend(refs)

                            messages.append(
                                {
                                    "role": "tool",
                                    "name": tool_name,
                                    "content": tool_text,
                                }
                            )
                    else:
                        print("\nAssistant: I hit the tool-call loop limit. Please rephrase and try again.")
                    continue

                messages.append({"role": "user", "content": user_input})
                tool_used_this_turn = False
                graph_tool_called = False
                graph_nudge_used = False
                evidence_refs_this_turn: list[str] = []

                # RL-guided prefetch stage for standard questions.
                rl_state, rl_actions = _rl_state_and_actions(user_input)
                rl_action = rl_bridge.choose_action(rl_state, rl_actions)
                if rl_action:
                    print(f"\n[rl] state={rl_state} action={rl_action}")

                rule_id = _extract_rule_id_from_question(user_input)

                if rl_action in {"documents_first", "hybrid"}:
                    doc_query = rule_id or user_input
                    print(f"\n[tool] search_local_documents({{'query': '{doc_query}', 'max_files': {DOC_MAX_FILES}, 'max_hits_per_file': {DOC_MAX_HITS}}})")
                    doc_result = await session.call_tool(
                        "search_local_documents",
                        {"query": doc_query, "max_files": DOC_MAX_FILES, "max_hits_per_file": DOC_MAX_HITS},
                    )
                    doc_text_parts: list[str] = []
                    for part in doc_result.content:
                        text = getattr(part, "text", None)
                        if text:
                            doc_text_parts.append(text)
                    doc_text = "\n".join(doc_text_parts) if doc_text_parts else "{}"
                    refs = _extract_evidence_refs(doc_text)
                    if refs:
                        evidence_refs_this_turn.extend(refs)
                    # A "tool" message must follow an assistant tool_calls turn, or the
                    # chat template gets a role sequence it wasn't trained on and the model
                    # starts narrating tool calls as text instead of using the tool_calls field.
                    messages.append(
                        {
                            "role": "assistant",
                            "content": "",
                            "tool_calls": [
                                {
                                    "function": {
                                        "name": "search_local_documents",
                                        "arguments": {
                                            "query": doc_query,
                                            "max_files": DOC_MAX_FILES,
                                            "max_hits_per_file": DOC_MAX_HITS,
                                        },
                                    }
                                }
                            ],
                        }
                    )
                    messages.append({"role": "tool", "name": "search_local_documents", "content": doc_text})
                    tool_used_this_turn = True

                if rl_action in {"graph_first", "hybrid"} and rule_id:
                    print(f"\n[tool] get_adr_requirements({{'adr_id': '{rule_id}', 'limit': {GRAPH_LIMIT}}})")
                    graph_result = await session.call_tool(
                        "get_adr_requirements",
                        {"adr_id": rule_id, "limit": GRAPH_LIMIT},
                    )
                    graph_text_parts: list[str] = []
                    for part in graph_result.content:
                        text = getattr(part, "text", None)
                        if text:
                            graph_text_parts.append(text)
                    graph_text = "\n".join(graph_text_parts) if graph_text_parts else "{}"
                    refs = _extract_evidence_refs(graph_text, tool_name="get_adr_requirements")
                    if refs:
                        evidence_refs_this_turn.extend(refs)
                    messages.append(
                        {
                            "role": "assistant",
                            "content": "",
                            "tool_calls": [
                                {
                                    "function": {
                                        "name": "get_adr_requirements",
                                        "arguments": {"adr_id": rule_id, "limit": GRAPH_LIMIT},
                                    }
                                }
                            ],
                        }
                    )
                    messages.append({"role": "tool", "name": "get_adr_requirements", "content": graph_text})
                    tool_used_this_turn = True
                    graph_tool_called = True

                for _ in range(6):
                    result = _post_chat(model=model, messages=messages, tools=tools)
                    assistant_message = result.get("message", {})
                    tool_calls = assistant_message.get("tool_calls", [])

                    if not tool_calls:
                        content = assistant_message.get("content", "")
                        if _strict_context_only() and not tool_used_this_turn:
                            content = "I do not have enough context in the indexed sources to answer that."
                        elif _strict_context_only() and not graph_tool_called and not graph_nudge_used:
                            # The model answered from a (likely unhelpful) document search alone
                            # without trying the knowledge graph. Small local models don't reliably
                            # volunteer a second tool call on their own, so force exactly one retry
                            # with an explicit instruction before giving up.
                            graph_nudge_used = True
                            print("\n[nudge] no graph tool called yet — retrying with an explicit instruction")
                            messages.append(
                                {
                                    "role": "user",
                                    "content": (
                                        "You have not called a knowledge-graph tool yet. Call the single most "
                                        "relevant one now — pick from the FULL tool list above, not just this "
                                        "short list of examples: list_all_projects, list_all_adrs, get_project, "
                                        "get_adr, get_assembly, get_compliance_gaps, get_unassigned_requirements, "
                                        "get_interface_risk_report, get_inferred_links, promote_inferred_link, "
                                        "record_feedback, get_feedback_stats, get_rl_policy, "
                                        "query_knowledge_graph. Choose the one that actually matches the "
                                        "question, don't default to one of these examples if a better match "
                                        "exists elsewhere in your tool list. Do not reply with plain text yet — "
                                        "call a tool first."
                                    ),
                                }
                            )
                            continue
                        elif _strict_context_only() and _require_explicit_citations():
                            if not _has_explicit_citation(content):
                                if evidence_refs_this_turn:
                                    refs_text = "; ".join(evidence_refs_this_turn[:3])
                                    content = f"{content.strip()}\n\nEvidence: {refs_text}"
                                else:
                                    content = "I do not have enough context in the indexed sources to answer that."
                        print(f"\nAssistant: {content}")
                        messages.append({"role": "assistant", "content": content})

                        # RL update from this completed turn.
                        reward = _rl_reward(content, tool_used_this_turn, evidence_refs_this_turn)
                        rl_bridge.update_and_save(
                            state=rl_state,
                            action=rl_action,
                            reward=reward,
                            next_state=rl_state,
                            next_actions=rl_actions,
                        )
                        break

                    messages.append(
                        {
                            "role": "assistant",
                            "content": assistant_message.get("content", ""),
                            "tool_calls": tool_calls,
                        }
                    )

                    for call in tool_calls:
                        fn = call.get("function", {})
                        tool_name = fn.get("name")
                        args = fn.get("arguments", {})

                        if isinstance(args, str):
                            try:
                                args = json.loads(args)
                            except Exception:
                                args = {}

                        print(f"\n[tool] {tool_name}({args})")
                        tool_result = await session.call_tool(tool_name, args)
                        tool_used_this_turn = True
                        if tool_name not in _DOCUMENT_TOOLS:
                            graph_tool_called = True

                        tool_text_parts: list[str] = []
                        for part in tool_result.content:
                            text = getattr(part, "text", None)
                            if text:
                                tool_text_parts.append(text)
                        tool_text = "\n".join(tool_text_parts) if tool_text_parts else str(tool_result)
                        refs = _extract_evidence_refs(tool_text, tool_name=tool_name)
                        if refs:
                            evidence_refs_this_turn.extend(refs)

                        messages.append(
                            {
                                "role": "tool",
                                "name": tool_name,
                                "content": tool_text,
                            }
                        )
                else:
                    print("\nAssistant: I hit the tool-call loop limit. Please rephrase and try again.")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Terminal chat with Ollama + local MCP server")
    parser.add_argument("--model", default=None, help="Ollama model tag (default from OLLAMA_MODEL)")
    parser.add_argument(
        "--server-command",
        default="python3",
        help="Command used to launch the MCP server",
    )
    parser.add_argument(
        "--server-script",
        default="sr8-mcp",
        help="MCP server script path",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    model = _ollama_model(args.model)
    asyncio.run(run_chat(model=model, server_command=args.server_command, server_args=[args.server_script]))


if __name__ == "__main__":
    main()
