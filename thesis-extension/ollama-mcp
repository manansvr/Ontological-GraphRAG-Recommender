def _format_unassigned_requirements(payload: dict[str, Any], max_items: int = 20) -> str:
    # get_unassigned_requirements() can return 100+ KB of JSON with full
    # requirement descriptions -- multiples of the whole context window.
    # Format a compact listing directly rather than asking the model to
    # read the raw dump (it hallucinates unrelated content when it does).
    count = payload.get("unassigned_count", 0)
    reqs = payload.get("unassigned_requirements", [])
    lines = [f"{count} requirement(s) have not been assigned to a project."]
    shown = reqs[:max_items]
    for r in shown:
        desc = (r.get("req_description") or "").strip()
        if len(desc) > 140:
            desc = desc[:140].rstrip() + "..."
        lines.append(f"- {r.get('req_id')}: {r.get('req_name')} — {desc}")
    if len(reqs) > max_items:
        lines.append(f"...and {len(reqs) - max_items} more (ask for a specific ID to see full detail).")
    lines.append("")
    lines.append("Evidence: Neo4j knowledge graph | get_unassigned_requirements()")
    return "\n".join(lines)


