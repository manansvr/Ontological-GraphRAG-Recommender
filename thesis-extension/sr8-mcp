    }, indent=2)


@mcp.tool()
def get_interface_risk_report() -> str:
    """Full interface risk report across all assemblies: shared requirements, ADR sources, and verification mismatches."""
    query = """
    MATCH (asm1)<-[:partOfAssembly]-(p1:Project)
          <-[:assignedToProject]-(r1:ExtractedEssentialRequirement)
          <-[:hasExternalEssentialRequirement]-(a:AustralianDesignRule)
          -[:hasExternalEssentialRequirement]->(r2:ExtractedEssentialRequirement)
          -[:assignedToProject]->(p2:Project)-[:partOfAssembly]->(asm2)
    WHERE asm1.assemblyID < asm2.assemblyID
    WITH asm1.assemblyID AS assembly_a,
         asm2.assemblyID AS assembly_b,
         a.hasID AS adr_id,
         a.hasName AS adr_name,
         collect(DISTINCT r1.hasID) AS reqs_in_a,
         collect(DISTINCT r2.hasID) AS reqs_in_b,
         count(CASE WHEN r1.isVerified = false OR r1.isVerified IS NULL THEN 1 END) +
         count(CASE WHEN r2.isVerified = false OR r2.isVerified IS NULL THEN 1 END) AS unverified_count
    RETURN assembly_a,
           assembly_b,
           adr_id,
           adr_name,
           reqs_in_a,
           reqs_in_b,
           size(reqs_in_a) + size(reqs_in_b) AS total_shared,
           unverified_count,
           CASE WHEN unverified_count > 0 THEN 'RISK: unverified requirements on interface'
                ELSE 'OK'
           END AS risk_flag
    ORDER BY assembly_a, assembly_b, adr_id
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                rows = [record.data() for record in session.run(query)]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    risk_rows = [r for r in rows if r.get("risk_flag", "").startswith("RISK")]
    return json.dumps({
        "total_interface_pairs": len(rows),
        "risk_count": len(risk_rows),
        "interfaces": rows,
    }, indent=2)


# ── Phase 4: Requirement propagation inference ─────────────────────────────────

@mcp.tool()
def get_unassigned_requirements(include_reviewed: bool = False) -> str:
    """Call when user asks about gaps, missing assignments, or extending the knowledge base.

    Returns all ExtractedEssentialRequirement nodes that have no assignedToProject relationship.
    Each result lists its existing suggestedProject links under 'suggestions'. By default only
    pending suggestions (no status) are listed; suggestions already promoted or rejected by a
    reviewer are left out unless include_reviewed=True.
    After calling this, call get_similar_assigned_requirements for each result,
    then write_inferred_project_link. Only promote links where confidence >= 0.6.
    """
    query = """
    MATCH (r:ExtractedEssentialRequirement)
    WHERE NOT (r)-[:assignedToProject]->()
    OPTIONAL MATCH (a:AustralianDesignRule)-[:hasExternalEssentialRequirement]->(r)
    OPTIONAL MATCH (a)-[:hasClause]->(c:Clause)
    WITH r, a, collect(DISTINCT c.hasID) AS clause_ids
    RETURN r.hasID AS req_id,
           r.requirementName AS req_name,
           r.requirementDescription AS req_description,
           r.isApplicable AS is_applicable,
           a.hasID AS adr_id,
           a.hasName AS adr_name,
           clause_ids,
           [(r)-[s:suggestedProject]->(sp:Project)
             WHERE $include_reviewed OR s.status IS NULL
             | {project_id: sp.projectID, confidence: s.confidence, status: s.status}] AS suggestions
    ORDER BY adr_id, req_id
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                rows = [record.data() for record in session.run(query, include_reviewed=include_reviewed)]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    return json.dumps({
        "unassigned_count": len(rows),
        "unassigned_requirements": rows,
    }, indent=2)


@mcp.tool()
def get_similar_assigned_requirements(requirement_id: str) -> str:
    """Find the 5 most similar requirements that already have project assignments.

    Similarity is based on: same ADR source, adjacent clause ordering, and overlapping
    words in requirementName. Returns matches with their assigned projects.
    """
    if not requirement_id.strip():
        return json.dumps({"error": "requirement_id must not be empty"}, indent=2)

    query = """
    MATCH (target:ExtractedEssentialRequirement {hasID: $req_id})
    OPTIONAL MATCH (a:AustralianDesignRule)-[:hasExternalEssentialRequirement]->(target)
    WITH target, a
    MATCH (a)-[:hasExternalEssentialRequirement]->(similar:ExtractedEssentialRequirement)
    WHERE similar.hasID <> $req_id
      AND (similar)-[:assignedToProject]->()
    OPTIONAL MATCH (similar)-[:assignedToProject]->(p:Project)
    WITH similar, a, collect(DISTINCT p.projectID) AS projects
    RETURN similar.hasID AS req_id,
           similar.requirementName AS req_name,
           similar.isApplicable AS is_applicable,
           a.hasID AS adr_id,
           projects AS assigned_projects
    ORDER BY similar.hasID
    LIMIT 5
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                rows = [record.data() for record in session.run(query, req_id=requirement_id)]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    return json.dumps({
        "source_requirement_id": requirement_id,
        "similar_count": len(rows),
        "similar_requirements": rows,
    }, indent=2)


@mcp.tool()
def write_inferred_project_link(
    requirement_id: str,
    project_id: str,
    confidence: float,
    reasoning: str,
) -> str:
    """Write a suggestedProject relationship from an unassigned requirement to a project.

    NEVER creates assignedToProject — only suggestedProject. The confidence score is
    nudged by the RL agent's contextual policy before being stored. The computed
    inference state is stored on the relationship so record_feedback can retrieve it.
    """
    if not requirement_id.strip() or not project_id.strip():
        return json.dumps({"error": "requirement_id and project_id must not be empty."}, indent=2)
    if not 0.0 <= confidence <= 1.0:
        return json.dumps({"error": "confidence must be between 0.0 and 1.0."}, indent=2)

    # FIX 1: gather context to compute a richer state before calling the agent.
    similar_count = 0
    adr_populated = False
    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                ctx = session.run("""
                    MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
                    OPTIONAL MATCH (a:AustralianDesignRule)-[:hasExternalEssentialRequirement]->(r)
                    OPTIONAL MATCH (a)-[:hasExternalEssentialRequirement]->(sim:ExtractedEssentialRequirement)
                    WHERE sim.hasID <> $req_id AND (sim)-[:assignedToProject]->()
                    WITH a, count(DISTINCT sim) AS similar_count
                    OPTIONAL MATCH (a)-[:hasExternalEssentialRequirement]
                                   ->(any_r:ExtractedEssentialRequirement)
                                   -[:assignedToProject]->(:Project)
                    RETURN similar_count,
                           CASE WHEN count(DISTINCT any_r) > 0 THEN true ELSE false END AS adr_populated
                """, req_id=requirement_id).single()
                if ctx:
                    similar_count = ctx["similar_count"] or 0
                    adr_populated = bool(ctx["adr_populated"])
    except Exception:
        pass

    infer_state = _inference_state(similar_count, adr_populated, confidence)
    adjusted_confidence = _rl_adjust_confidence(confidence, infer_state)

    write_query = """
    MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
    MATCH (p:Project {projectID: $project_id})
    MERGE (r)-[rel:suggestedProject]->(p)
    SET rel.confidence     = $confidence,
        rel.reasoning      = $reasoning,
        rel.inferredBy     = 'Ollama-MCP',
        rel.inferredAt     = datetime(),
        rel.inferenceState = $inference_state
    RETURN r.hasID AS req_id, p.projectID AS project_id, rel.confidence AS stored_confidence
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                row = session.run(
                    write_query,
                    req_id=requirement_id,
                    project_id=project_id,
                    confidence=adjusted_confidence,
                    reasoning=reasoning,
                    inference_state=infer_state,
                ).single()
                if not row:
                    return json.dumps({"error": "Requirement or Project not found."}, indent=2)
                return json.dumps({
                    "status": "written",
                    "req_id": row["req_id"],
                    "project_id": row["project_id"],
                    "original_confidence": confidence,
                    "adjusted_confidence": adjusted_confidence,
                    "inference_state": infer_state,
                    "reasoning": reasoning,
                }, indent=2)
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)


@mcp.tool()
def get_inferred_links(include_reviewed: bool = False) -> str:
    """Return suggestedProject relationships sorted by confidence (highest first).

    By default only pending suggestions (no status) are returned. Suggestions a reviewer
    has promoted or rejected keep their status, reviewedBy, reviewedAt and (for rejections)
    rejectionReason; pass include_reviewed=True to include them.

    Each entry includes a 'recommended' flag (true if confidence >= 0.6) and a
    'warning' field for low-confidence suggestions that require careful review.
    """
    query = """
    MATCH (r:ExtractedEssentialRequirement)-[rel:suggestedProject]->(p:Project)
    WHERE $include_reviewed OR rel.status IS NULL
    OPTIONAL MATCH (a:AustralianDesignRule)-[:hasExternalEssentialRequirement]->(r)
    RETURN r.hasID AS req_id,
           r.requirementName AS req_name,
           p.projectID AS project_id,
           p.projectName AS project_name,
           rel.confidence AS confidence,
           rel.reasoning AS reasoning,
           rel.inferredBy AS inferred_by,
           toString(rel.inferredAt) AS inferred_at,
           rel.inferenceState AS inference_state,
           rel.status AS status,
           rel.reviewedBy AS reviewed_by,
           toString(rel.reviewedAt) AS reviewed_at,
           rel.rejectionReason AS rejection_reason,
           a.hasID AS adr_id
    ORDER BY rel.confidence DESC
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                rows = [record.data() for record in session.run(query, include_reviewed=include_reviewed)]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    # FIX 2: annotate each link with operational guidance.
    for row in rows:
        conf = row.get("confidence") or 0.0
        row["recommended"] = conf >= 0.6
        row["warning"] = "low confidence — review carefully" if conf < 0.4 else None

    return json.dumps({"inferred_link_count": len(rows), "inferred_links": rows}, indent=2)


@mcp.tool()
def promote_inferred_link(
    requirement_id: str,
    project_id: str,
    reviewer: str,
    action: str = "confirmed",
) -> str:
    """Confirm a pending suggestedProject relationship as an assignedToProject relationship.

    reviewer (required, non-empty) identifies the person who reviewed the suggestion.
    action must be 'confirmed' (reward 1.0) or 'modified' (reward 0.5).

    In one transaction this:
    1. records a FeedbackEvent (with reviewer) using the confidence and inference state
       stored on the suggestion, and
    2. creates assignedToProject with source='inferred', promotedAt, promotedBy=reviewer,
       promotedFromConfidence, inferenceReasoning, inferredBy, inferredAt and
       inferenceState copied from the suggestion. If an assignedToProject relationship
       already exists it is left unchanged and already_assigned=true is returned.
    3. keeps the suggestedProject relationship and sets status='promoted', reviewedAt
       and reviewedBy on it.
    The RL agent is then updated. Do not call record_feedback for the same decision.
    Only pending suggestions (no status) can be promoted.
    """
    if not requirement_id.strip() or not project_id.strip():
        return json.dumps({"error": "requirement_id and project_id must not be empty."}, indent=2)
    reviewer = reviewer.strip()
    if not reviewer:
        return json.dumps({"error": "reviewer must not be empty."}, indent=2)
    rewards = {"confirmed": REWARD_CONFIRMED, "modified": REWARD_MODIFIED}
    if action not in rewards:
        return json.dumps({"error": f"action must be one of {sorted(rewards)}."}, indent=2)

    promote_query = """
    MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
          -[suggested:suggestedProject]->(p:Project {projectID: $project_id})
    WHERE suggested.status IS NULL
    OPTIONAL MATCH (r)-[existing:assignedToProject]->(p)
    WITH r, p, suggested, count(existing) > 0 AS already_assigned
    MERGE (r)-[confirmed:assignedToProject]->(p)
    ON CREATE SET confirmed.source                 = 'inferred',
                  confirmed.promotedAt             = datetime(),
                  confirmed.promotedBy             = $reviewer,
                  confirmed.promotedFromConfidence = suggested.confidence,
                  confirmed.inferenceReasoning     = suggested.reasoning,
                  confirmed.inferredBy             = suggested.inferredBy,
                  confirmed.inferredAt             = suggested.inferredAt,
                  confirmed.inferenceState         = suggested.inferenceState
    SET suggested.status     = 'promoted',
        suggested.reviewedAt = datetime(),
        suggested.reviewedBy = $reviewer
    RETURN r.hasID AS req_id, p.projectID AS project_id, already_assigned
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                with session.begin_transaction() as tx:
                    exists, status = _pending_suggestion_status(tx, requirement_id, project_id)
                    if not exists:
                        return json.dumps({
                            "error": f"No suggestedProject relationship found between '{requirement_id}' and '{project_id}'.",
                        }, indent=2)
                    if status is not None:
                        return json.dumps({
                            "error": f"Suggestion between '{requirement_id}' and '{project_id}' was already reviewed (status '{status}').",
                        }, indent=2)
                    feedback = _record_feedback_internal(
                        tx, requirement_id, project_id, action, rewards[action], reviewer=reviewer,
                    )
                    row = tx.run(
                        promote_query, req_id=requirement_id, project_id=project_id, reviewer=reviewer,
                    ).single()
                    tx.commit()
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    _rl_update(action, feedback["reward_applied"], state=feedback["inference_state"])

    return json.dumps({
        "status": "promoted",
        "req_id": row["req_id"],
        "project_id": row["project_id"],
        "reviewer": reviewer,
        "already_assigned": row["already_assigned"],
        "feedback": feedback,
        "message": (
            "assignedToProject already existed and was left unchanged; suggestion marked promoted."
            if row["already_assigned"] else
            "assignedToProject created with source='inferred'; suggestion kept with status='promoted'."
        ),
    }, indent=2)


@mcp.tool()
def reject_inferred_link(requirement_id: str, project_id: str, reviewer: str, reason: str) -> str:
    """Reject a pending suggestedProject relationship.

    reviewer (required, non-empty) identifies the person who reviewed the suggestion;
    reason is stored as rejectionReason.

    In one transaction this records a 'rejected' FeedbackEvent (reward -1.0, or
    PENALTY_OVERCONFIDENT=-2.0 when the stored confidence was >0.8) and sets
    status='rejected', reviewedBy, reviewedAt and rejectionReason on the suggestion.
    The suggestion is not deleted. The RL agent is then updated.
    Do not call record_feedback for the same decision.
    """
    if not requirement_id.strip() or not project_id.strip():
        return json.dumps({"error": "requirement_id and project_id must not be empty."}, indent=2)
    reviewer = reviewer.strip()
    if not reviewer:
        return json.dumps({"error": "reviewer must not be empty."}, indent=2)

    reject_query = """
    MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
          -[suggested:suggestedProject]->(p:Project {projectID: $project_id})
    WHERE suggested.status IS NULL
    SET suggested.status          = 'rejected',
        suggested.reviewedAt      = datetime(),
        suggested.reviewedBy      = $reviewer,
        suggested.rejectionReason = $reason
    RETURN r.hasID AS req_id, p.projectID AS project_id
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                with session.begin_transaction() as tx:
                    exists, status = _pending_suggestion_status(tx, requirement_id, project_id)
                    if not exists:
                        return json.dumps({
                            "error": f"No suggestedProject relationship found between '{requirement_id}' and '{project_id}'.",
                        }, indent=2)
                    if status is not None:
                        return json.dumps({
                            "error": f"Suggestion between '{requirement_id}' and '{project_id}' was already reviewed (status '{status}').",
                        }, indent=2)
                    feedback = _record_feedback_internal(
                        tx, requirement_id, project_id, "rejected", REWARD_REJECTED, reviewer=reviewer,
                    )
                    row = tx.run(
                        reject_query, req_id=requirement_id, project_id=project_id,
                        reviewer=reviewer, reason=reason,
                    ).single()
                    tx.commit()
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    _rl_update("rejected", feedback["reward_applied"], state=feedback["inference_state"])

    return json.dumps({
        "status": "rejected",
        "req_id": row["req_id"],
        "project_id": row["project_id"],
        "reviewer": reviewer,
        "rejection_reason": reason,
        "feedback": feedback,
    }, indent=2)


# ── Phase 5: Change impact analysis ───────────────────────────────────────────

@mcp.tool()
def get_requirements_by_keyword(keyword: str) -> str:
    """Search requirementName, requirementDescription, and clauseText for a keyword.

    Returns matches with ADR, clause number, assigned projects, and assemblies.
    """
    if not keyword.strip():
        return json.dumps({"error": "keyword must not be empty"}, indent=2)

    query = """
    MATCH (r:ExtractedEssentialRequirement)
    WHERE toLower(r.requirementName) CONTAINS toLower($kw)
       OR toLower(r.requirementDescription) CONTAINS toLower($kw)
    OPTIONAL MATCH (a:AustralianDesignRule)-[:hasExternalEssentialRequirement]->(r)
    OPTIONAL MATCH (a)-[:hasClause]->(c:Clause)
    WHERE toLower(c.clauseText) CONTAINS toLower($kw)
    OPTIONAL MATCH (r)-[:assignedToProject]->(p:Project)
    OPTIONAL MATCH (p)-[:partOfAssembly]->(asm)
    RETURN r.hasID AS req_id,
           r.requirementName AS req_name,
           r.isApplicable AS is_applicable,
           a.hasID AS adr_id,
           collect(DISTINCT c.hasID) AS matching_clauses,
           collect(DISTINCT p.projectID) AS assigned_projects,
           collect(DISTINCT asm.assemblyID) AS assemblies
    ORDER BY a.hasID, r.hasID
    LIMIT 50
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                rows = [record.data() for record in session.run(query, kw=keyword)]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    return json.dumps({"keyword": keyword, "match_count": len(rows), "matches": rows}, indent=2)


@mcp.tool()
def get_requirement_chain(requirement_id: str) -> str:
    """Traverse the full chain for a requirement: AustralianDesignRule → Clause → ExtractedEssentialRequirement → Project → Assembly."""
    if not requirement_id.strip():
        return json.dumps({"error": "requirement_id must not be empty"}, indent=2)

    query = """
    MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
    OPTIONAL MATCH (a:AustralianDesignRule)-[:hasExternalEssentialRequirement]->(r)
    OPTIONAL MATCH (a)-[:hasClause]->(c:Clause)
    OPTIONAL MATCH (r)-[:assignedToProject]->(p:Project)
    OPTIONAL MATCH (p)-[:partOfAssembly]->(asm)
    RETURN r.hasID AS req_id,
           r.requirementName AS req_name,
           r.requirementDescription AS req_description,
           r.isApplicable AS is_applicable,
           a.hasID AS adr_id,
           a.hasName AS adr_name,
           coalesce(a.isVerified, false) AS adr_verified,
           collect(DISTINCT {clause_id: c.hasID, clause_name: c.hasName, clause_text: c.clauseText}) AS clauses,
           collect(DISTINCT {project_id: p.projectID, project_name: p.projectName}) AS projects,
           collect(DISTINCT {assembly_id: asm.assemblyID, assembly_name: asm.assemblyName}) AS assemblies
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                row = session.run(query, req_id=requirement_id).single()
                if not row:
                    return json.dumps({"error": f"Requirement '{requirement_id}' not found."}, indent=2)
                return json.dumps(dict(row), indent=2, default=str)
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)


@mcp.tool()
def get_reverification_scope(project_ids: list[str]) -> str:
    """Given a list of affected project IDs, return all requirements grouped by re-verification category.

    Categories:
    - must_reverify: applicable and currently verified (needs re-checking after change)
    - must_verify: applicable but not yet verified
    - not_affected: not applicable
    """
    if not project_ids:
        return json.dumps({"error": "project_ids must not be empty."}, indent=2)

    query = """
    MATCH (r:ExtractedEssentialRequirement)-[:assignedToProject]->(p:Project)
    WHERE p.projectID IN $project_ids
    OPTIONAL MATCH (a:AustralianDesignRule)-[:hasExternalEssentialRequirement]->(r)
    WITH r, a, collect(DISTINCT p.projectID) AS projects
    RETURN r.hasID AS req_id,
           r.requirementName AS req_name,
           r.isApplicable AS is_applicable,
           coalesce(r.isVerified, false) AS req_verified,
           a.hasID AS adr_id,
           projects,
           CASE
               WHEN r.isApplicable = true AND r.isVerified = true  THEN 'must_reverify'
               WHEN r.isApplicable = true                          THEN 'must_verify'
               ELSE 'not_affected'
           END AS scope_category
    ORDER BY scope_category, a.hasID, r.hasID
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                rows = [record.data() for record in session.run(query, project_ids=project_ids)]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    grouped: dict[str, list] = {"must_reverify": [], "must_verify": [], "not_affected": []}
    for row in rows:
        cat = row.get("scope_category", "not_affected")
        grouped.setdefault(cat, []).append({
            "req_id": row["req_id"],
            "req_name": row["req_name"],
            "adr_id": row["adr_id"],
            "projects": row["projects"],
        })

    return json.dumps({
        "project_ids_in_scope": project_ids,
        "must_reverify_count": len(grouped["must_reverify"]),
        "must_verify_count": len(grouped["must_verify"]),
        "not_affected_count": len(grouped["not_affected"]),
        "scope": grouped,
    }, indent=2)


@mcp.tool()
def write_change_impact_report(
    change_description: str,
    affected_requirement_ids: list[str],
    affected_project_ids: list[str],
    risk_summary: str,
) -> str:
    """Create a ChangeImpactReport node in Neo4j linked to all affected requirements and projects."""
    if not change_description.strip():
        return json.dumps({"error": "change_description must not be empty."}, indent=2)

    ts = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S%f")
    report_id = f"CIR-{ts}"

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                session.run("""
                    MERGE (cir:ChangeImpactReport {hasID: $cir_id})
                    SET cir.changeDescription = $change_description,
                        cir.riskSummary = $risk_summary,
                        cir.createdAt = datetime(),
                        cir.affectedRequirementCount = $req_count,
                        cir.affectedProjectCount = $proj_count
                """,
                    cir_id=report_id,
                    change_description=change_description,
                    risk_summary=risk_summary,
                    req_count=len(affected_requirement_ids),
                    proj_count=len(affected_project_ids),
                )

                for req_id in affected_requirement_ids:
                    session.run("""
                        MATCH (cir:ChangeImpactReport {hasID: $cir_id})
                        OPTIONAL MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
                        WITH cir, r WHERE r IS NOT NULL
                        MERGE (cir)-[:affectsRequirement]->(r)
                    """, cir_id=report_id, req_id=req_id)

                for proj_id in affected_project_ids:
                    session.run("""
                        MATCH (cir:ChangeImpactReport {hasID: $cir_id})
                        OPTIONAL MATCH (p:Project {projectID: $proj_id})
                        WITH cir, p WHERE p IS NOT NULL
                        MERGE (cir)-[:affectsProject]->(p)
                    """, cir_id=report_id, proj_id=proj_id)

    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    return json.dumps({
        "status": "created",
        "report_id": report_id,
        "change_description": change_description,
        "affected_requirement_count": len(affected_requirement_ids),
        "affected_project_count": len(affected_project_ids),
        "risk_summary": risk_summary,
    }, indent=2)


@mcp.tool()
def get_change_impact_reports() -> str:
    """Return all ChangeImpactReport nodes, newest first."""
    query = """
    MATCH (cir:ChangeImpactReport)
    OPTIONAL MATCH (cir)-[:affectsRequirement]->(r:ExtractedEssentialRequirement)
    OPTIONAL MATCH (cir)-[:affectsProject]->(p:Project)
    RETURN cir.hasID AS report_id,
           cir.changeDescription AS change_description,
           cir.riskSummary AS risk_summary,
           toString(cir.createdAt) AS created_at,
           cir.affectedRequirementCount AS req_count,
           cir.affectedProjectCount AS proj_count,
           collect(DISTINCT r.hasID) AS requirement_ids,
           collect(DISTINCT p.projectID) AS project_ids
    ORDER BY cir.createdAt DESC
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                rows = [record.data() for record in session.run(query)]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    return json.dumps({"report_count": len(rows), "reports": rows}, indent=2)


# ── Phase 6: RL / feedback tools ──────────────────────────────────────────────

@mcp.tool()
def record_feedback(
    requirement_id: str,
    project_id: str,
    action: str,
    reward: float,
) -> str:
    """Record a human-feedback event for an inferred recommendation.

    action must be one of: confirmed, rejected, modified, ignored.
    Writes a FeedbackEvent node to Neo4j and updates the RL agent.
    Use the REWARD_* constants: confirmed=1.0, rejected=-1.0, modified=0.5, ignored=-0.3.

    When action is 'rejected' and the stored confidence was >0.8, the penalty
    PENALTY_OVERCONFIDENT=-2.0 is applied automatically — do not pass it manually.
    The FeedbackEvent node records overconfidencePenaltyApplied=true for audit.

    promote_inferred_link and reject_inferred_link record feedback themselves (with the
    reviewer); do not also call record_feedback for a decision made through them.
    """
    valid_actions = {"confirmed", "rejected", "modified", "ignored"}
    if action not in valid_actions:
        return json.dumps({"error": f"action must be one of {sorted(valid_actions)}."}, indent=2)

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                with session.begin_transaction() as tx:
                    feedback = _record_feedback_internal(tx, requirement_id, project_id, action, reward)
                    tx.commit()
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    _rl_update(action, feedback["reward_applied"], state=feedback["inference_state"])

    return json.dumps({
        "status": "recorded",
        "feedback_id": feedback["feedback_id"],
        "requirement_id": requirement_id,
        "project_id": project_id,
        "action": action,
        "reward_applied": feedback["reward_applied"],
        "overconfidence_penalty_applied": feedback["overconfidence_penalty_applied"],
        "inference_state": feedback["inference_state"],
    }, indent=2)


@mcp.tool()
def get_feedback_stats() -> str:
    """Return feedback statistics: total events, average reward, breakdown by action, and 5 most recent events."""
    summary_query = """
    MATCH (fe:FeedbackEvent)
    RETURN count(fe) AS total,
           avg(fe.reward) AS avg_reward
    """
    breakdown_query = """
    MATCH (fe:FeedbackEvent)
    RETURN fe.action AS action,
           count(fe) AS event_count,
           avg(fe.reward) AS avg_reward
    ORDER BY event_count DESC
    """
    recent_query = """
    MATCH (fe:FeedbackEvent)
    RETURN fe.hasID AS id,
           fe.requirementID AS req_id,
           fe.projectID AS proj_id,
           fe.action AS action,
           fe.reward AS reward,
           fe.inferenceState AS inference_state,
           fe.overconfidencePenaltyApplied AS penalty_applied,
           toString(fe.timestamp) AS timestamp
    ORDER BY fe.timestamp DESC
    LIMIT 5
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                summary = session.run(summary_query).single()
                breakdown = [r.data() for r in session.run(breakdown_query)]
                recent = [r.data() for r in session.run(recent_query)]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    return json.dumps({
        "total_events": summary["total"] if summary else 0,
        "average_reward": round(summary["avg_reward"] or 0.0, 4) if summary else 0.0,
        "breakdown_by_action": breakdown,
        "recent_events": recent,
    }, indent=2)


# ── Phase 7: RL policy inspector ──────────────────────────────────────────────

@mcp.tool()
def get_rl_policy() -> str:
    """Report the current RL agent policy for inference confidence-adjustment states.

    Returns a human-readable summary covering:
    - Current exploration rate (epsilon)
    - Q-values and greedy action for each known inference state
    - Total feedback events recorded and average reward
    - Whether the agent has converged (epsilon <= 0.05)
    """
    agent = _load_rl_agent()

    lines: list[str] = ["SR8 RL Policy Report", "=" * 48]

    if agent is None:
        lines.append("RL agent not available — reinforcemnt-learning.py not found.")
        return "\n".join(lines)

    epsilon = agent.config.exploration_rate
    converged = epsilon <= 0.05
    lines.append(f"Exploration rate (epsilon) : {epsilon:.4f}")
    lines.append(f"Converged                  : {'Yes' if converged else 'No'} (threshold: 0.05)")
    lines.append("")

    actions = ["increase_confidence", "keep_confidence", "decrease_confidence"]
    inference_keys = sorted(s for s in _INFERENCE_STATES if s in agent.q_table)
    if not inference_keys:
        lines.append("No inference states in Q-table yet.")
    else:
        lines.append(f"{'State':<38}  {'Greedy action':<24}  Q-values (↑ keep ↓)")
        lines.append("-" * 90)
        for state in inference_keys:
            q = agent.q_table[state]
            q_inc  = q.get("increase_confidence", 0.0)
            q_keep = q.get("keep_confidence", 0.0)
            q_dec  = q.get("decrease_confidence", 0.0)
            greedy = max(actions, key=lambda a: q.get(a, 0.0))
            lines.append(
                f"{state:<38}  {greedy:<24}  "
                f"↑{q_inc:+.3f}  keep{q_keep:+.3f}  ↓{q_dec:+.3f}"
            )

    lines.append("")
    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                row = session.run("""
                    MATCH (fe:FeedbackEvent)
                    RETURN count(fe) AS total, avg(fe.reward) AS avg_reward
                """).single()
                total = row["total"] if row else 0
                avg_r = round(row["avg_reward"] or 0.0, 4) if row else 0.0
        lines.append(f"Total feedback events      : {total}")
        lines.append(f"Average reward             : {avg_r}")
    except Exception as exc:
        lines.append(f"Feedback stats unavailable : {exc}")

    lines.append("")
    lines.append(
        "Recommendation: promote inferred links only when confidence >= 0.6 "
        "and the greedy action is 'keep_confidence' or 'increase_confidence'."
    )

    return "\n".join(lines)


