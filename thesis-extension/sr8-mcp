# ── Similar assigned requirements (shared by the similarity tool and inference) ──

# Name and clause scoring live in similarity.py, shared with scripts/propose-fmea-links.py.
def _load_similarity_module() -> Any:
    spec = _importlib_util.spec_from_file_location(
        "requirement_similarity", Path(__file__).resolve().with_name("similarity.py"),
    )
    module = _importlib_util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


_similarity = _load_similarity_module()
_NAME_STOP_WORDS = _similarity.NAME_STOP_WORDS
_name_words = _similarity.name_words
_clause_parts = _similarity.clause_parts
_clauses_adjacent = _similarity.clauses_adjacent


def _similar_assigned_requirements(session: Any, requirement_id: str) -> dict[str, Any] | None:
    """Score every same-ADR requirement that already has an assignedToProject relationship.

    Candidate set: requirements from the same AustralianDesignRule as requirement_id
    (via hasExternalEssentialRequirement), other than itself, with at least one
    assignedToProject relationship. Each candidate's score is
      clause_adjacent (1 if the two clauseNumber values are adjacent, see
      _clauses_adjacent; 0 otherwise or when unknown)
      + name_overlap (Jaccard overlap of the lower-cased content words of the two
      requirementName values, stop-words removed; 0..1).
    Returns None if the requirement does not exist, otherwise the target's ADR and clause,
    candidate_count (the uncapped size of the candidate set) and all candidates sorted by
    score (highest first, then requirement ID).
    """
    rows = [record.data() for record in session.run("""
        MATCH (target:ExtractedEssentialRequirement {hasID: $req_id})
        OPTIONAL MATCH (a:AustralianDesignRule)-[:hasExternalEssentialRequirement]->(target)
        OPTIONAL MATCH (a)-[:hasExternalEssentialRequirement]->(c:ExtractedEssentialRequirement)
                       -[:assignedToProject]->(p:Project)
        WHERE c.hasID <> $req_id
        RETURN target.requirementName AS target_name,
               target.clauseNumber AS target_clause,
               a.hasID AS adr_id,
               c.hasID AS req_id,
               c.requirementName AS req_name,
               c.clauseNumber AS clause,
               c.isApplicable AS is_applicable,
               collect(DISTINCT p.projectID) AS assigned_projects
    """, req_id=requirement_id)]
    if not rows:
        return None

    first = rows[0]
    target_words = _name_words(first["target_name"])
    candidates = []
    for row in rows:
        if not row["req_id"]:
            continue  # OPTIONAL MATCH found no candidate
        words = _name_words(row["req_name"])
        union = target_words | words
        overlap = len(target_words & words) / len(union) if union else 0.0
        adjacent = _clauses_adjacent(first["target_clause"], row["clause"])
        candidates.append({
            "req_id": row["req_id"],
            "req_name": row["req_name"],
            "clause": row["clause"],
            "is_applicable": row["is_applicable"],
            "assigned_projects": row["assigned_projects"],
            "score": round((1.0 if adjacent else 0.0) + overlap, 4),
            "clause_adjacent": adjacent,
            "name_overlap": round(overlap, 4),
            "shared_words": sorted(target_words & words),
        })
    candidates.sort(key=lambda c: (-c["score"], c["req_id"]))
    return {
        "adr_id": first["adr_id"],
        "source_clause": first["target_clause"],
        "candidate_count": len(candidates),
        "candidates": candidates,
    }


@mcp.tool()
def get_unassigned_requirements(include_reviewed: bool = False) -> str:
    """Call when user asks about gaps, missing assignments, or extending the knowledge base.

    Returns all ExtractedEssentialRequirement nodes that have no assignedToProject relationship.
    Each result lists its existing suggestedProject links under 'suggestions'. By default only
    pending suggestions (no status) are listed; suggestions already promoted, modified or rejected by a
    reviewer are left out unless include_reviewed=True.
    After calling this, call get_similar_assigned_requirements for each result,
    then write_inferred_project_link. Only promote links where confidence >= 0.6.
    """
    query = """
    MATCH (r:ExtractedEssentialRequirement)
    WHERE NOT (r)-[:assignedToProject]->()
    OPTIONAL MATCH (a:AustralianDesignRule)-[:hasExternalEssentialRequirement]->(r)
    OPTIONAL MATCH (a)-[:hasClause]->(c:Clause)
    WITH r, a, collect(DISTINCT c.hasID) AS clause_ids
    RETURN r.hasID AS req_id,
           r.requirementName AS req_name,
           r.requirementDescription AS req_description,
           r.isApplicable AS is_applicable,
           a.hasID AS adr_id,
           a.hasName AS adr_name,
           clause_ids,
           [(r)-[s:suggestedProject]->(sp:Project)
             WHERE $include_reviewed OR s.status IS NULL
             | {project_id: sp.projectID, confidence: s.confidence, status: s.status}] AS suggestions
    ORDER BY adr_id, req_id
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                rows = [record.data() for record in session.run(query, include_reviewed=include_reviewed)]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    return json.dumps({
        "unassigned_count": len(rows),
        "unassigned_requirements": rows,
    }, indent=2)


@mcp.tool()
def get_similar_assigned_requirements(requirement_id: str) -> str:
    """Rank requirements from the same ADR that already have project assignments.

    Candidates are the other requirements of the same AustralianDesignRule that have at
    least one assignedToProject relationship. Each gets score = clause_adjacent +
    name_overlap: clause_adjacent is 1 when the two clause numbers have the same depth and
    parent and their last parts differ by at most 1 (e.g. 5.2.7 and 5.2.8), otherwise 0
    (null when a clause number is not stored); name_overlap is the Jaccard overlap of the
    lower-cased content words of the two requirement names, stop-words removed (0 to 1).
    Returns the top 5 by score with their components and assigned projects, and
    candidate_count, the number of all candidates (the same count the inference state uses).
    """
    if not requirement_id.strip():
        return json.dumps({"error": "requirement_id must not be empty"}, indent=2)

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                result = _similar_assigned_requirements(session, requirement_id)
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    if result is None:
        return json.dumps({"error": f"Requirement '{requirement_id}' not found."}, indent=2)
    top = result["candidates"][:5]
    return json.dumps({
        "source_requirement_id": requirement_id,
        "adr_id": result["adr_id"],
        "source_clause": result["source_clause"],
        "candidate_count": result["candidate_count"],
        "similar_count": result["candidate_count"],
        "shown": len(top),
        "similar_requirements": top,
        "scoring": "score = clause_adjacent (0/1) + name_overlap (Jaccard of content words, 0-1)",
    }, indent=2)


def _write_inferred_project_link(
    requirement_id: str,
    project_id: str,
    confidence: float,
    reasoning: str,
    resubmit: bool = False,
) -> str:
    """Write a suggestedProject relationship from an unassigned requirement to a project.

    NEVER creates assignedToProject — only suggestedProject. The caller's confidence is
    nudged by the RL agent's contextual policy (Problem B) before being stored. Stored on
    the relationship: baseConfidence (the caller's value), confidence (after adjustment),
    rlAction (the action the agent chose: increase/keep/decrease_confidence, ±0.1 or 0)
    and inferenceState, so the reviewer's feedback later credits exactly that action in
    that state.

    The state is inference_<strong|weak>_<yes|no>_<high|mid|low>: strong if the best
    same-ADR assigned neighbour (get_similar_assigned_requirements' score: clause adjacency
    + name overlap) scores at least EVIDENCE_SCORE_THRESHOLD (0.5); yes if the candidate
    project already holds at least one assignedToProject requirement from the same ADR;
    and the band of the caller's confidence (high > 0.7, mid > 0.4, low <= 0.4).

    A suggestion a reviewer has promoted, modified or rejected is never changed:
    - Requirement already assignedToProject to this project: nothing is written;
      returns status 'already_assigned' with the edge's source.
    - Only reviewed suggestions exist for the pair: nothing is written; returns status
      'previously_reviewed' with the latest decision (status, reviewed_by, reviewed_at,
      rejection_reason). With resubmit=True a second suggestedProject relationship is
      created instead, with resubmissionOf set to the reviewed suggestion's inferredAt.
    - A pending suggestion (no status) exists: it is updated in place after saving
      previousConfidence, previousReasoning and incrementing revisionCount.
    - Requirement assigned to a different project: the suggestion is written and the
      response includes a warning.

    Before anything is written the relationship is checked against the schema layer
    (_validate_against_schema with labels(r) and labels(p)); if suggestedProject is not
    declared for those labels, or the schema is not loaded, nothing is written. Written
    suggestions store schemaValidated = true and schemaCheckedAt, and the response
    includes schema_validation.
    """
    if not requirement_id.strip() or not project_id.strip():
        return json.dumps({"error": "requirement_id and project_id must not be empty."}, indent=2)
    if not 0.0 <= confidence <= 1.0:
        return json.dumps({"error": "confidence must be between 0.0 and 1.0."}, indent=2)

    # Decide what may be written before consulting the RL agent.
    assignments_query = """
    MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
    MATCH (target:Project {projectID: $project_id})
    OPTIONAL MATCH (r)-[a:assignedToProject]->(p:Project)
    RETURN p.projectID AS assigned_project, a.source AS source,
           labels(r) AS source_labels, labels(target) AS target_labels
    """
    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                with session.begin_transaction() as tx:
                    assignments = [record.data() for record in tx.run(
                        assignments_query, req_id=requirement_id, project_id=project_id,
                    )]
                    suggestions = _suggestions_for_pair(tx, requirement_id, project_id)
                    schema_ok, schema_reason = (False, "")
                    if assignments:
                        schema_ok, schema_reason = _validate_against_schema(
                            "suggestedProject",
                            assignments[0].get("source_labels") or [],
                            assignments[0].get("target_labels") or [],
                            tx=tx,
                        )
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    if not assignments:
        return json.dumps({"error": "Requirement or Project not found."}, indent=2)

    same_project = [a for a in assignments if a["assigned_project"] == project_id]
    if same_project:
        return json.dumps({
            "status": "already_assigned",
            "req_id": requirement_id,
            "project_id": project_id,
            "source": same_project[0]["source"],
            "message": "Requirement is already assignedToProject to this project; no suggestion written.",
        }, indent=2)

    other_projects = sorted({
        a["assigned_project"] for a in assignments
        if a["assigned_project"] and a["assigned_project"] != project_id
    })
    warning = (
        f"Requirement is already assignedToProject to {', '.join(other_projects)}; "
        "this suggestion would add a further project."
        if other_projects else None
    )

    pending = [s for s in suggestions if s.get("status") is None]
    previous = _latest_decision(suggestions)
    resubmission_of = None
    if pending:
        write_mode = "revised"
    elif previous is not None:
        if not resubmit:
            return json.dumps({
                "status": "previously_reviewed",
                "req_id": requirement_id,
                "project_id": project_id,
                "previous_decision": previous,
                "message": (
                    "A reviewer already decided on this suggestion; it was not modified. "
                    "Pass resubmit=True to submit a new suggestion alongside it."
                ),
            }, indent=2)
        write_mode = "resubmitted"
        reviewed = [s for s in suggestions if s.get("status") is not None]
        resubmission_of = max(reviewed, key=lambda s: s.get("reviewed_at") or "").get("inferred_at")
    else:
        write_mode = "created"

    schema_validation = {"ok": schema_ok, "reason": schema_reason}
    if not schema_ok:
        return json.dumps({
            "error": f"Schema validation failed; nothing written. {schema_reason}",
            "schema_validation": schema_validation,
        }, indent=2)

    # FIX 1: gather context to compute the state before calling the agent, from the same
    # helper as get_similar_assigned_requirements: the best neighbour's score decides the
    # evidence, and the candidates' assigned projects decide the project feature.
    candidate_count = 0
    best_neighbour: dict[str, Any] | None = None
    project_has_same_adr = False
    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                similar = _similar_assigned_requirements(session, requirement_id)
                if similar:
                    candidate_count = similar["candidate_count"]
                    best_neighbour = similar["candidates"][0] if similar["candidates"] else None
                    project_has_same_adr = any(
                        project_id in c["assigned_projects"] for c in similar["candidates"]
                    )
    except Exception:
        pass
    best_neighbour_score = best_neighbour["score"] if best_neighbour else 0.0

    infer_state = _inference_state(best_neighbour_score, project_has_same_adr, confidence)
    adjusted_confidence, rl_action = _rl_adjust_confidence(confidence, infer_state)

    if write_mode == "revised":
        write_query = """
        MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
              -[rel:suggestedProject]->(p:Project {projectID: $project_id})
        WHERE rel.status IS NULL
        SET rel.previousConfidence = rel.confidence,
            rel.previousReasoning  = rel.reasoning,
            rel.revisionCount      = coalesce(rel.revisionCount, 0) + 1
        SET rel.confidence     = $confidence,
            rel.baseConfidence = $base_confidence,
            rel.rlAction       = $rl_action,
            rel.reasoning      = $reasoning,
            rel.inferredBy     = 'Ollama-MCP',
            rel.inferredAt     = datetime(),
            rel.inferenceState = $inference_state,
            rel.schemaValidated = true,
            rel.schemaCheckedAt = datetime()
        RETURN r.hasID AS req_id, p.projectID AS project_id, rel.revisionCount AS revision_count
        """
    else:
        # CREATE, not MERGE: a reviewed suggestion for the pair is left untouched.
        write_query = """
        MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
        MATCH (p:Project {projectID: $project_id})
        WHERE size([(r)-[x:suggestedProject]->(p) WHERE x.status IS NULL | x]) = 0
        CREATE (r)-[rel:suggestedProject]->(p)
        SET rel.confidence     = $confidence,
            rel.baseConfidence = $base_confidence,
            rel.rlAction       = $rl_action,
            rel.reasoning      = $reasoning,
            rel.inferredBy     = 'Ollama-MCP',
            rel.inferredAt     = datetime(),
            rel.inferenceState = $inference_state,
            rel.resubmissionOf = $resubmission_of,
            rel.schemaValidated = true,
            rel.schemaCheckedAt = datetime()
        RETURN r.hasID AS req_id, p.projectID AS project_id, rel.revisionCount AS revision_count
        """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                with session.begin_transaction() as tx:
                    row = tx.run(
                        write_query,
                        req_id=requirement_id,
                        project_id=project_id,
                        confidence=adjusted_confidence,
                        base_confidence=confidence,
                        rl_action=rl_action,
                        reasoning=reasoning,
                        inference_state=infer_state,
                        resubmission_of=resubmission_of,
                    ).single()
                    if row is None:
                        raise RuntimeError("Suggestion state changed during the write; nothing written. Retry.")
                    tx.commit()
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    return json.dumps({
        "status": "written",
        "write_mode": write_mode,
        "req_id": row["req_id"],
        "project_id": row["project_id"],
        "original_confidence": confidence,
        "adjusted_confidence": adjusted_confidence,
        "rl_action": rl_action,
        "inference_state": infer_state,
        "best_neighbour_score": best_neighbour_score,
        "best_neighbour_id": best_neighbour["req_id"] if best_neighbour else None,
        "candidate_count": candidate_count,
        "project_has_same_adr": project_has_same_adr,
        "reasoning": reasoning,
        "revision_count": row["revision_count"],
        "resubmission_of": str(resubmission_of) if resubmission_of is not None else None,
        "warning": warning,
        "schema_validation": schema_validation,
    }, indent=2)


def write_inferred_project_link(
    requirement_id: str,
    project_id: str,
    confidence: float,
    reasoning: str,
    resubmit: bool = False,
) -> str:
    raw = _write_inferred_project_link(requirement_id, project_id, confidence, reasoning, resubmit)
    _log_inference("suggest", raw, {
        "requirement_id": requirement_id, "project_id": project_id,
        "confidence": confidence, "resubmit": resubmit,
    })
    return raw


# The MCP tool is the logging wrapper, described by the implementation's docstring
# (set before registration because FastMCP reads it then).
write_inferred_project_link.__doc__ = _write_inferred_project_link.__doc__
write_inferred_project_link = mcp.tool()(write_inferred_project_link)


@mcp.tool()
def get_inferred_links(include_reviewed: bool = False) -> str:
    """Return suggestedProject relationships sorted by confidence (highest first).

    By default only pending suggestions (no status) are returned. Suggestions a reviewer
    has promoted, modified or rejected keep their status, reviewedBy, reviewedAt and (for rejections)
    rejectionReason; pass include_reviewed=True to include them.

    Each entry includes a 'recommended' flag (true if confidence >= 0.6) and a
    'warning' field for low-confidence suggestions that require careful review.
    """
    query = """
    MATCH (r:ExtractedEssentialRequirement)-[rel:suggestedProject]->(p:Project)
    WHERE $include_reviewed OR rel.status IS NULL
    OPTIONAL MATCH (a:AustralianDesignRule)-[:hasExternalEssentialRequirement]->(r)
    RETURN r.hasID AS req_id,
           r.requirementName AS req_name,
           p.projectID AS project_id,
           p.projectName AS project_name,
           rel.confidence AS confidence,
           rel.reasoning AS reasoning,
           rel.inferredBy AS inferred_by,
           toString(rel.inferredAt) AS inferred_at,
           rel.inferenceState AS inference_state,
           rel.status AS status,
           rel.reviewedBy AS reviewed_by,
           toString(rel.reviewedAt) AS reviewed_at,
           rel.rejectionReason AS rejection_reason,
           a.hasID AS adr_id
    ORDER BY rel.confidence DESC
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                rows = [record.data() for record in session.run(query, include_reviewed=include_reviewed)]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    # FIX 2: annotate each link with operational guidance.
    for row in rows:
        conf = row.get("confidence") or 0.0
        row["recommended"] = conf >= 0.6
        row["warning"] = "low confidence — review carefully" if conf < 0.4 else None

    return json.dumps({"inferred_link_count": len(rows), "inferred_links": rows}, indent=2)


# Not an MCP tool: only people may review suggestions (see scripts/review-links.py
# and the typed "confirm link" / "reject link" commands in ollama-mcp).
@_logs_inference("promote")
def promote_inferred_link(
    requirement_id: str,
    project_id: str,
    reviewer: str,
    action: str = "confirmed",
) -> str:
    """Confirm a pending suggestedProject relationship as an assignedToProject relationship.

    Not an MCP tool, so the LLM cannot confirm its own suggestions. Called by
    scripts/review-links.py and by the typed "confirm link <REQ> -> <PROJECT>" command
    in ollama-mcp.

    reviewer (required, non-empty) identifies the person who reviewed the suggestion.
    action must be 'confirmed' (reward 1.0) or 'modified' (reward 0.5).

    In one transaction this:
    1. records a FeedbackEvent (with reviewer) using the confidence and inference state
       stored on the suggestion, and
    2. creates assignedToProject with source='inferred', promotedAt, promotedBy=reviewer,
       promotedFromConfidence, inferenceReasoning, inferredBy, inferredAt and
       inferenceState copied from the suggestion. If an assignedToProject relationship
       already exists it is left unchanged and already_assigned=true is returned.
    3. keeps the suggestedProject relationship and sets status='promoted', reviewedAt
       and reviewedBy on it.
    The RL agent is then updated. Do not call record_feedback for the same decision.
    Only the pending suggestion (no status) is promoted; earlier reviewed suggestions
    for the same pair are never touched. If there is no pending suggestion, nothing is
    written and the earlier decision is returned.
    """
    if not requirement_id.strip() or not project_id.strip():
        return json.dumps({"error": "requirement_id and project_id must not be empty."}, indent=2)
    reviewer = reviewer.strip()
    if not reviewer:
        return json.dumps({"error": "reviewer must not be empty."}, indent=2)
    rewards = {"confirmed": REWARD_CONFIRMED, "modified": REWARD_MODIFIED}
    if action not in rewards:
        return json.dumps({"error": f"action must be one of {sorted(rewards)}."}, indent=2)

    promote_query = """
    MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
          -[suggested:suggestedProject]->(p:Project {projectID: $project_id})
    WHERE suggested.status IS NULL
    OPTIONAL MATCH (r)-[existing:assignedToProject]->(p)
    WITH r, p, suggested, count(existing) > 0 AS already_assigned
    MERGE (r)-[confirmed:assignedToProject]->(p)
    ON CREATE SET confirmed.source                 = 'inferred',
                  confirmed.promotedAt             = datetime(),
                  confirmed.promotedBy             = $reviewer,
                  confirmed.promotedFromConfidence = suggested.confidence,
                  confirmed.inferenceReasoning     = suggested.reasoning,
                  confirmed.inferredBy             = suggested.inferredBy,
                  confirmed.inferredAt             = suggested.inferredAt,
                  confirmed.inferenceState         = suggested.inferenceState
    SET suggested.status     = 'promoted',
        suggested.reviewedAt = datetime(),
        suggested.reviewedBy = $reviewer
    RETURN r.hasID AS req_id, p.projectID AS project_id, already_assigned
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                with session.begin_transaction() as tx:
                    feedback = _record_feedback_internal(
                        tx, requirement_id, project_id, action, rewards[action], reviewer=reviewer,
                    )
                    row = tx.run(
                        promote_query, req_id=requirement_id, project_id=project_id, reviewer=reviewer,
                    ).single()
                    if row is None:
                        raise RuntimeError("Pending suggestion changed during the transaction; nothing written.")
                    tx.commit()
    except _FeedbackRefused as refused:
        return json.dumps(refused.payload, indent=2)
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    feedback["rl_updated"] = _rl_update(
        feedback["reward_applied"], feedback["inference_state"], feedback["rl_action"],
    )

    return json.dumps({
        "status": "promoted",
        "req_id": row["req_id"],
        "project_id": row["project_id"],
        "reviewer": reviewer,
        "already_assigned": row["already_assigned"],
        "feedback": feedback,
        "message": (
            "assignedToProject already existed and was left unchanged; suggestion marked promoted."
            if row["already_assigned"] else
            "assignedToProject created with source='inferred'; suggestion kept with status='promoted'."
        ),
    }, indent=2)


# Not an MCP tool: only people may review suggestions (see scripts/review-links.py
# and the typed "confirm link" / "reject link" commands in ollama-mcp).
@_logs_inference("reject")
def reject_inferred_link(requirement_id: str, project_id: str, reviewer: str, reason: str) -> str:
    """Reject a pending suggestedProject relationship.

    Not an MCP tool, so the LLM cannot reject suggestions. Called by
    scripts/review-links.py and by the typed "reject link <REQ> -> <PROJECT> because
    <reason>" command in ollama-mcp.

    reviewer (required, non-empty) identifies the person who reviewed the suggestion;
    reason is stored as rejectionReason.

    In one transaction this records a 'rejected' FeedbackEvent (reward -1.0, or
    PENALTY_OVERCONFIDENT=-2.0 when the stored confidence was >0.8) and sets
    status='rejected', reviewedBy, reviewedAt and rejectionReason on the suggestion.
    The suggestion is not deleted. The RL agent is then updated.
    Do not call record_feedback for the same decision. Only the pending suggestion
    (no status) is rejected; if there is none, nothing is written and the earlier
    decision is returned.
    """
    if not requirement_id.strip() or not project_id.strip():
        return json.dumps({"error": "requirement_id and project_id must not be empty."}, indent=2)
    reviewer = reviewer.strip()
    if not reviewer:
        return json.dumps({"error": "reviewer must not be empty."}, indent=2)

    reject_query = """
    MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
          -[suggested:suggestedProject]->(p:Project {projectID: $project_id})
    WHERE suggested.status IS NULL
    SET suggested.status          = 'rejected',
        suggested.reviewedAt      = datetime(),
        suggested.reviewedBy      = $reviewer,
        suggested.rejectionReason = $reason
    RETURN r.hasID AS req_id, p.projectID AS project_id
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                with session.begin_transaction() as tx:
                    feedback = _record_feedback_internal(
                        tx, requirement_id, project_id, "rejected", REWARD_REJECTED, reviewer=reviewer,
                    )
                    row = tx.run(
                        reject_query, req_id=requirement_id, project_id=project_id,
                        reviewer=reviewer, reason=reason,
                    ).single()
                    if row is None:
                        raise RuntimeError("Pending suggestion changed during the transaction; nothing written.")
                    tx.commit()
    except _FeedbackRefused as refused:
        return json.dumps(refused.payload, indent=2)
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    feedback["rl_updated"] = _rl_update(
        feedback["reward_applied"], feedback["inference_state"], feedback["rl_action"],
    )

    return json.dumps({
        "status": "rejected",
        "req_id": row["req_id"],
        "project_id": row["project_id"],
        "reviewer": reviewer,
        "rejection_reason": reason,
        "feedback": feedback,
    }, indent=2)


# Not an MCP tool: only people may review suggestions (see scripts/review-links.py).
@_logs_inference("modify")
def modify_inferred_link(
    requirement_id: str,
    suggested_project_id: str,
    new_project_id: str,
    reviewer: str,
    reason: str = "",
) -> str:
    """Resolve a pending suggestion by assigning the requirement to a different project.

    Not an MCP tool. Called by scripts/review-links.py when the reviewer chooses
    "modify". In one transaction this:
    1. records a 'modified' FeedbackEvent (reward 0.5, with reviewer) against the
       suggested pair, using the confidence and inference state stored on the suggestion;
    2. creates assignedToProject to new_project_id with source='inferred-modified',
       promotedAt, promotedBy=reviewer, promotedFromConfidence, inferenceReasoning,
       inferredBy, inferredAt, inferenceState, modifiedFromProject and
       modificationReason. If that link already exists it is left unchanged and
       already_assigned=true is returned;
    3. keeps the suggestion and sets status='modified', reviewedAt, reviewedBy,
       modifiedTo and modificationReason on it.
    The RL agent is then updated. Only the pending suggestion (no status) is used; if
    there is none, nothing is written and the earlier decision is returned.
    """
    if not requirement_id.strip() or not suggested_project_id.strip() or not new_project_id.strip():
        return json.dumps({"error": "requirement_id, suggested_project_id and new_project_id must not be empty."}, indent=2)
    if new_project_id.strip() == suggested_project_id.strip():
        return json.dumps({"error": "new_project_id equals the suggested project; confirm the suggestion instead."}, indent=2)
    reviewer = reviewer.strip()
    if not reviewer:
        return json.dumps({"error": "reviewer must not be empty."}, indent=2)

    modify_query = """
    MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
          -[suggested:suggestedProject]->(:Project {projectID: $suggested_project_id})
    WHERE suggested.status IS NULL
    MATCH (np:Project {projectID: $new_project_id})
    OPTIONAL MATCH (r)-[existing:assignedToProject]->(np)
    WITH r, np, suggested, count(existing) > 0 AS already_assigned
    MERGE (r)-[confirmed:assignedToProject]->(np)
    ON CREATE SET confirmed.source                 = 'inferred-modified',
                  confirmed.promotedAt             = datetime(),
                  confirmed.promotedBy             = $reviewer,
                  confirmed.promotedFromConfidence = suggested.confidence,
                  confirmed.inferenceReasoning     = suggested.reasoning,
                  confirmed.inferredBy             = suggested.inferredBy,
                  confirmed.inferredAt             = suggested.inferredAt,
                  confirmed.inferenceState         = suggested.inferenceState,
                  confirmed.modifiedFromProject    = $suggested_project_id,
                  confirmed.modificationReason     = $reason
    SET suggested.status             = 'modified',
        suggested.reviewedAt         = datetime(),
        suggested.reviewedBy         = $reviewer,
        suggested.modifiedTo         = $new_project_id,
        suggested.modificationReason = $reason
    RETURN r.hasID AS req_id, np.projectID AS project_id, already_assigned
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                with session.begin_transaction() as tx:
                    feedback = _record_feedback_internal(
                        tx, requirement_id, suggested_project_id, "modified", REWARD_MODIFIED, reviewer=reviewer,
                    )
                    row = tx.run(
                        modify_query, req_id=requirement_id, suggested_project_id=suggested_project_id,
                        new_project_id=new_project_id, reviewer=reviewer, reason=reason,
                    ).single()
                    if row is None:
                        raise RuntimeError(f"Project '{new_project_id}' not found; nothing written.")
                    tx.commit()
    except _FeedbackRefused as refused:
        return json.dumps(refused.payload, indent=2)
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    feedback["rl_updated"] = _rl_update(
        feedback["reward_applied"], feedback["inference_state"], feedback["rl_action"],
    )

    return json.dumps({
        "status": "modified",
        "req_id": row["req_id"],
        "suggested_project_id": suggested_project_id,
        "project_id": row["project_id"],
        "reviewer": reviewer,
        "already_assigned": row["already_assigned"],
        "feedback": feedback,
    }, indent=2)


