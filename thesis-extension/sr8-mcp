# ── RL reward constants ────────────────────────────────────────────────────────
REWARD_CONFIRMED = 1.0
REWARD_REJECTED = -1.0
REWARD_MODIFIED = 0.5
REWARD_IGNORED = -0.3
PENALTY_OVERCONFIDENT = -2.0  # applied automatically when confidence > 0.8 and link was rejected

mcp = FastMCP("sr8-knowledge-mcp")

_PROJECT_ROOT = Path(__file__).resolve().parent.parent
_RL_MODEL_PATH = Path(__file__).resolve().parent / ".rl-model.json"

DEFAULT_DOC_EXTENSIONS = {".md", ".txt", ".csv", ".owl", ".cypher", ".pdf", ".docx"}
WRITE_KEYWORDS = {
    " create ",
    " merge ",
    " delete ",
    " detach ",
    " remove ",
    " set ",
    " drop ",
    " call dbms",
    " call apoc",
    " load csv",
}

# All 12 contextual inference states produced by _inference_state().
_INFERENCE_STATES = [
    f"inference_{ev}_{pop}_{cb}"
    for ev in ("strong", "weak")
    for pop in ("yes", "no")
    for cb in ("high", "mid", "low")
]


# ── Path helpers ───────────────────────────────────────────────────────────────

def _doc_roots() -> list[Path]:
    configured = os.getenv("DOC_ROOTS", "")
    roots: list[Path] = []
    if configured:
        for chunk in configured.split(","):
            p = Path(chunk.strip()).expanduser()
            if p.exists() and p.is_dir():
                roots.append(p)
    if roots:
        return roots
    fallback = [
        _PROJECT_ROOT / "thesis-extraction" / "csv",
        _PROJECT_ROOT / "thesis-extraction" / "Design-Documentation",
        _PROJECT_ROOT / "thesis-extraction" / "PDF",
        _PROJECT_ROOT / "thesis-extraction" / "Documentation",
        _PROJECT_ROOT / "thesis-ontology" / "Documentation",
    ]
    return [p for p in fallback if p.exists() and p.is_dir()]


def _iter_docs() -> list[Path]:
    found: list[Path] = []
    for root in _doc_roots():
        for path in root.rglob("*"):
            if path.is_file() and path.suffix.lower() in DEFAULT_DOC_EXTENSIONS:
                found.append(path)
    return found


def _normalize(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip().lower()


def _normalize_rule_id(rule_id: str) -> tuple[str, list[str]]:
    raw = rule_id.strip().upper().replace(" ", "")
    if raw.startswith("SRP"):
        raw = "ADR" + raw[3:]
    if raw.startswith("ADR") and not raw.startswith("ADR-"):
        raw = raw.replace("ADR", "ADR-", 1)

    m = re.match(r"^ADR-(\d+)$", raw)
    if not m:
        return raw, [raw]

    num = int(m.group(1))
    canonical = f"ADR-{num}"
    variants = [canonical, f"ADR-{num:03d}", f"ADR{num}", f"ADR{num:03d}"]
    dedup: list[str] = []
    for v in variants:
        if v not in dedup:
            dedup.append(v)
    return canonical, dedup


def _extract_text_from_pdf(path: Path) -> str:
    try:
        from pypdf import PdfReader
        reader = PdfReader(str(path))
        parts: list[str] = []
        for page in reader.pages:
            parts.append(page.extract_text() or "")
        text = "\n".join(parts).strip()
        if text:
            return text
    except Exception:
        pass

    ocr_enabled = os.getenv("OCR_ENABLED", "true").lower() == "true"
    if not ocr_enabled:
        return ""

    try:
        from pdf2image import convert_from_path
        import pytesseract
        dpi = int(os.getenv("OCR_DPI", "200"))
        pages = convert_from_path(str(path), dpi=dpi)
        ocr_parts: list[str] = []
        for image in pages:
            ocr_parts.append(pytesseract.image_to_string(image))
        return "\n".join(ocr_parts).strip()
    except Exception:
        return ""


def _extract_text_from_docx(path: Path) -> str:
    try:
        from docx import Document
        doc = Document(str(path))
        return "\n".join(p.text for p in doc.paragraphs if p.text).strip()
    except Exception:
        return ""


def _read_text_content(path: Path) -> str:
    suffix = path.suffix.lower()
    if suffix == ".pdf":
        return _extract_text_from_pdf(path)
    if suffix == ".docx":
        return _extract_text_from_docx(path)
    try:
        return path.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return ""


def _line_hits(path: Path, query: str, max_hits: int) -> list[dict[str, Any]]:
    q = _normalize(query)
    results: list[dict[str, Any]] = []
    text = _read_text_content(path)
    if not text:
        return results
    for i, line in enumerate(text.splitlines(), start=1):
        norm_line = _normalize(line)
        if q and q in norm_line:
            results.append({"line": i, "snippet": line.strip()[:500]})
            if len(results) >= max_hits:
                break
    return results


def _csv_row_hits(path: Path, query: str, max_hits: int) -> list[dict[str, Any]]:
    q = _normalize(query)
    results: list[dict[str, Any]] = []
    if not q:
        return results
    try:
        with path.open("r", encoding="utf-8", errors="ignore", newline="") as f:
            reader = csv.DictReader(f)
            for row_idx, row in enumerate(reader, start=2):
                matched_columns: list[str] = []
                snippets: list[str] = []
                for key, value in row.items():
                    cell = (value or "").strip()
                    if cell and q in _normalize(cell):
                        matched_columns.append(key)
                        snippets.append(cell[:220])
                if matched_columns:
                    results.append({
                        "row": row_idx,
                        "matched_columns": matched_columns,
                        "snippet": " | ".join(snippets)[:500],
                    })
                    if len(results) >= max_hits:
                        break
    except Exception:
        return []
    return results


def _find_adr_csv_file(adr_number: int) -> Path | None:
    pattern = re.compile(rf"^ADR0*{adr_number}-Requirements\.csv$", re.IGNORECASE)
    for p in _iter_docs():
        if p.suffix.lower() == ".csv" and pattern.match(p.name):
            return p
    return None


def _neo4j_driver():
    uri = os.getenv("NEO4J_URI", "bolt://localhost:7687")
    user = os.getenv("NEO4J_USER", "neo4j")
    password = os.getenv("NEO4J_PASSWORD", "password")
    return GraphDatabase.driver(uri, auth=(user, password))


def _cypher_is_read_only(cypher: str) -> bool:
    normalized = f" {_normalize(cypher)} "
    if not normalized.strip().startswith("match"):
        return False
    return not any(keyword in normalized for keyword in WRITE_KEYWORDS)


def _extraction_root() -> Path:
    configured = os.getenv("EXTRACTION_ROOT", "").strip()
    if configured:
        p = Path(configured).expanduser()
        if p.exists() and p.is_dir():
            return p
    return _PROJECT_ROOT / "thesis-extraction"


def _load_adr_mapping() -> tuple[dict[str, Any], dict[str, list[dict]]]:
    """Load ADR mapping from JSON (primary) and CSV (fallback/comprehensive).

    Returns (mapping_json, csv_rows_by_adr) where:
    - mapping_json is the full ADR-mapping.json payload
    - csv_rows_by_adr maps adr_id -> list of rows from CSV
    """
    base_dir = Path(__file__).resolve().parent
    mapping_json: dict[str, Any] = {}
    csv_by_adr: dict[str, list[dict]] = {}

    json_path = base_dir / "ADR-mapping.json"
    if json_path.exists():
        try:
            with json_path.open("r", encoding="utf-8") as f:
                mapping_json = json.load(f)
        except Exception:
            pass

    csv_path = base_dir / "ADR-mapping.csv"
    if csv_path.exists():
        try:
            with csv_path.open("r", encoding="utf-8", errors="ignore", newline="") as f:
                reader = csv.DictReader(f)
                for row in reader:
                    adr = row.get("adr_id", "").strip()
                    if adr:
                        csv_by_adr.setdefault(adr, []).append(row)
        except Exception:
            pass

    return mapping_json, csv_by_adr


# ── RL agent bridge ────────────────────────────────────────────────────────────

_rl_agent: Any = None
_rl_agent_loaded: bool = False
_rl_transition_cls: Any = None
_rl_replay_buffer: Any = None  # FIX 4: module-level ReplayBuffer (capacity 500)


# FIX 5: file-locked save to prevent concurrent write corruption between
# sr8-mcp and ollama-mcp which share the same .rl-model.json.
def _safe_agent_save(agent: Any, path: Path) -> None:
    lock_path = str(path) + ".lock"
    with open(lock_path, "w") as lock_file:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX)
            agent.save(path)
        finally:
            fcntl.flock(lock_file, fcntl.LOCK_UN)


def _load_rl_agent() -> Any:
    global _rl_agent, _rl_agent_loaded, _rl_transition_cls, _rl_replay_buffer
    if _rl_agent_loaded:
        return _rl_agent
    _rl_agent_loaded = True
    module_path = Path(__file__).resolve().with_name("reinforcemnt-learning.py")
    if not module_path.exists():
        return None
    try:
        spec = _importlib_util.spec_from_file_location("rl_module", module_path)
        if not spec or not spec.loader:
            return None
        module = _importlib_util.module_from_spec(spec)
        spec.loader.exec_module(module)

        _rl_transition_cls = getattr(module, "Transition")
        q_cls = getattr(module, "QLearningAgent")
        replay_cls = getattr(module, "ReplayBuffer")

        # FIX 4: initialise the live replay buffer (capacity 500).
        _rl_replay_buffer = replay_cls(capacity=500)

        _rl_agent = q_cls.load(_RL_MODEL_PATH) if _RL_MODEL_PATH.exists() else q_cls()

        # FIX 6: merge pre-trained inference priors if no inference states exist yet.
        has_inference = any(s in _rl_agent.q_table for s in _INFERENCE_STATES)
        if not has_inference:
            train_inference_fn = getattr(module, "train_inference_agent")
            pretrained = train_inference_fn()
            for state, actions in pretrained.q_table.items():
                if state.startswith("inference_"):
                    _rl_agent.q_table[state] = dict(actions)
            _safe_agent_save(_rl_agent, _RL_MODEL_PATH)

    except Exception:
        _rl_agent = None
    return _rl_agent


# FIX 1: helper that maps observable context to one of 12 state strings.
def _inference_state(similar_count: int, adr_populated: bool, base_confidence: float) -> str:
    evidence = "strong" if similar_count >= 3 else "weak"
    populated = "yes" if adr_populated else "no"
    conf_band = "high" if base_confidence > 0.7 else "mid" if base_confidence > 0.4 else "low"
    return f"inference_{evidence}_{populated}_{conf_band}"


# FIX 1: now accepts the contextual state instead of always using "inference".
def _rl_adjust_confidence(base: float, state: str) -> float:
    """Nudge a confidence score using the Q-learning agent's policy for the given contextual state."""
    agent = _load_rl_agent()
    if not agent:
        return base
    actions = ["increase_confidence", "keep_confidence", "decrease_confidence"]
    try:
        action = agent.choose_action(state, actions)
        if action == "increase_confidence":
            return min(1.0, base + 0.1)
        if action == "decrease_confidence":
            return max(0.0, base - 0.1)
    except Exception:
        pass
    return base


# FIX 1 + FIX 4 + FIX 5: accepts state, runs replay, uses locked save.
def _rl_update(feedback_action: str, reward: float, state: str = "inference") -> None:
    """Update the RL agent from a human-feedback event, run a replay batch, and persist."""
    agent = _load_rl_agent()
    if not agent or _rl_transition_cls is None:
        return
    try:
        actions = ["increase_confidence", "keep_confidence", "decrease_confidence"]
        rl_map = {
            "confirmed": "increase_confidence",
            "rejected": "decrease_confidence",
            "modified": "keep_confidence",
            "ignored": "decrease_confidence",
        }
        rl_action = rl_map.get(feedback_action, "keep_confidence")
        t = _rl_transition_cls(state, rl_action, reward, state, actions)
        agent.update(t)

        # FIX 4: accumulate in the live replay buffer; batch-update when full enough.
        if _rl_replay_buffer is not None:
            _rl_replay_buffer.push(t)
            if len(_rl_replay_buffer) >= 32:
                agent.replay(_rl_replay_buffer, batch_size=32)

        agent.decay_exploration()
        _safe_agent_save(agent, _RL_MODEL_PATH)  # FIX 5
    except Exception:
        pass


def _record_feedback_internal(
    tx: Any,
    requirement_id: str,
    project_id: str,
    action: str,
    reward: float,
    reviewer: str | None = None,
) -> dict[str, Any]:
    """Write a FeedbackEvent inside an open Neo4j transaction.

    Shared by record_feedback, promote_inferred_link and reject_inferred_link.
    Reads confidence and inferenceState from the suggestedProject relationship first,
    so callers must invoke it before they change that relationship. When action is
    'rejected' and the stored confidence was >0.8, PENALTY_OVERCONFIDENT replaces the
    reward. The caller commits the transaction and then calls _rl_update with the
    returned reward_applied and inference_state.
    """
    # FIX 3: fetch stored confidence and inference state from the suggestedProject
    # relationship so we can auto-apply the overconfidence penalty.
    state_row = tx.run("""
        MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
              -[rel:suggestedProject]->(p:Project {projectID: $proj_id})
        RETURN rel.confidence AS confidence,
               rel.inferenceState AS inference_state
    """, req_id=requirement_id, proj_id=project_id).single()
    stored_confidence: float | None = state_row["confidence"] if state_row else None
    inferred_state: str = (state_row["inference_state"] if state_row else None) or "inference"

    actual_reward = reward
    overconfidence_penalty_applied = False
    if action == "rejected" and stored_confidence is not None and stored_confidence > 0.8:
        actual_reward = PENALTY_OVERCONFIDENT
        overconfidence_penalty_applied = True

    ts = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S%f")
    fe_id = f"FE-{ts}"

    tx.run("""
        MERGE (fe:FeedbackEvent {hasID: $feid})
        SET fe.requirementID = $req_id,
            fe.projectID = $proj_id,
            fe.action = $action,
            fe.reward = $reward,
            fe.inferenceState = $inference_state,
            fe.overconfidencePenaltyApplied = $penalty_applied,
            fe.reviewer = $reviewer,
            fe.timestamp = datetime()
    """,
        feid=fe_id,
        req_id=requirement_id,
        proj_id=project_id,
        action=action,
        reward=actual_reward,
        inference_state=inferred_state,
        penalty_applied=overconfidence_penalty_applied,
        reviewer=reviewer,
    )

    tx.run("""
        MATCH (fe:FeedbackEvent {hasID: $feid})
        OPTIONAL MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
        WITH fe, r WHERE r IS NOT NULL
        MERGE (fe)-[:recordedFor]->(r)
    """, feid=fe_id, req_id=requirement_id)

    tx.run("""
        MATCH (fe:FeedbackEvent {hasID: $feid})
        OPTIONAL MATCH (p:Project {projectID: $proj_id})
        WITH fe, p WHERE p IS NOT NULL
        MERGE (fe)-[:recordedFor]->(p)
    """, feid=fe_id, proj_id=project_id)

    return {
        "feedback_id": fe_id,
        "action": action,
        "reward_applied": actual_reward,
        "overconfidence_penalty_applied": overconfidence_penalty_applied,
        "inference_state": inferred_state,
    }


def _pending_suggestion_status(tx: Any, requirement_id: str, project_id: str) -> tuple[bool, str | None]:
    """Return (exists, status) for the suggestedProject relationship between a requirement and a project."""
    row = tx.run("""
        MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
              -[s:suggestedProject]->(p:Project {projectID: $proj_id})
        RETURN s.status AS status
    """, req_id=requirement_id, proj_id=project_id).single()
    if not row:
        return False, None
    return True, row["status"]


# ── Document tools ─────────────────────────────────────────────────────────────

@mcp.tool()
def list_documents(limit: int = 200) -> str:
    """List indexed local documents available to the model."""
    docs = _iter_docs()[: max(1, min(limit, 500))]
    payload = {
        "count": len(docs),
        "roots": [str(r) for r in _doc_roots()],
        "documents": [str(p) for p in docs],
    }
    return json.dumps(payload, indent=2)


@mcp.tool()
def run_extraction_for_requirements(dry_run: bool = False) -> str:
    """Run ADR extraction pipeline before requirements analysis."""
    root = _extraction_root()
    script = root / "Scripts" / "run-extraction.py"
    if not script.exists():
        return json.dumps({"error": f"extraction script not found: {script}"}, indent=2)

    uri = os.getenv("NEO4J_URI", "bolt://localhost:7687")
    user = os.getenv("NEO4J_USER", "neo4j")
    password = os.getenv("NEO4J_PASSWORD", "password")

    cmd = ["python3", str(script), "--only", "adrs", "--uri", uri, "--user", user, "--password", password]
    if dry_run:
        cmd.append("--dry-run")

    try:
        proc = subprocess.run(cmd, cwd=str(root), capture_output=True, text=True, timeout=600)
    except Exception as exc:
        return json.dumps({"error": f"failed to run extraction: {exc}"}, indent=2)

    return json.dumps({
        "command": cmd,
        "cwd": str(root),
        "exit_code": proc.returncode,
        "stdout": proc.stdout[-12000:],
        "stderr": proc.stderr[-12000:],
        "ok": proc.returncode == 0,
    }, indent=2)


@mcp.tool()
def search_local_documents(query: str, max_files: int = 8, max_hits_per_file: int = 5) -> str:
    """Keyword search over local docs and CSV/Ontology files."""
    query = query.strip()
    if not query:
        return json.dumps({"error": "query must not be empty"}, indent=2)

    files = _iter_docs()
    ranked: list[dict[str, Any]] = []

    for path in files:
        if path.suffix.lower() == ".csv":
            hits = _csv_row_hits(path, query, max_hits_per_file)
            pointer_type = "row"
        else:
            hits = _line_hits(path, query, max_hits_per_file)
            pointer_type = "line"

        if hits:
            ranked.append({
                "path": str(path),
                "file": path.name,
                "pointer_type": pointer_type,
                "hits": hits,
                "hit_count": len(hits),
            })

    ranked.sort(key=lambda x: x["hit_count"], reverse=True)
    payload = {
        "query": query,
        "roots": [str(r) for r in _doc_roots()],
        "matches": ranked[: max(1, min(max_files, 30))],
    }
    return json.dumps(payload, indent=2)


@mcp.tool()
def suggest_requirement_sources(requirement_text: str, max_files: int = 10, max_hits_per_file: int = 3) -> str:
    """Suggest exact source files (with row/line evidence) for a requirement text."""
    requirement_text = requirement_text.strip()
    if not requirement_text:
        return json.dumps({"error": "requirement_text must not be empty"}, indent=2)

    files = _iter_docs()
    ranked: list[dict[str, Any]] = []

    for path in files:
        if path.suffix.lower() == ".csv":
            hits = _csv_row_hits(path, requirement_text, max_hits_per_file)
            pointer_type = "row"
        else:
            hits = _line_hits(path, requirement_text, max_hits_per_file)
            pointer_type = "line"

        if hits:
            ranked.append({
                "path": str(path),
                "file": path.name,
                "pointer_type": pointer_type,
                "hits": hits,
                "hit_count": len(hits),
                "source_priority": (
                    1 if "/csv/" in str(path).lower()
                    else 2 if "/design-documentation/" in str(path).lower()
                    else 3 if "/pdf/" in str(path).lower()
                    else 4
                ),
            })

    ranked.sort(key=lambda x: (x["source_priority"], -x["hit_count"], x["path"]))
    payload = {
        "requirement_text": requirement_text,
        "source_order": ["CSV", "Design-Documentation", "PDF", "Other"],
        "matches": ranked[: max(1, min(max_files, 50))],
    }
    return json.dumps(payload, indent=2)


@mcp.tool()
def read_document(path: str, start_line: int = 1, end_line: int = 200) -> str:
    """Read a local document by absolute path with line range."""
    target = Path(path).expanduser()
    if not target.exists() or not target.is_file():
        return json.dumps({"error": f"file not found: {target}"}, indent=2)

    root_ok = any(str(target).startswith(str(root)) for root in _doc_roots())
    if not root_ok:
        return json.dumps({"error": "path is outside DOC_ROOTS"}, indent=2)

    start_line = max(1, start_line)
    end_line = max(start_line, end_line)

    text = _read_text_content(target)
    if not text:
        return json.dumps({"error": f"failed to read file: {target}"}, indent=2)

    lines = text.splitlines()
    chunk = lines[start_line - 1 : end_line]
    payload = {
        "path": str(target),
        "start_line": start_line,
        "end_line": end_line,
        "content": "\n".join(chunk),
    }
    return json.dumps(payload, indent=2)


@mcp.tool()
def query_knowledge_graph(cypher: str, limit: int = 50) -> str:
    """Run a read-only Cypher query against the local Neo4j knowledge graph."""
    if not _cypher_is_read_only(cypher):
        return json.dumps({
            "error": "only read-only Cypher is allowed",
            "hint": "Use MATCH/RETURN queries without write clauses",
        }, indent=2)

    safe_limit = max(1, min(limit, 500))
    if " limit " not in f" {_normalize(cypher)} ":
        cypher = f"{cypher.rstrip()} LIMIT {safe_limit}"

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                result = session.run(cypher)
                rows = [record.data() for record in result]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    return json.dumps({"row_count": len(rows), "rows": rows}, indent=2)


@mcp.tool()
def get_adr_requirements(adr_id: str, limit: int = 30) -> str:
    """Fetch extracted essential requirements linked to an ADR ID (e.g., ADR-43).

    Returns per-requirement evidence refs and a plain-text list. If the graph
    has no rows for this ADR, falls back to ADR-mapping.json / ADR-mapping.csv
    so requirements are still surfaced from extraction outputs.
    """
    if not adr_id.strip():
        return json.dumps({"error": "adr_id must not be empty"}, indent=2)

    normalized_id, adr_id_variants = _normalize_rule_id(adr_id)

    query = """
    MATCH (a:AustralianDesignRule)
    WHERE a.hasID IN $adr_id_variants
    MATCH (a)-[rel]->(r)
    WHERE type(rel) IN ['hasExternalEssentialRequirement', 'hasExternalRecommendedRequirement']
    OPTIONAL MATCH (r)-[:hasClause]->(c:Clause)
    RETURN a.hasID AS adr,
           type(rel) AS relationship,
           labels(r) AS requirement_labels,
           r.requirementDescription AS requirement,
           collect(distinct c.hasID) AS clauses
    ORDER BY requirement
    LIMIT $limit
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                result = session.run(
                    query,
                    adr_id_variants=adr_id_variants,
                    limit=max(1, min(limit, 200)),
                )
                rows = [record.data() for record in result]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    # Build a per-requirement export with inline evidence pointers.
    requirements_export: list[dict] = []
    for idx, row in enumerate(rows, start=1):
        req_text = (row.get("requirement") or "").strip()
        entry: dict = {
            "index": idx,
            "requirement": req_text,
            "labels": row.get("requirement_labels"),
            "clauses": row.get("clauses"),
            "evidence": None,
        }
        if req_text:
            try:
                suggestion = json.loads(
                    suggest_requirement_sources(req_text, max_files=1, max_hits_per_file=1)
                )
                matches = suggestion.get("matches", [])
                if matches:
                    top = matches[0]
                    hits = top.get("hits", [])
                    if hits:
                        first_hit = hits[0]
                        if top.get("pointer_type") == "row" and "row" in first_hit:
                            entry["evidence"] = f"{top.get('path', '')} | row {first_hit['row']}"
                        elif top.get("pointer_type") == "line" and "line" in first_hit:
                            entry["evidence"] = f"{top.get('path', '')} | line {first_hit['line']}"
            except Exception:
                entry["evidence"] = None
        requirements_export.append(entry)

    # Try to locate the source CSV and count rows for a nicer summary.
    csv_count = None
    csv_file = None
    evidence_refs: list[str] = []
    m = re.match(r"^ADR-(\d+)$", normalized_id)
    if m:
        csv_path = _find_adr_csv_file(int(m.group(1)))
        if csv_path and csv_path.exists():
            csv_file = str(csv_path)
            try:
                with csv_path.open("r", encoding="utf-8", errors="ignore", newline="") as f:
                    csv_count = sum(1 for _ in csv.DictReader(f))
                if csv_count and csv_count > 0:
                    evidence_refs.append(f"{csv_file} | row 2")
            except Exception:
                csv_count = None

    graph_count = len(rows)
    preferred_count = csv_count if csv_count is not None else graph_count

    requirements_plain: list[str] = [
        f"{e['index']}. {e['requirement']}" + (f" (evidence: {e['evidence']})" if e.get("evidence") else "")
        for e in requirements_export
    ]

    # If the graph returned nothing, fall back to ADR-mapping files.
    if graph_count == 0:
        try:
            mapping_json, csv_by_adr = _load_adr_mapping()
            fallback_export: list[dict] = []
            fallback_sources: list[str] = []

            if mapping_json:
                for idx, mr in enumerate(mapping_json.get("rows", []), start=1):
                    if mr.get("adr_id", "") in adr_id_variants:
                        ev = (
                            f"{mr.get('source_file', '')} | row {mr.get('source_pointer', '')}"
                            if mr.get("source_file") and mr.get("source_pointer")
                            else None
                        )
                        fallback_export.append({
                            "index": idx,
                            "requirement": mr.get("requirement_text", "").strip(),
                            "labels": [],
                            "clauses": mr.get("clause_ids"),
                            "evidence": ev,
                        })
                if fallback_export:
                    fallback_sources.append(str(Path(__file__).resolve().parent / "ADR-mapping.json"))

            if not fallback_export and csv_by_adr:
                idx = 0
                for adr_var in adr_id_variants:
                    for mr in csv_by_adr.get(adr_var, []):
                        idx += 1
                        ev = (
                            f"{mr.get('source_file', '')} | row {mr.get('source_pointer', '')}"
                            if mr.get("source_file") and mr.get("source_pointer")
                            else None
                        )
                        fallback_export.append({
                            "index": idx,
                            "requirement": mr.get("requirement_text", "").strip(),
                            "labels": [],
                            "clauses": mr.get("clause_ids"),
                            "evidence": ev,
                        })
                if fallback_export:
                    fallback_sources.append(str(Path(__file__).resolve().parent / "ADR-mapping.csv"))

            if fallback_export:
                requirements_export = fallback_export
                requirements_plain = [
                    f"{e['index']}. {e['requirement']}" + (f" (evidence: {e['evidence']})" if e.get("evidence") else "")
                    for e in requirements_export
                ]
                csv_file = fallback_sources[0] if fallback_sources else None
                csv_count = len(requirements_export)
                preferred_count = csv_count
                evidence_refs = list(dict.fromkeys(
                    e["evidence"] for e in requirements_export if e.get("evidence")
                ))
        except Exception:
            pass

    return json.dumps({
        "adr_id": normalized_id,
        "adr_id_variants": adr_id_variants,
        "count": preferred_count,
        "graph_count": graph_count,
        "csv_count": csv_count,
        "csv_file": csv_file,
        "requirements": rows,
        "requirements_export": requirements_export,
        "requirements_plain": requirements_plain,
        "evidence_refs": evidence_refs,
    }, indent=2)


@mcp.tool()
def adr_mapping_stats(top_n: int = 10, adr_id: str | None = None) -> str:
    """Return statistics from ADR-mapping.json and CSV:
    - total_requirements, total_adrs
    - counts_by_adr (truncated to top_n)
    - rows for a specific adr_id from both JSON and CSV if provided
    """
    mapping_json, csv_by_adr = _load_adr_mapping()

    if not mapping_json and not csv_by_adr:
        return json.dumps({"error": "No mapping files found (ADR-mapping.json or ADR-mapping.csv)"}, indent=2)

    counts_by_adr = mapping_json.get("counts_by_adr", {})
    sorted_counts = sorted(counts_by_adr.items(), key=lambda kv: kv[1], reverse=True)
    top = sorted_counts[: max(0, min(top_n, len(sorted_counts)))]

    result: dict[str, Any] = {
        "total_requirements": mapping_json.get("total_requirements", sum(len(v) for v in csv_by_adr.values())),
        "total_adrs": mapping_json.get("total_adrs", len(csv_by_adr)),
        "top_adrs": [{"adr": k, "count": v} for k, v in top],
        "counts_by_adr": dict(sorted_counts[:100]),
        "sources": [s for s in [
            "ADR-mapping.json" if mapping_json else None,
            "ADR-mapping.csv" if csv_by_adr else None,
        ] if s],
    }

    if adr_id:
        norm, variants = _normalize_rule_id(adr_id)
        json_rows = [r for r in mapping_json.get("rows", []) if r.get("adr_id") in variants]
        csv_rows: list[dict] = []
        for v in variants:
            csv_rows.extend(csv_by_adr.get(v, []))
        result["adr_rows_json"] = json_rows
        result["adr_rows_csv"] = csv_rows
        result["adr_count_json"] = len(json_rows)
        result["adr_count_csv"] = len(csv_rows)
        result["adr_count_total"] = len(json_rows) + len(csv_rows)

    return json.dumps(result, indent=2)


@mcp.tool()
def summarize_document(path: str, start_line: int = 1, end_line: int = 200) -> str:
    """Read a document using existing readers and return an extractive summary.

    Returns the requested lines, a short extractive summary (first 3 sentences),
    and a character count. OCR fallback is used for scanned PDFs.
    """
    target = Path(path).expanduser()
    if not target.exists() or not target.is_file():
        return json.dumps({"error": f"file not found: {target}"}, indent=2)

    roots_ok = any(str(target).startswith(str(r)) for r in _doc_roots())
    if not roots_ok:
        return json.dumps({"error": "path is outside DOC_ROOTS"}, indent=2)

    text = _read_text_content(target)
    if not text:
        return json.dumps({"error": "failed to read file or empty content"}, indent=2)

    lines = text.splitlines()
    start_line = max(1, start_line)
    end_line = max(start_line, end_line)
    chunk = lines[start_line - 1 : end_line]
    content = "\n".join(chunk)

    sentences = re.split(r'(?<=[.!?])\s+', content)
    summary = " ".join(s.strip() for s in sentences if s.strip())[:1000]

    return json.dumps({
        "path": str(target),
        "start_line": start_line,
        "end_line": end_line,
        "content": content,
        "summary": summary,
        "char_count": len(content),
    }, indent=2)


@mcp.tool()
def extraction_report(dry_run: bool = False) -> str:
    """Run the extraction pipeline and return a compact parsed summary.

    Wraps run_extraction_for_requirements and extracts processed filenames
    from stdout so callers get a clean report instead of raw output.
    """
    try:
        raw = run_extraction_for_requirements(dry_run=dry_run)
        result = json.loads(raw)
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    stdout = result.get("stdout") or ""
    files: list[str] = []
    for line in stdout.splitlines():
        line = line.strip()
        if line.startswith("📄"):
            parts = line.split()
            if len(parts) >= 2:
                files.append(parts[1])
        if "-Requirements.csv" in line:
            hit = re.search(r"[\w\-]+-Requirements\.csv", line)
            if hit:
                files.append(hit.group(0))

    return json.dumps({
        "command": result.get("command"),
        "cwd": result.get("cwd"),
        "exit_code": result.get("exit_code"),
        "ok": result.get("ok", False),
        "stderr_tail": (result.get("stderr") or "")[-2000:],
        "stdout_tail": stdout[-2000:],
        "processed_files": files,
    }, indent=2)


@mcp.tool()
def search_keywords(keywords: list[str], max_files: int = 50, max_hits_per_file: int = 10) -> str:
    """Search local documents for a list of keywords and aggregate results.

    Returns a mapping of keyword -> matches (same format as search_local_documents).
    """
    if not isinstance(keywords, list):
        return json.dumps({"error": "keywords must be a list of strings"}, indent=2)

    aggregated: dict[str, Any] = {"keywords": {}, "total_matches": 0}
    for kw in keywords:
        try:
            payload = json.loads(search_local_documents(kw, max_files=max_files, max_hits_per_file=max_hits_per_file))
            matches = payload.get("matches", []) if isinstance(payload, dict) else []
            aggregated["keywords"][kw] = {"match_count": len(matches), "matches": matches}
            aggregated["total_matches"] += len(matches)
        except Exception:
            aggregated["keywords"][kw] = {"match_count": 0, "matches": []}

    return json.dumps(aggregated, indent=2)


