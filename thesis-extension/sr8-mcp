# Confidence bands for the inference state, highest first: a confidence belongs to the
# first band whose lower bound it exceeds, otherwise to "low".
#   high: > 0.7    mid: > 0.4 and <= 0.7    low: <= 0.4
CONFIDENCE_BANDS: tuple[tuple[str, float], ...] = (("high", 0.7), ("mid", 0.4))

# "Strong" evidence: the best same-ADR assigned neighbour scores at least this much in
# _similar_assigned_requirements (clause_adjacent 0/1 + name_overlap 0..1, so 0..2).
# Chosen on the 45 currently unassigned requirements: 0.5 makes 31/45 (69%) strong, inside
# the 20-80% band; the earlier rule (>= 3 same-ADR assigned requirements) made 45/45 strong.
EVIDENCE_SCORE_THRESHOLD = 0.5

# Problem B actions; the adjustment each applies to the caller's confidence.
_RL_ACTIONS = ["increase_confidence", "keep_confidence", "decrease_confidence"]
_RL_ACTION_DELTA = {"increase_confidence": 0.1, "keep_confidence": 0.0, "decrease_confidence": -0.1}

# All 12 contextual inference states produced by _inference_state().
_INFERENCE_STATES = [
    f"inference_{ev}_{pop}_{cb}"
    for ev in ("strong", "weak")
    for pop in ("yes", "no")
    for cb in ("high", "mid", "low")
]


# ── Path helpers ───────────────────────────────────────────────────────────────

def _doc_roots() -> list[Path]:
    configured = os.getenv("DOC_ROOTS", "")
    roots: list[Path] = []
    if configured:
        for chunk in configured.split(","):
            p = Path(chunk.strip()).expanduser()
            if p.exists() and p.is_dir():
                roots.append(p)
    if roots:
        return roots
    fallback = [
        _PROJECT_ROOT / "thesis-extraction" / "csv",
        _PROJECT_ROOT / "thesis-extraction" / "Design-Documentation",
        _PROJECT_ROOT / "thesis-extraction" / "PDF",
        _PROJECT_ROOT / "thesis-extraction" / "Documentation",
        _PROJECT_ROOT / "thesis-ontology" / "Documentation",
    ]
    return [p for p in fallback if p.exists() and p.is_dir()]


def _iter_docs() -> list[Path]:
    found: list[Path] = []
    for root in _doc_roots():
        for path in root.rglob("*"):
            if path.is_file() and path.suffix.lower() in DEFAULT_DOC_EXTENSIONS:
                found.append(path)
    return found


def _normalize(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip().lower()


def _normalize_rule_id(rule_id: str) -> tuple[str, list[str]]:
    raw = rule_id.strip().upper().replace(" ", "")
    if raw.startswith("SRP"):
        raw = "ADR" + raw[3:]
    if raw.startswith("ADR") and not raw.startswith("ADR-"):
        raw = raw.replace("ADR", "ADR-", 1)

    m = re.match(r"^ADR-(\d+)$", raw)
    if not m:
        return raw, [raw]

    num = int(m.group(1))
    canonical = f"ADR-{num}"
    variants = [canonical, f"ADR-{num:03d}", f"ADR{num}", f"ADR{num:03d}"]
    dedup: list[str] = []
    for v in variants:
        if v not in dedup:
            dedup.append(v)
    return canonical, dedup


def _extract_text_from_pdf(path: Path) -> str:
    try:
        from pypdf import PdfReader
        reader = PdfReader(str(path))
        parts: list[str] = []
        for page in reader.pages:
            parts.append(page.extract_text() or "")
        text = "\n".join(parts).strip()
        if text:
            return text
    except Exception:
        pass

    ocr_enabled = os.getenv("OCR_ENABLED", "true").lower() == "true"
    if not ocr_enabled:
        return ""

    try:
        from pdf2image import convert_from_path
        import pytesseract
        dpi = int(os.getenv("OCR_DPI", "200"))
        pages = convert_from_path(str(path), dpi=dpi)
        ocr_parts: list[str] = []
        for image in pages:
            ocr_parts.append(pytesseract.image_to_string(image))
        return "\n".join(ocr_parts).strip()
    except Exception:
        return ""


def _extract_text_from_docx(path: Path) -> str:
    try:
        from docx import Document
        doc = Document(str(path))
        return "\n".join(p.text for p in doc.paragraphs if p.text).strip()
    except Exception:
        return ""


def _read_text_content(path: Path) -> str:
    suffix = path.suffix.lower()
    if suffix == ".pdf":
        return _extract_text_from_pdf(path)
    if suffix == ".docx":
        return _extract_text_from_docx(path)
    try:
        return path.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return ""


def _line_hits(path: Path, query: str, max_hits: int) -> list[dict[str, Any]]:
    q = _normalize(query)
    results: list[dict[str, Any]] = []
    text = _read_text_content(path)
    if not text:
        return results
    for i, line in enumerate(text.splitlines(), start=1):
        norm_line = _normalize(line)
        if q and q in norm_line:
            results.append({"line": i, "snippet": line.strip()[:500]})
            if len(results) >= max_hits:
                break
    return results


def _csv_row_hits(path: Path, query: str, max_hits: int) -> list[dict[str, Any]]:
    q = _normalize(query)
    results: list[dict[str, Any]] = []
    if not q:
        return results
    try:
        with path.open("r", encoding="utf-8", errors="ignore", newline="") as f:
            reader = csv.DictReader(f)
            for row_idx, row in enumerate(reader, start=2):
                matched_columns: list[str] = []
                snippets: list[str] = []
                for key, value in row.items():
                    cell = (value or "").strip()
                    if cell and q in _normalize(cell):
                        matched_columns.append(key)
                        snippets.append(cell[:220])
                if matched_columns:
                    results.append({
                        "row": row_idx,
                        "matched_columns": matched_columns,
                        "snippet": " | ".join(snippets)[:500],
                    })
                    if len(results) >= max_hits:
                        break
    except Exception:
        return []
    return results


def _find_adr_csv_file(adr_number: int) -> Path | None:
    pattern = re.compile(rf"^ADR0*{adr_number}-Requirements\.csv$", re.IGNORECASE)
    for p in _iter_docs():
        if p.suffix.lower() == ".csv" and pattern.match(p.name):
            return p
    return None


def _neo4j_driver():
    uri = os.getenv("NEO4J_URI", "bolt://localhost:7687")
    user = os.getenv("NEO4J_USER", "neo4j")
    password = os.getenv("NEO4J_PASSWORD", "password")
    return GraphDatabase.driver(uri, auth=(user, password))


def _cypher_is_read_only(cypher: str) -> bool:
    normalized = f" {_normalize(cypher)} "
    if not normalized.strip().startswith("match"):
        return False
    return not any(keyword in normalized for keyword in WRITE_KEYWORDS)


def _extraction_root() -> Path:
    configured = os.getenv("EXTRACTION_ROOT", "").strip()
    if configured:
        p = Path(configured).expanduser()
        if p.exists() and p.is_dir():
            return p
    return _PROJECT_ROOT / "thesis-extraction"


def _load_adr_mapping() -> tuple[dict[str, Any], dict[str, list[dict]]]:
    """Load ADR mapping from JSON (primary) and CSV (fallback/comprehensive).

    Returns (mapping_json, csv_rows_by_adr) where:
    - mapping_json is the full ADR-mapping.json payload
    - csv_rows_by_adr maps adr_id -> list of rows from CSV
    """
    base_dir = Path(__file__).resolve().parent
    mapping_json: dict[str, Any] = {}
    csv_by_adr: dict[str, list[dict]] = {}

    json_path = base_dir / "ADR-mapping.json"
    if json_path.exists():
        try:
            with json_path.open("r", encoding="utf-8") as f:
                mapping_json = json.load(f)
        except Exception:
            pass

    csv_path = base_dir / "ADR-mapping.csv"
    if csv_path.exists():
        try:
            with csv_path.open("r", encoding="utf-8", errors="ignore", newline="") as f:
                reader = csv.DictReader(f)
                for row in reader:
                    adr = row.get("adr_id", "").strip()
                    if adr:
                        csv_by_adr.setdefault(adr, []).append(row)
        except Exception:
            pass

    return mapping_json, csv_by_adr


# ── Inference event log ────────────────────────────────────────────────────────

def _log_inference(event: str, raw_result: str, args: dict[str, Any]) -> None:
    """Append one line to logs/inference.jsonl for a suggestion write or review event.

    Built from the call's arguments and its JSON result, so refusals (schema failure,
    already reviewed, ...) are logged too. Logging failures never affect the call.
    """
    try:
        try:
            out = json.loads(raw_result)
        except Exception:
            out = {"error": "result was not JSON"}
        feedback = out.get("feedback") if isinstance(out.get("feedback"), dict) else out
        schema_validation = out.get("schema_validation")
        if schema_validation is None and "schema_validated" in feedback:
            schema_validation = {"stored_on_suggestion": feedback.get("schema_validated")}
        record = {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "event": event,
            "requirement_id": args.get("requirement_id"),
            "project_id": args.get("project_id") or args.get("suggested_project_id"),
            "new_project_id": args.get("new_project_id"),
            "action": args.get("action"),
            "outcome": out.get("status") or ("error" if "error" in out else None),
            "error": out.get("error"),
            "base_confidence": out.get("original_confidence", feedback.get("base_confidence", args.get("confidence"))),
            "adjusted_confidence": out.get("adjusted_confidence", feedback.get("stored_confidence")),
            "inference_state": out.get("inference_state", feedback.get("inference_state")),
            "rl_action": out.get("rl_action", feedback.get("rl_action")),
            "reward": feedback.get("reward_applied"),
            "overconfidence_penalty_applied": feedback.get("overconfidence_penalty_applied"),
            "rl_updated": feedback.get("rl_updated"),
            "reviewer": args.get("reviewer"),
            "reason": args.get("reason"),
            "schema_validation": schema_validation,
            "write_mode": out.get("write_mode"),
            "previous_decision": out.get("previous_decision"),
        }
        _INFERENCE_LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with _INFERENCE_LOG_PATH.open("a", encoding="utf-8") as f:
            f.write(json.dumps(record, ensure_ascii=False, default=str) + "\n")
    except Exception:
        pass


def _logs_inference(event: str):
    """Decorator for review functions (not MCP tools): log each call via _log_inference."""
    def decorate(fn):
        signature = inspect.signature(fn)

        @functools.wraps(fn)
        def wrapper(*args: Any, **kwargs: Any) -> str:
            raw = fn(*args, **kwargs)
            try:
                bound = signature.bind(*args, **kwargs)
                bound.apply_defaults()
                _log_inference(event, raw, dict(bound.arguments))
            except Exception:
                pass
            return raw
        return wrapper
    return decorate


# ── RL agent bridge ────────────────────────────────────────────────────────────

_rl_agent: Any = None
_rl_agent_loaded: bool = False
_rl_transition_cls: Any = None
_rl_replay_buffer: Any = None  # FIX 4: module-level ReplayBuffer (capacity 500)
_rl_locked_update: Any = None  # reinforcemnt-learning.locked_update

# FIX 5: .rl-model.json is shared with ollama-mcp and scripts/review-links.py, each
# holding its own in-memory agent. Every save goes through locked_update, which
# reloads the latest file under <file>.lock and applies only this process's change,
# so no process overwrites another's updates with a stale copy.


def _load_rl_agent() -> Any:
    global _rl_agent, _rl_agent_loaded, _rl_transition_cls, _rl_replay_buffer, _rl_locked_update
    if _rl_agent_loaded:
        return _rl_agent
    _rl_agent_loaded = True
    module_path = Path(__file__).resolve().with_name("reinforcemnt-learning.py")
    if not module_path.exists():
        return None
    try:
        spec = _importlib_util.spec_from_file_location("rl_module", module_path)
        if not spec or not spec.loader:
            return None
        module = _importlib_util.module_from_spec(spec)
        # The module must be in sys.modules while it runs: its dataclasses (with
        # "from __future__ import annotations") look their module up there, and
        # without it exec_module raises AttributeError, leaving RL disabled.
        sys.modules[spec.name] = module
        spec.loader.exec_module(module)

        _rl_transition_cls = getattr(module, "Transition")
        replay_cls = getattr(module, "ReplayBuffer")
        problem = getattr(module, "PROBLEM_B")
        locked_update = getattr(module, "locked_update")
        # sr8-mcp only ever reads and writes Problem B (inference confidence) in the model file.
        _rl_locked_update = lambda path, apply: locked_update(path, apply, problem)  # noqa: E731

        # FIX 4: initialise the live replay buffer (capacity 500).
        _rl_replay_buffer = replay_cls(capacity=500)

        _rl_agent = getattr(module, "load_problem")(_RL_MODEL_PATH, problem)

        # FIX 6: merge pre-trained inference priors if no inference states exist yet.
        has_inference = any(s in _rl_agent.q_table for s in _INFERENCE_STATES)
        if not has_inference:
            train_inference_fn = getattr(module, "train_inference_agent")
            pretrained = train_inference_fn()
            priors = {
                state: dict(actions)
                for state, actions in pretrained.q_table.items()
                if state.startswith("inference_")
            }

            def merge_priors(agent: Any) -> None:
                # Re-checked on the freshly loaded file: another process may have merged them.
                if not any(s in agent.q_table for s in _INFERENCE_STATES):
                    for state, actions in priors.items():
                        agent.q_table[state] = dict(actions)

            _rl_agent = _rl_locked_update(_RL_MODEL_PATH, merge_priors)

    except Exception:
        _rl_agent = None
    return _rl_agent


def _confidence_band(confidence: float) -> str:
    for band, lower_bound in CONFIDENCE_BANDS:
        if confidence > lower_bound:
            return band
    return "low"


# FIX 1: maps observable context to one of 12 state strings. The three features are
# independent: any evidence level can occur with or without the candidate project
# already holding a requirement from the same ADR.
def _inference_state(best_neighbour_score: float, project_has_same_adr: bool, base_confidence: float) -> str:
    """Return inference_<strong|weak>_<yes|no>_<high|mid|low>.

    best_neighbour_score: the highest score among the requirement's same-ADR assigned
        candidates in _similar_assigned_requirements (0 if there are none); strong if
        >= EVIDENCE_SCORE_THRESHOLD, i.e. there is a close neighbour.
    project_has_same_adr: the candidate project already holds at least one
        assignedToProject requirement from the same ADR (yes/no).
    base_confidence: the caller's confidence, banded by CONFIDENCE_BANDS.
    """
    evidence = "strong" if best_neighbour_score >= EVIDENCE_SCORE_THRESHOLD else "weak"
    project = "yes" if project_has_same_adr else "no"
    return f"inference_{evidence}_{project}_{_confidence_band(base_confidence)}"


# FIX 1: now accepts the contextual state instead of always using "inference".
def _rl_adjust_confidence(base: float, state: str) -> tuple[float, str | None]:
    """Choose a Problem B action for the state and apply it to the caller's confidence.

    Returns (adjusted_confidence, action). The action must be stored with the suggestion
    (rlAction) so that the reviewer's feedback later credits exactly this action.
    action is None when the RL agent is unavailable, in which case base is returned.
    """
    agent = _load_rl_agent()
    if not agent:
        return base, None
    try:
        action = agent.choose_action(state, _RL_ACTIONS)
    except Exception:
        return base, None
    return min(1.0, max(0.0, base + _RL_ACTION_DELTA[action])), action


# FIX 1 + FIX 4 + FIX 5: credits the stored action, runs replay, uses locked save.
def _rl_update(reward: float, state: str | None, rl_action: str | None) -> bool:
    """Update Q(state, rl_action) from a reviewer's decision, run a replay batch, and persist.

    state and rl_action are the inferenceState and rlAction stored on the suggestion when
    it was written, so the reward credits the action the agent actually took. Problem B is
    single-step (discount_factor 0.0): Q <- Q + alpha * (reward - Q).

    The update is applied to the latest saved model (via locked_update), not to this
    process's possibly stale in-memory copy, which is then replaced by the result.
    Returns True if the Q-table was updated; False if the suggestion has no stored
    action (written before rlAction existed, or while RL was unavailable) or RL is off.
    """
    global _rl_agent
    if not state or rl_action not in _RL_ACTIONS:
        return False
    agent = _load_rl_agent()
    if not agent or _rl_transition_cls is None or _rl_locked_update is None:
        return False
    try:
        t = _rl_transition_cls(state, rl_action, reward, state, [])  # one-step: no next state

        # FIX 4: accumulate in the live replay buffer; batch-update when full enough.
        if _rl_replay_buffer is not None:
            _rl_replay_buffer.push(t)

        def apply(latest: Any) -> None:
            latest.update(t)
            if _rl_replay_buffer is not None and len(_rl_replay_buffer) >= 32:
                latest.replay(_rl_replay_buffer, batch_size=32)
            latest.decay_exploration()

        _rl_agent = _rl_locked_update(_RL_MODEL_PATH, apply)  # FIX 5
        return True
    except Exception:
        return False


def _validate_against_schema(
    rel_type: str,
    source_labels: list[str],
    target_labels: list[str],
    tx: Any = None,
) -> tuple[bool, str]:
    """Check a relationship against the schema layer loaded by thesis-ontology/scripts/import.py.

    Looks up (:SchemaRelationship {name: rel_type}) and checks its sourceLabel and
    targetLabel (copied from relationships.csv) against the actual node labels. A declared
    label matches if it is one of the node's labels or an ancestor of one of them via
    SUBCLASS_OF* between SchemaLabel nodes. 'A|B' declares alternatives; 'All' matches any
    node. Fails closed: if no SchemaRelationship nodes exist, or rel_type is not declared,
    the result is (False, reason). Pass tx to run inside an existing transaction.
    Returns (ok, reason).
    """
    if tx is None:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                return _validate_against_schema(rel_type, source_labels, target_labels, tx=session)

    total = tx.run("MATCH (s:SchemaRelationship) RETURN count(s) AS total").single()
    if not total or not total["total"]:
        return False, (
            "Schema layer is not loaded (no SchemaRelationship nodes); run "
            "thesis-ontology/scripts/import.py before writing relationships."
        )

    declared = tx.run("""
        MATCH (r:SchemaRelationship {name: $rel_type})
        RETURN r.sourceLabel AS source_label, r.targetLabel AS target_label
    """, rel_type=rel_type).single()
    if not declared:
        return False, f"Relationship type '{rel_type}' is not declared in the schema layer."

    matched = {}
    for side, declared_labels, node_labels in (
        ("source", declared["source_label"], source_labels),
        ("target", declared["target_label"], target_labels),
    ):
        allowed = {label.strip() for label in (declared_labels or "").split("|") if label.strip()}
        if not allowed:
            return False, f"Relationship type '{rel_type}' has no {side} label declared in the schema layer."
        if "All" in allowed:
            matched[side] = "All"
            continue
        ancestors_row = tx.run("""
            MATCH (l:SchemaLabel) WHERE l.name IN $labels
            MATCH (l)-[:SUBCLASS_OF*1..]->(a:SchemaLabel)
            RETURN collect(DISTINCT a.name) AS ancestors
        """, labels=list(node_labels)).single()
        ancestors = set(ancestors_row["ancestors"]) if ancestors_row else set()
        hits = allowed & (set(node_labels) | ancestors)
        if not hits:
            return False, (
                f"'{rel_type}' requires {side} label {declared_labels}; node has labels "
                f"{sorted(node_labels)} (ancestors: {sorted(ancestors) or 'none'})."
            )
        matched[side] = ", ".join(sorted(hits))

    return True, (
        f"'{rel_type}' declared in schema: source matches {matched['source']}, "
        f"target matches {matched['target']}."
    )


class _FeedbackRefused(Exception):
    """Raised inside a transaction when a pair has no pending suggestion; payload is the JSON error to return."""

    def __init__(self, payload: dict[str, Any]) -> None:
        super().__init__(payload.get("error", "feedback refused"))
        self.payload = payload


def _suggestions_for_pair(tx: Any, requirement_id: str, project_id: str) -> list[dict[str, Any]]:
    """Return every suggestedProject relationship between a requirement and a project.

    A pair can have one pending suggestion (no status) and any number of reviewed ones
    (status 'promoted', 'modified' or 'rejected', e.g. after write_inferred_project_link(resubmit=True)).
    """
    result = tx.run("""
        MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
              -[s:suggestedProject]->(p:Project {projectID: $proj_id})
        RETURN s.status AS status,
               s.confidence AS confidence,
               s.inferenceState AS inference_state,
               s.rlAction AS rl_action,
               s.baseConfidence AS base_confidence,
               s.schemaValidated AS schema_validated,
               s.inferredAt AS inferred_at,
               s.reviewedBy AS reviewed_by,
               toString(s.reviewedAt) AS reviewed_at,
               s.rejectionReason AS rejection_reason
    """, req_id=requirement_id, proj_id=project_id)
    return [record.data() for record in result]


def _latest_decision(suggestions: list[dict[str, Any]]) -> dict[str, Any] | None:
    """Return the most recently reviewed suggestion's decision, or None if none was reviewed."""
    reviewed = [s for s in suggestions if s.get("status") is not None]
    if not reviewed:
        return None
    latest = max(reviewed, key=lambda s: s.get("reviewed_at") or "")
    return {
        "status": latest.get("status"),
        "reviewed_by": latest.get("reviewed_by"),
        "reviewed_at": latest.get("reviewed_at"),
        "rejection_reason": latest.get("rejection_reason"),
    }


def _record_feedback_internal(
    tx: Any,
    requirement_id: str,
    project_id: str,
    action: str,
    reward: float,
    reviewer: str | None = None,
) -> dict[str, Any]:
    """Write a FeedbackEvent inside an open Neo4j transaction.

    Shared by record_feedback, promote_inferred_link, modify_inferred_link and
    reject_inferred_link, none of which is exposed to the LLM as an MCP tool.
    Acts only on the pending suggestedProject relationship (status IS NULL). If the pair
    has no pending suggestion, raises _FeedbackRefused carrying the earlier decision, so
    a decision can never be counted twice and no FeedbackEvent is written.
    Reads confidence, inferenceState and rlAction from the pending suggestion first, so
    callers must invoke it before they change that relationship.

    Reward: the caller's reward (confirmed 1.0, modified 0.5, rejected -1.0), except that
    rejecting a suggestion whose stored (RL-adjusted) confidence was > 0.8 applies
    PENALTY_OVERCONFIDENT = -2.0 instead, recorded as overconfidencePenaltyApplied = true.

    Credit: the reward is for the action the agent actually chose when the suggestion was
    written (rlAction), in the state it was written in (inferenceState); both are returned
    and stored on the FeedbackEvent. The caller commits the transaction and only then
    calls _rl_update(reward_applied, inference_state, rl_action), so a rolled-back
    decision never changes the Q-table.
    """
    suggestions = _suggestions_for_pair(tx, requirement_id, project_id)
    pending = [s for s in suggestions if s.get("status") is None]
    if not pending:
        previous = _latest_decision(suggestions)
        if previous is None:
            raise _FeedbackRefused({
                "error": f"No suggestedProject relationship found between '{requirement_id}' and '{project_id}'.",
            })
        raise _FeedbackRefused({
            "error": (
                f"Suggestion between '{requirement_id}' and '{project_id}' was already reviewed "
                f"(status '{previous['status']}'); feedback not recorded again."
            ),
            "previous_decision": previous,
        })

    # FIX 3: use the stored confidence and inference state from the pending
    # suggestedProject relationship so we can auto-apply the overconfidence penalty.
    stored_confidence: float | None = pending[0].get("confidence")
    inferred_state: str = pending[0].get("inference_state") or "inference"
    rl_action: str | None = pending[0].get("rl_action")

    actual_reward = reward
    overconfidence_penalty_applied = False
    if action == "rejected" and stored_confidence is not None and stored_confidence > 0.8:
        actual_reward = PENALTY_OVERCONFIDENT
        overconfidence_penalty_applied = True

    ts = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S%f")
    fe_id = f"FE-{ts}"

    tx.run("""
        MERGE (fe:FeedbackEvent {hasID: $feid})
        SET fe.requirementID = $req_id,
            fe.projectID = $proj_id,
            fe.action = $action,
            fe.reward = $reward,
            fe.inferenceState = $inference_state,
            fe.overconfidencePenaltyApplied = $penalty_applied,
            fe.rlAction = $rl_action,
            fe.reviewer = $reviewer,
            fe.hasTimestamp = datetime()
    """,
        feid=fe_id,
        req_id=requirement_id,
        proj_id=project_id,
        action=action,
        reward=actual_reward,
        inference_state=inferred_state,
        penalty_applied=overconfidence_penalty_applied,
        rl_action=rl_action,
        reviewer=reviewer,
    )

    tx.run("""
        MATCH (fe:FeedbackEvent {hasID: $feid})
        OPTIONAL MATCH (r:ExtractedEssentialRequirement {hasID: $req_id})
        WITH fe, r WHERE r IS NOT NULL
        MERGE (fe)-[:recordedFor]->(r)
    """, feid=fe_id, req_id=requirement_id)

    tx.run("""
        MATCH (fe:FeedbackEvent {hasID: $feid})
        OPTIONAL MATCH (p:Project {projectID: $proj_id})
        WITH fe, p WHERE p IS NOT NULL
        MERGE (fe)-[:recordedFor]->(p)
    """, feid=fe_id, proj_id=project_id)

    return {
        "feedback_id": fe_id,
        "action": action,
        "reward_applied": actual_reward,
        "overconfidence_penalty_applied": overconfidence_penalty_applied,
        "inference_state": inferred_state,
        "rl_action": rl_action,
        "base_confidence": pending[0].get("base_confidence"),
        "stored_confidence": stored_confidence,
        "schema_validated": pending[0].get("schema_validated"),
    }


