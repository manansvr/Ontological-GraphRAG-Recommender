          -[:assignedToProject]->(p2:Project)-[:belongsToAssembly]->(asm2:Assembly)
    WHERE asm2.hasID <> $assembly_id
    WITH asm2.hasID AS other_assembly,
         asm2.hasName AS other_assembly_name,
         a.hasID AS adr_id,
         collect(DISTINCT {req_id: r.hasID, req_name: r.requirementName}) AS coupling_reqs
    RETURN other_assembly,
           other_assembly_name,
           adr_id,
           coupling_reqs,
           size(coupling_reqs) AS shared_req_count
    ORDER BY shared_req_count DESC
    """

    try:
        with _neo4j_driver() as driver:
