@mcp.tool()
def get_interface_risk_report() -> str:
    """Full interface risk report across all assemblies: shared requirements, ADR sources, and verification mismatches."""
    query = """
    MATCH (asm1:Assembly)<-[:belongsToAssembly]-(p1:Project)
          <-[:assignedToProject]-(r1:ExtractedEssentialRequirement)
          <-[:hasExternalEssentialRequirement]-(a:AustralianDesignRule)
          -[:hasExternalEssentialRequirement]->(r2:ExtractedEssentialRequirement)
          -[:assignedToProject]->(p2:Project)-[:belongsToAssembly]->(asm2:Assembly)
    WHERE asm1.hasID < asm2.hasID
    WITH asm1.hasID AS assembly_a,
         asm2.hasID AS assembly_b,
         a.hasID AS adr_id,
         a.hasName AS adr_name,
         collect(DISTINCT r1.hasID) AS reqs_in_a,
         collect(DISTINCT r2.hasID) AS reqs_in_b,
         count(CASE WHEN r1.isVerified = false OR r1.isVerified IS NULL THEN 1 END) +
         count(CASE WHEN r2.isVerified = false OR r2.isVerified IS NULL THEN 1 END) AS unverified_count
    RETURN assembly_a,
           assembly_b,
           adr_id,
           adr_name,
           reqs_in_a,
           reqs_in_b,
           size(reqs_in_a) + size(reqs_in_b) AS total_shared,
           unverified_count,
           CASE WHEN unverified_count > 0 THEN 'RISK: unverified requirements on interface'
                ELSE 'OK'
           END AS risk_flag
    ORDER BY assembly_a, assembly_b, adr_id
    """

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                rows = [record.data() for record in session.run(query)]
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    risk_rows = [r for r in rows if r.get("risk_flag", "").startswith("RISK")]
    return json.dumps({
        "total_interface_pairs": len(rows),
        "risk_count": len(risk_rows),
        "interfaces": rows,
    }, indent=2)


# ── FMEA: failure-mode coverage ────────────────────────────────────────────────

# Where the FMEA data comes from (extract_failure_modes.py); used as the provenance pointer
# when the graph was extracted before row numbers were stored.
FMEA_WORKBOOK = "thesis-extraction/Brake_System_Failure_Mode_Data.xlsx"


@mcp.tool()
def get_unmitigated_failure_modes(requirement_keyword: str = "") -> str:
    """List failure modes with no mitigation, for components that satisfy an FMEA requirement.

    Matches (Requirement)<-[:satisfiesRequirement]-(Component)-[:hasFailureMode]->(FailureMode)
    where the failure mode has no mitigatedBy relationship to a ControlAction. These are the
    FMEA Requirement nodes from extract_failure_modes.py (named by hasName), not the ADR
    ExtractedEssentialRequirement nodes; the two are not linked. requirement_keyword
    (optional, case-insensitive) keeps only requirements whose name contains it.

    Each result has the requirement, component, failure mode, its effects and causes, and a
    provenance pointer to the FMEA workbook: the "Failure Mode Data" sheet row(s) of the
    failure mode and the "Requirement Mapping" sheet row of the requirement link (rows are
    null if the graph was extracted before row numbers were stored). checked_failure_modes
    is how many failure modes matched before the no-mitigation filter, so an empty result
    can be told apart from "nothing matched the keyword".
    """
    keyword = requirement_keyword.strip()
    match = """
    MATCH (r:Requirement)<-[s:satisfiesRequirement]-(c:Component)-[:hasFailureMode]->(f:FailureMode)
    WHERE ($kw = "" OR toLower(r.hasName) CONTAINS toLower($kw))
    """
    query = match + """
      AND NOT (f)-[:mitigatedBy]->(:ControlAction)
    RETURN r.hasName AS requirement,
           c.hasID AS component,
           f.hasID AS failure_mode_id,
           f.hasName AS failure_mode,
           [(f)-[:causes]->(e:Effect) | e.hasName] AS effects,
           [(f)-[:causedBy]->(x:Cause) | x.hasName] AS causes,
           f.sourceFile AS fm_file, f.sourceSheet AS fm_sheet, f.sourceRows AS fm_rows,
           s.sourceFile AS link_file, s.sourceSheet AS link_sheet, s.sourceRow AS link_row
    ORDER BY requirement, component, failure_mode
    """
    count_query = match + "RETURN count(DISTINCT f) AS checked"

    try:
        with _neo4j_driver() as driver:
            with driver.session() as session:
                rows = [record.data() for record in session.run(query, kw=keyword)]
                counted = session.run(count_query, kw=keyword).single()
    except Exception as exc:
        return json.dumps({"error": str(exc)}, indent=2)

    results = []
    for row in rows:
        results.append({
            "requirement": row["requirement"],
            "component": row["component"],
            "failure_mode_id": row["failure_mode_id"],
            "failure_mode": row["failure_mode"],
            "effects": row["effects"],
            "causes": row["causes"],
            "provenance": {
                "failure_mode": {
                    "workbook": row["fm_file"] or FMEA_WORKBOOK,
                    "sheet": row["fm_sheet"] or "Failure Mode Data",
                    "rows": row["fm_rows"],
                },
                "requirement_link": {
                    "workbook": row["link_file"] or FMEA_WORKBOOK,
                    "sheet": row["link_sheet"] or "Requirement Mapping",
                    "row": row["link_row"],
                },
            },
        })
    return json.dumps({
        "requirement_keyword": keyword,
        "checked_failure_modes": counted["checked"] if counted else 0,
        "unmitigated_count": len(results),
        "unmitigated_failure_modes": results,
        "source": FMEA_WORKBOOK,
    }, indent=2)


